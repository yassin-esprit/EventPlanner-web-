{% extends 'admin/base_admin.html.twig' %}

{% block title %}System Logs{% endblock %}

{% block content %}
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">System Logs</h1>
        <a href="{{ path('app_admin_logs_failed_logins') }}" class="btn btn-sm btn-warning shadow-sm">
            <i class="fas fa-user-lock fa-sm text-white-50"></i> Failed Logins
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Log Entries</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>User</th>
                            <th>Level</th>
                            <th>IP Address</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if logs is empty %}
                            <tr>
                                <td colspan="6" class="text-center text-muted">No log entries found.</td>
                            </tr>
                        {% else %}
                            {% for log in logs %}
                                <tr>
                                    <td>{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                                    <td>{{ log.action }}</td>
                                    <td>
                                        {% if log.user %}
                                            <a href="{{ path('app_admin_logs_user', {'id': log.user.userId}) }}">
                                                {{ log.user.email }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted">System</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set level_class = 'info' %}
                                        {% if log.level == 'WARNING' %}
                                            {% set level_class = 'warning' %}
                                        {% elseif log.level == 'ERROR' or log.level == 'CRITICAL' or log.level == 'ALERT' or log.level == 'EMERGENCY' %}
                                            {% set level_class = 'danger' %}
                                        {% elseif log.level == 'NOTICE' %}
                                             {% set level_class = 'primary' %}
                                        {% endif %}
                                        <span class="badge bg-{{ level_class }} text-white">{{ log.level }}</span>
                                    </td>
                                    <td>{{ log.ipAddress }}</td>
                                    <td>
                                        <a href="{{ path('app_admin_logs_show', {'id': log.id}) }}" class="btn btn-sm btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            {% if logs is not empty and logs.totalItemCount > logs.itemNumberPerPage %}
                <div class="navigation d-flex justify-content-center mt-4">
                    {{ knp_pagination_render(logs) }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Add specific stylesheets for this page if needed #}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Add specific javascript for this page if needed #}
{% endblock %} 