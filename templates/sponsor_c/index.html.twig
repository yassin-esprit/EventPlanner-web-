{% extends 'base.html.twig' %}

{% block title %}Liste des Sponsors{% endblock %}

{% block body %}
<div
	id="wrapper">
	<!-- Sidebar -->
	<ul
		id="sidebar" class="navbar-nav sidebar sidebar-dark accordion">
		<!-- Sidebar - Brand -->
		<a class="sidebar-brand d-flex align-items-center justify-content-center" href="#">
			<div class="sidebar-brand-icon">
				<i class="bi bi-shield-lock"></i>
			</div>
			<div class="sidebar-brand-text mx-2">Admin Panel</div>
		</a>

		<!-- Divider -->
		<hr
		class="sidebar-divider my-0">

		<!-- Nav Items -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-speedometer2"></i>
				<span>Dashboard</span>
			</a>
		</li>

		<!-- Divider -->
		<hr
		class="sidebar-divider">

		<!-- Heading -->
		<div class="sidebar-heading">
			Management
		</div>

		<!-- Events Nav Item -->
		<li class="nav-item">
			<a class="nav-link " href="#">
				<i class="bi bi-calendar-event"></i>
				<span>Events</span>
			</a>
		</li>

		<!-- Sponsors Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-award"></i>
				<span>Sponsors</span>
			</a>
		</li>
<li class="nav-item">
			<a class="nav-link active" href="#events">
				<i class="bi bi-calendar-event"></i>
				<span>Contrat de Sponsor</span>
			</a>
		</li>
		<!-- Logistics Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-truck"></i>
				<span>Logistics</span>
			</a>
		</li>

		<!-- Ads Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-megaphone"></i>
				<span>Advertisements</span>
			</a>
		</li>

		<!-- Merchandise Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-shop"></i>
				<span>Merchandise</span>
			</a>
		</li>

		<!-- Users Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-people"></i>
				<span>Users</span>
			</a>
		</li>
	</ul>
	<!-- End of Sidebar -->

	<!-- Content Wrapper -->
	<div
		id="content">
		<div class="container py-5">
		</br>			</br>
			

			<div class="row mb-4">
			
				<div class="col-12">
					<div class="search-container">
						<input type="text" id="searchInput" class="form-control" placeholder="Rechercher par nom, email, téléphone ou secteur..." autocomplete="off">
					</div>
				</div>
			</div>

			<div class="row mb-4">
				<div class="col-12">
					<div class="d-flex justify-content-between align-items-center">
						<h2 class="mb-0">Liste des Sponsors</h2>
						<a href="{{ path('app_sponsor_c_new') }}" class="btn btn-primary">
							<i class="bi bi-plus-circle me-2"></i>Ajouter un Sponsor
						</a>
					</div>
				</div>
			</div>

			<div class="row" id="sponsorList">
				{% for sponsor in sponsors %}
					<div class="col-md-4 mb-4 sponsor-card" 
						 data-name="{{ sponsor.nom|lower }}" 
						 data-email="{{ sponsor.contactemail|lower }}" 
						 data-phone="{{ sponsor.contacttelephone|lower }}" 
						 data-sector="{{ sponsor.secteuractivite|lower }}">
						<div class="card h-100">
							<div class="card-body text-center">
								<img src="{{ sponsor.logo ? asset('uploads/sponsors/' ~ sponsor.logo) : asset('images/default-logo.png') }}"
									 alt="{{ sponsor.nom }}" class="sponsor-logo mb-3">
								<h5 class="card-title">{{ sponsor.nom }}</h5>
								<p class="text-muted mb-2">{{ sponsor.contactemail }}</p>
								<p class="text-muted mb-2">{{ sponsor.contacttelephone }}</p>
								<span class="secteur-badge mb-3">{{ sponsor.secteuractivite }}</span>
								<div class="d-flex justify-content-center gap-2">
									<a href="{{ path('app_sponsor_c_show', {'id_sponsor': sponsor.id_sponsor}) }}"
									   class="btn btn-info text-white">
										<i class="bi bi-eye me-1"></i>Voir
									</a>
									<a href="{{ path('app_sponsor_c_edit', {'id_sponsor': sponsor.id_sponsor}) }}"
									   class="btn btn-warning">
										<i class="bi bi-pencil me-1"></i>Modifier
									</a>
									<button class="btn btn-secondary openai-info-btn" data-sponsor-name="{{ sponsor.nom }}" data-sponsor-id="{{ sponsor.id_sponsor }}">
										<i class="bi bi-search me-1"></i>Infos
									</button>
								</div>
							</div>
						</div>
					</div>
				{% else %}
					<div class="col-12">
						<div class="alert alert-info">
							<i class="bi bi-info-circle me-2"></i>Aucun sponsor trouvé
						</div>
					</div>
				{% endfor %}
			</div>

			{% if totalPages > 1 %}
				<div class="row mt-4">
					<div class="col-12">
						<nav aria-label="Page navigation">
							<ul class="pagination justify-content-center">
								{% if currentPage > 1 %}
										</a>
									</li>
								{% endif %}

								{% for page in 1..totalPages %}
									{% if page == currentPage %}
										<li class="page-item active">
											<span class="page-link">{{ page }}</span>
										</li>
									{% else %}
										<li class="page-item">
											<a class="page-link" href="{{ path('app_sponsor_c_index', {'page': page}) }}">{{ page }}</a>
										</li>
									{% endif %}
								{% endfor %}

								{% if currentPage < totalPages %}
									<li class="page-item">
										<a class="page-link" href="{{ path('app_sponsor_c_index', {'page': currentPage + 1}) }}">
											<i class="bi bi-chevron-right"></i>
										</a>
									</li>
								{% endif %}
							</ul>
						</nav>
					</div>
				</div>
			{% endif %}
		</div>

		<!-- Modal Structure -->
		<div class="modal fade" id="sponsorInfoModal" tabindex="-1" aria-labelledby="sponsorInfoModalLabel" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="sponsorInfoModalLabel">Informations sur le Sponsor</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<p id="sponsorInfoContent">Chargement des informations...</p>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- End of Content Wrapper -->
</div>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>:root
	{
		--sidebar-width: 250px;
		--primary-color: #f8cb2e;
		--secondary-color: #ee5007;
		--section-bg-color: #f0f8ff;
		--custom-btn-bg-color: #ee5007;
		--custom-btn-bg-hover-color: #c01f27;
		--dark-color: #000000;
		--p-color: #717275;
		--border-color: #7fffd4;
		--link-hover-color: #b22727;
	}

	/* Main Layout */
	#wrapper {
		display: flex;
		min-height: 100vh;
		background-color: #f8f9fa;
	}

	/* Sidebar */
	#sidebar {
		width: var(--sidebar-width);
		background: linear-gradient(180deg, var(--dark-color) 0%, #333 100%);
		color: white;
		position: fixed;
		height: 100vh;
		transition: all 0.3s;
		z-index: 1000;
		box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
	}

	.sidebar-brand {
		height: 80px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 800;
		font-size: 1.2rem;
		background: rgba(0, 0, 0, 0.2);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.sidebar-brand-icon {
		color: var(--primary-color);
		margin-right: 10px;
	}

	.sidebar-divider {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		margin: 1rem 0;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		color: rgba(255, 255, 255, 0.8);
		padding: 12px 20px;
		display: flex;
		align-items: center;
		transition: all 0.3s;
	}

	.nav-link:hover,
	.nav-link.active {
		color: white;
		background: rgba(255, 255, 255, 0.1);
	}

	.nav-link.active {
		border-left: 4px solid var(--primary-color);
	}

	.nav-link i {
		margin-right: 10px;
		font-size: 1.1rem;
		color: var(--primary-color);
		width: 24px;
		text-align: center;
	}

	/* Content */
	#content {
		width: calc(100% - var(--sidebar-width));
		margin-left: var(--sidebar-width);
		min-height: 100vh;
		background: #f8f9fc;
	}

	/* Main Content */
	.container-fluid {
		padding: 2rem;
	}

	.card {
		border: none;
		border-radius: 10px;
		box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
		margin-bottom: 2rem;
		background: white;
	}

	.card-header {
		background: white;
		border-bottom: 1px solid #e3e6f0;
		padding: 1.25rem 1.5rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-radius: 10px 10px 0 0 !important;
	}

	.card-body {
		padding: 1.5rem;
	}

	/* Page Heading */
	.page-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid #eee;
	}

	/* Buttons */
	.btn {
		font-weight: 600;
		padding: 0.5rem 1rem;
		border-radius: 5px;
		transition: all 0.3s;
	}

	.btn-primary {
		background-color: var(--custom-btn-bg-color);
		border-color: var(--custom-btn-bg-color);
	}

	.btn-primary:hover {
		background-color: var(--custom-btn-bg-hover-color);
		border-color: var(--custom-btn-bg-hover-color);
	}

	.btn-outline-primary {
		color: var(--custom-btn-bg-color);
		border-color: var(--custom-btn-bg-color);
	}

	.btn-outline-primary:hover {
		background-color: var(--custom-btn-bg-color);
		color: white;
	}

	.btn-sm {
		padding: 0.35rem 0.75rem;
		font-size: 0.875rem;
	}

	/* Tables */
	.table {
		width: 100%;
		margin-bottom: 1rem;
		color: #212529;
		border-collapse: separate;
		border-spacing: 0;
	}

	.table th {
		background: #f8f9fc;
		border-bottom: 2px solid #e3e6f0;
		vertical-align: middle;
		padding: 1rem;
		font-weight: 600;
		color: var(--dark-color);
	}

	.table td {
		vertical-align: middle;
		padding: 1rem;
		border-top: 1px solid #e3e6f0;
	}

	.table tr:first-child td {
		border-top: none;
	}

	.table tr:hover td {
		background-color: rgba(248, 203, 46, 0.05);
	}

	.table-responsive {
		display: block;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	/* Action Buttons */
	.action-buttons {
		display: flex;
		gap: 0.5rem;
	}

	.action-buttons .btn {
		min-width: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Badges */
	.badge {
		font-weight: 600;
		padding: 0.5em 0.8em;
		font-size: 0.75em;
		border-radius: 50px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.badge-primary {
		background-color: var(--custom-btn-bg-color);
	}

	.badge-secondary {
		background-color: #6c757d;
	}

	.badge-success {
		background-color: #28a745;
	}

	.badge-warning {
		background-color: #ffc107;
		color: #212529;
	}

	.badge-danger {
		background-color: #dc3545;
	}

	/* Responsive */
	@media(max-width: 768px) {
		#sidebar {
			margin-left: -250px;
		}
		#sidebar.active {
			margin-left: 0;
		}
		#content {
			width: 100%;
			margin-left: 0;
		}
		#content.active {
			margin-left: 250px;
			width: calc(100% - 250px);
		}
	}
</style>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		// Toggle sidebar
		document.getElementById('sidebarToggle').addEventListener('click', function () {
			document.getElementById('sidebar').classList.toggle('active');
			document.getElementById('content').classList.toggle('active');
		});
	</script>
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const searchInput = document.getElementById('searchInput');
			const sponsorList = document.getElementById('sponsorList');
			const sponsorCards = document.querySelectorAll('.sponsor-card');
			
			const noResultsMessage = document.createElement('div');
			noResultsMessage.className = 'no-results';
			noResultsMessage.innerHTML = '<div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Aucun sponsor correspond à votre recherche</div>';
			sponsorList.appendChild(noResultsMessage);

			function filterSponsors() {
				const searchTerm = searchInput.value.toLowerCase().trim();
				let hasResults = false;

				sponsorCards.forEach(card => {
					const name = card.dataset.name;
					const email = card.dataset.email;
					const phone = card.dataset.phone;
					const sector = card.dataset.sector;

					const matches = (
						name.includes(searchTerm) ||
						email.includes(searchTerm) ||
						phone.includes(searchTerm) ||
						sector.includes(searchTerm)
					);

					card.style.display = matches ? '' : 'none';
					if (matches) hasResults = true;
				});

				noResultsMessage.style.display = hasResults ? 'none' : 'block';
			}

			searchInput.addEventListener('input', function() {
				clearTimeout(this.debounceTimeout);
				this.debounceTimeout = setTimeout(filterSponsors, 300);
			});

			searchInput.addEventListener('keydown', function(event) {
				if (event.key === 'Escape') {
					searchInput.value = '';
					filterSponsors();
				}
			});

			searchInput.focus();

			// Gestion du bouton "Infos"
			const infoButtons = document.querySelectorAll('.openai-info-btn');
			const modal = new bootstrap.Modal(document.getElementById('sponsorInfoModal'));
			const modalContent = document.getElementById('sponsorInfoContent');

			infoButtons.forEach(button => {
				button.addEventListener('click', async function() {
					const sponsorId = this.getAttribute('data-sponsor-id');
					modalContent.innerHTML = '<div class="text-center"><div class="spinner-border" role="status"></div><p>Chargement...</p></div>';
					modal.show();

					try {
						const response = await fetch(`/sponsor/c/info/${sponsorId}`);
						const data = await response.json();

						if (data.success) {
							const info = data.info;
							modalContent.innerHTML = `
								<div class="text-center mb-3">
									${info.image ? `<img src="${info.image}" alt="${info.title}" class="img-fluid rounded mb-3" style="max-height: 200px;">` : ''}
									<h4>${info.title}</h4>
									<p class="text-muted">${info.description || ''}</p>
								</div>
								<p>${info.summary}</p>
								${info.url ? `<div class="mt-4 text-center">
									<small class="text-muted">
										Source : <a href="${info.url}" target="_blank" class="text-decoration-underline">Wikipedia</a>
									</small>
								</div>` : ''}
							`;
						} else {
							modalContent.innerHTML = '<div class="alert alert-warning">Aucune information disponible.</div>';
						}
					} catch (error) {
						modalContent.innerHTML = '<div class="alert alert-danger">Erreur lors de la récupération des informations.</div>';
					}
				});
			});
		});
	</script>
{% endblock %}
