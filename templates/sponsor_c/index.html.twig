{% extends 'base.html.twig' %}

{% block title %}Liste des Sponsors{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row mb-4">
            <div class="col-12">
                <div class="search-container">
                    <input type="text" id="searchInput" class="form-control" placeholder="Rechercher par nom, email ou secteur...">
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Liste des Sponsors</h2>
                    <a href="{{ path('app_sponsor_c_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Ajouter un Sponsor
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            {% for sponsor in sponsors %}
                <div class="col-md-4 mb-4 sponsor-card">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <img src="{{ sponsor.logo ? asset('uploads/sponsors/' ~ sponsor.logo) : asset('images/default-logo.png') }}"
                                 alt="{{ sponsor.nom }}" class="sponsor-logo mb-3">
                            <h5 class="card-title">{{ sponsor.nom }}</h5>
                            <p class="text-muted mb-2">{{ sponsor.contactemail }}</p>
                            <p class="text-muted mb-2">{{ sponsor.contacttelephone }}</p>
                            <span class="secteur-badge mb-3">{{ sponsor.secteuractivite }}</span>
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('app_sponsor_c_show', {'id_sponsor': sponsor.id_sponsor}) }}"
                                   class="btn btn-info text-white">
                                    <i class="bi bi-eye me-1"></i>Voir
                                </a>
                                <a href="{{ path('app_sponsor_c_edit', {'id_sponsor': sponsor.id_sponsor}) }}"
                                   class="btn btn-warning">
                                    <i class="bi bi-pencil me-1"></i>Modifier
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>Aucun sponsor trouvé
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if totalPages > 1 %}
            <div class="row mt-4">
                <div class="col-12">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            {% if currentPage > 1 %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_sponsor_c_index', {'page': currentPage - 1}) }}">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            {% endif %}

                            {% for page in 1..totalPages %}
                                {% if page == currentPage %}
                                    <li class="page-item active">
                                        <span class="page-link">{{ page }}</span>
                                    </li>
                                {% else %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ path('app_sponsor_c_index', {'page': page}) }}">{{ page }}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}

                            {% if currentPage < totalPages %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_sponsor_c_index', {'page': currentPage + 1}) }}">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .sponsor-card {
            transition: transform 0.3s ease;
        }

        .sponsor-card:hover {
            transform: translateY(-5px);
        }

        .sponsor-logo {
            max-width: 150px;
            max-height: 100px;
            object-fit: contain;
        }

        .search-container {
            position: relative;
            margin-bottom: 20px;
        }

        .search-container input {
            padding-left: 40px;
            border-radius: 20px;
        }

        .search-container::before {
            content: "\f002";
            font-family: "Font Awesome 5 Free";
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }

        .secteur-badge {
            display: inline-block;
            padding: 5px 10px;
            background-color: #f8f9fa;
            border-radius: 15px;
            font-size: 0.9rem;
            color: #6c757d;
        }

        .pagination {
            margin-bottom: 0;
        }

        .page-link {
            color: #007bff;
            border: none;
            padding: 8px 16px;
            margin: 0 2px;
            border-radius: 4px;
        }

        .page-item.active .page-link {
            background-color: #007bff;
            border-color: #007bff;
        }

        .page-link:hover {
            color: #0056b3;
            background-color: #e9ecef;
            border-color: #dee2e6;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const sponsorCards = document.querySelectorAll('.sponsor-card');

            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();

                sponsorCards.forEach(card => {
                    const title = card.querySelector('.card-title').textContent.toLowerCase();
                    const email = card.querySelector('.text-muted:nth-of-type(1)').textContent.toLowerCase();
                    const secteur = card.querySelector('.secteur-badge').textContent.toLowerCase();

                    if (title.includes(searchTerm) || email.includes(searchTerm) || secteur.includes(searchTerm)) {
                        card.style.display = '';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
    </script>
{% endblock %} 