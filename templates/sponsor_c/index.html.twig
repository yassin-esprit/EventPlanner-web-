{% extends 'base.html.twig' %}

{% block title %}Liste des Sponsors{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row mb-4">
            <div class="col-12">
                <div class="search-container">
                    <input type="text" id="searchInput" class="form-control" placeholder="Rechercher par nom, email, téléphone ou secteur..." autocomplete="off">
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Liste des Sponsors</h2>
                    <a href="{{ path('app_sponsor_c_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Ajouter un Sponsor
                    </a>
                </div>
            </div>
        </div>

        <div class="row" id="sponsorList">
            {% for sponsor in sponsors %}
                <div class="col-md-4 mb-4 sponsor-card" 
                     data-name="{{ sponsor.nom|lower }}" 
                     data-email="{{ sponsor.contactemail|lower }}" 
                     data-phone="{{ sponsor.contacttelephone|lower }}" 
                     data-sector="{{ sponsor.secteuractivite|lower }}">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <img src="{{ sponsor.logo ? asset('uploads/sponsors/' ~ sponsor.logo) : asset('images/default-logo.png') }}"
                                 alt="{{ sponsor.nom }}" class="sponsor-logo mb-3">
                            <h5 class="card-title">{{ sponsor.nom }}</h5>
                            <p class="text-muted mb-2">{{ sponsor.contactemail }}</p>
                            <p class="text-muted mb-2">{{ sponsor.contacttelephone }}</p>
                            <span class="secteur-badge mb-3">{{ sponsor.secteuractivite }}</span>
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('app_sponsor_c_show', {'id_sponsor': sponsor.id_sponsor}) }}"
                                   class="btn btn-info text-white">
                                    <i class="bi bi-eye me-1"></i>Voir
                                </a>
                                <a href="{{ path('app_sponsor_c_edit', {'id_sponsor': sponsor.id_sponsor}) }}"
                                   class="btn btn-warning">
                                    <i class="bi bi-pencil me-1"></i>Modifier
                                </a>
<button class="btn btn-secondary openai-info-btn" data-sponsor-name="{{ sponsor.nom }}" data-sponsor-id="{{ sponsor.id_sponsor }}">
    <i class="bi bi-search me-1"></i>Infos
</button>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>Aucun sponsor trouvé
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if totalPages > 1 %}
            <div class="row mt-4">
                <div class="col-12">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            {% if currentPage > 1 %}
                                    </a>
                                </li>
                            {% endif %}

                            {% for page in 1..totalPages %}
                                {% if page == currentPage %}
                                    <li class="page-item active">
                                        <span class="page-link">{{ page }}</span>
                                    </li>
                                {% else %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ path('app_sponsor_c_index', {'page': page}) }}">{{ page }}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}

                            {% if currentPage < totalPages %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_sponsor_c_index', {'page': currentPage + 1}) }}">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>
                </div>
            </div>
        {% endif %}
    </div>

    <!-- Modal Structure -->
    <div class="modal fade" id="sponsorInfoModal" tabindex="-1" aria-labelledby="sponsorInfoModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="sponsorInfoModalLabel">Informations sur le Sponsor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="sponsorInfoContent">Chargement des informations...</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .sponsor-card {
            transition: transform 0.3s ease;
        }

        .sponsor-card:hover {
            transform: translateY(-5px);
        }

        .sponsor-logo {
            max-width: 150px;
            max-height: 100px;
            object-fit: contain;
        }

        .search-container {
            position: relative;
            margin-bottom: 20px;
        }

        .search-container input {
            padding-left: 40px;
            border-radius: 20px;
            transition: border-color 0.3s ease;
        }

        .search-container input:focus {
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0,123,255,0.3);
        }

        .search-container::before {
            content: "\f002";
            font-family: "Font Awesome 5 Free";
            font-weight: 900;
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }

        .secteur-badge {
            display: inline-block;
            padding: 5px 10px;
            background-color: #f8f9fa;
            border-radius: 15px;
            font-size: 0.9rem;
            color: #6c757d;
        }

        .pagination {
            margin-bottom: 0;
        }

        .page-link {
            color: #007bff;
            border: none;
            padding: 8px 16px;
            margin: 0 2px;
            border-radius: 4px;
        }

        .page-item.active .page-link {
            background-color: #007bff;
            border-color: #007bff;
        }

        .page-link:hover {
            color: #0056b3;
            background-color: #e9ecef;
            border-color: #dee2e6;
        }

        .no-results {
            display: none;
            text-align: center;
            color: #6c757d;
            margin-top: 20px;
        }
    </style>
{% endblock %}{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const sponsorList = document.getElementById('sponsorList');
            const sponsorCards = document.querySelectorAll('.sponsor-card');
            
            const noResultsMessage = document.createElement('div');
            noResultsMessage.className = 'no-results';
            noResultsMessage.innerHTML = '<div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Aucun sponsor correspond à votre recherche</div>';
            sponsorList.appendChild(noResultsMessage);

            function filterSponsors() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let hasResults = false;

                sponsorCards.forEach(card => {
                    const name = card.dataset.name;
                    const email = card.dataset.email;
                    const phone = card.dataset.phone;
                    const sector = card.dataset.sector;

                    const matches = (
                        name.includes(searchTerm) ||
                        email.includes(searchTerm) ||
                        phone.includes(searchTerm) ||
                        sector.includes(searchTerm)
                    );

                    card.style.display = matches ? '' : 'none';
                    if (matches) hasResults = true;
                });

                noResultsMessage.style.display = hasResults ? 'none' : 'block';
            }

            searchInput.addEventListener('input', function() {
                clearTimeout(this.debounceTimeout);
                this.debounceTimeout = setTimeout(filterSponsors, 300);
            });

            searchInput.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') {
                    searchInput.value = '';
                    filterSponsors();
                }
            });

            searchInput.focus();

            // Gestion du bouton "Infos"
            const infoButtons = document.querySelectorAll('.openai-info-btn');
            const modal = new bootstrap.Modal(document.getElementById('sponsorInfoModal'));
            const modalContent = document.getElementById('sponsorInfoContent');

            infoButtons.forEach(button => {
                button.addEventListener('click', async function() {
                    const sponsorId = this.getAttribute('data-sponsor-id');
                    modalContent.innerHTML = '<div class="text-center"><div class="spinner-border" role="status"></div><p>Chargement...</p></div>';
                    modal.show();

                    try {
                        const response = await fetch(`/sponsor/c/info/${sponsorId}`);
                        const data = await response.json();

                        if (data.success) {
                            const info = data.info;
                            modalContent.innerHTML = `
                                <div class="text-center mb-3">
                                    ${info.image ? `<img src="${info.image}" alt="${info.title}" class="img-fluid rounded mb-3" style="max-height: 200px;">` : ''}
                                    <h4>${info.title}</h4>
                                    <p class="text-muted">${info.description || ''}</p>
                                </div>
                                <p>${info.summary}</p>
                                ${info.url ? `<div class="mt-4 text-center">
                                    <small class="text-muted">
                                        Source : <a href="${info.url}" target="_blank" class="text-decoration-underline">Wikipedia</a>
                                    </small>
                                </div>` : ''}
                            `;
                        } else {
                            modalContent.innerHTML = '<div class="alert alert-warning">Aucune information disponible.</div>';
                        }
                    } catch (error) {
                        modalContent.innerHTML = '<div class="alert alert-danger">Erreur lors de la récupération des informations.</div>';
                    }
                });
            });
        });
    </script>
{% endblock %}
