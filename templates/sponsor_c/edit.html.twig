{% extends 'base.html.twig' %}

{% block title %}Modifier Sponsor{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div id="sidebar" class="col-md-3 bg-dark text-white min-vh-100 sidebar p-0">
            <ul class="navbar-nav sidebar sidebar-dark accordion">
                <a class="sidebar-brand d-flex align-items-center justify-content-center py-4" href="#">
                    <div class="sidebar-brand-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div class="sidebar-brand-text mx-2">Admin Panel</div>
                </a>

                <hr class="sidebar-divider my-0 bg-light">

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="dashboard">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <hr class="sidebar-divider bg-light">

                <div class="sidebar-heading text-light">
                    Management
                </div>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="events">
                        <i class="bi bi-calendar-event"></i>
                        <span>Events</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="sponsors">
                        <i class="bi bi-award"></i>
                        <span>Sponsors</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="equipements">
                        <i class="bi bi-truck"></i>
                        <span>Equipement</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="ads">
                        <i class="bi bi-megaphone"></i>
                        <span>Advertisements</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="merchandise">
                        <i class="bi bi-shop"></i>
                        <span>Merchandise</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="users">
                        <i class="bi bi-people"></i>
                        <span>Users</span>
                    </a>
                </li>
            </ul>
        </div>
        <!-- End Sidebar -->

        <!-- Content -->
        <div id="content" class="col-md-9">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-lg rounded-4">
                            <div class="card-header bg-gradient-primary text-white py-4 rounded-top-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h1 class="h3 mb-0">
                                        <i class="bi bi-pencil-square me-2"></i>
                                        Modifier Sponsor
                                    </h1>
                                    <a href="{{ path('app_sponsor_c_index') }}" class="btn btn-outline-light btn-sm">
                                        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                                    </a>
                                </div>
                            </div>
                            <div class="card-body p-5">
                                <div class="alert alert-info mb-4 d-flex align-items-center">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <span>Veuillez modifier les informations du sponsor. Les champs avec <span class="text-danger">*</span> sont obligatoires.</span>
                                </div>

                                {{ include('sponsor_c/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

                                <div class="mt-4 pt-3 border-top">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <a href="{{ path('app_sponsor_c_index') }}" class="btn btn-outline-secondary">
                                            <i class="bi bi-arrow-left me-1"></i> Annuler
                                        </a>
                                        <div>
                                            {{ include('sponsor_c/_delete_form.html.twig') }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End Content -->
    </div>
</div>
{% endblock %}
