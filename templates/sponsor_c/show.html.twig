{% extends 'base.html.twig' %}

{% block title %}Sponsor{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .sponsor-card {
            max-width: 700px;
            margin: 2rem auto;
            padding: 2rem;
            border-radius: 1.5rem;
            background: linear-gradient(to right, #ffffff, #f0f0f0);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
        }

        .sponsor-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        .sponsor-logo {
            max-width: 150px;
            max-height: 100px;
            margin-bottom: 1rem;
        }

        .sponsor-header {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .sponsor-title {
            font-size: 2rem;
            font-weight: bold;
            color: #333;
        }

        .sponsor-info table {
            width: 100%;
        }

        .sponsor-info th {
            text-align: left;
            padding-right: 1rem;
            color: #666;
            font-weight: normal;
        }

        .sponsor-info td {
            font-weight: 500;
        }

        .btn-group {
            margin-top: 1.5rem;
        }

        .btn-group a,
        .btn-group form button {
            margin-right: 1rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div id="sidebar" class="col-md-3 bg-dark text-white min-vh-100 sidebar p-0">
            <ul class="navbar-nav sidebar sidebar-dark accordion">
                <a class="sidebar-brand d-flex align-items-center justify-content-center py-4" href="#">
                    <div class="sidebar-brand-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div class="sidebar-brand-text mx-2">Admin Panel</div>
                </a>

                <hr class="sidebar-divider my-0 bg-light">

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="dashboard">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <hr class="sidebar-divider bg-light">

                <div class="sidebar-heading text-light">
                    Management
                </div>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="events">
                        <i class="bi bi-calendar-event"></i>
                        <span>Events</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="sponsors">
                        <i class="bi bi-award"></i>
                        <span>Sponsors</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="equipements">
                        <i class="bi bi-truck"></i>
                        <span>Equipement</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="ads">
                        <i class="bi bi-megaphone"></i>
                        <span>Advertisements</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="merchandise">
                        <i class="bi bi-shop"></i>
                        <span>Merchandise</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="users">
                        <i class="bi bi-people"></i>
                        <span>Users</span>
                    </a>
                </li>
            </ul>
        </div>
        <!-- End Sidebar -->

        <!-- Content -->
        <div id="content" class="col-md-9">
            <div class="sponsor-card">
                <div class="sponsor-header">
                    {% if sponsor.logo %}
                    <img src="{{ asset(sponsor.logo) }}" alt="Logo du sponsor" style="max-height: 80px;">
                    {% endif %}
                    <div class="sponsor-title">{{ sponsor.nom }}</div>
                </div>

                <div class="sponsor-info mt-4">
                    <table class="table">
                        <tbody>
                            <tr><th>ID</th><td>{{ sponsor.id_sponsor }}</td></tr>
                            <tr><th>Site Web</th><td><a href="{{ sponsor.siteWeb }}" target="_blank">{{ sponsor.siteWeb }}</a></td></tr>
                            <tr><th>Email</th><td>{{ sponsor.contactEmail }}</td></tr>
                            <tr><th>Téléphone</th><td>{{ sponsor.contactTelephone }}</td></tr>
                            <tr><th>Adresse</th><td>{{ sponsor.adresse }}</td></tr>
                            <tr><th>Secteur</th><td>{{ sponsor.secteurActivite }}</td></tr>
                            <tr><th>Date d'inscription</th><td>{{ sponsor.dateInscription ? sponsor.dateInscription|date('Y-m-d H:i') : 'N/A' }}</td></tr>
                            <tr><th>Statut</th><td>{{ sponsor.statut ? 'Actif' : 'Inactif' }}</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="btn-group">
                    <a href="{{ path('app_sponsor_c_index') }}" class="btn btn-secondary">⬅ Retour</a>
                    <a href="{{ path('app_sponsor_c_edit', {'id_sponsor': sponsor.id_sponsor}) }}" class="btn btn-primary">✏️ Modifier</a>
                    {{ include('sponsor_c/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
        <!-- End Content -->
    </div>
</div>
{% endblock %}
