<table class="table mt-4">
    <thead>
        <tr>
            <th>Name</th>
            <th>Image</th>
            <th>Description</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for item in merchandise %}
            <tr>
                <td>
                    {% if app.request.query.get('search') %}
                        {{ item.name|replace({(app.request.query.get('search')): '<mark>' ~ app.request.query.get('search') ~ '</mark>'})|raw }}
                    {% else %}
                        {{ item.name }}
                    {% endif %}
                </td>
                <td><img src="{{ asset('uploads/merchandise/' ~ item.image) }}" alt="{{ item.name }}" style="width: 50px;"></td>
                <td>
                    {% if app.request.query.get('search') %}
                        {{ item.description|replace({(app.request.query.get('search')): '<mark>' ~ app.request.query.get('search') ~ '</mark>'})|raw }}
                    {% else %}
                        {{ item.description }}
                    {% endif %}
                </td>
                <td>
                    {% if app.request.query.get('search') %}
                        {{ item.price|replace({(app.request.query.get('search')): '<mark>' ~ app.request.query.get('search') ~ '</mark>'})|raw }}
                    {% else %}
                        ${{ item.price }}
                    {% endif %}
                </td>
                <td>
                    {% if app.request.query.get('search') %}
                        {{ item.quantity|replace({(app.request.query.get('search')): '<mark>' ~ app.request.query.get('search') ~ '</mark>'})|raw }}
                    {% else %}
                        {{ item.quantity }}
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('admin_update_merchandise', {id: item.id}) }}" class="btn btn-warning btn-sm">Update</a>
                    <form action="{{ path('admin_delete_merchandise', {id: item.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this item?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">No merchandise found</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<style>
mark {
    background-color: #ffd700;
    padding: 0;
}
</style> 