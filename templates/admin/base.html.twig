{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .admin-sidebar {
            min-height: calc(100vh - 56px);
            background: #343a40;
            color: #fff;
        }
        .admin-sidebar .nav-link {
            color: rgba(255,255,255,.75);
            padding: 0.75rem 1rem;
            border-radius: 0.25rem;
            margin: 0.25rem 0;
        }
        .admin-sidebar .nav-link:hover {
            color: #fff;
            background: rgba(255,255,255,.1);
        }
        .admin-sidebar .nav-link.active {
            color: #fff;
            background: rgba(255,255,255,.1);
        }
        .admin-sidebar .nav-link i {
            margin-right: 0.5rem;
        }
        .admin-content {
            padding: 1.5rem;
        }
        .admin-header {
            margin-bottom: 2rem;
        }
        .admin-card {
            border: none;
            border-radius: 0.5rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.075);
        }
        .admin-card .card-header {
            background: #fff;
            border-bottom: 1px solid rgba(0,0,0,.125);
            padding: 1rem 1.25rem;
        }
        .admin-card .card-body {
            padding: 1.25rem;
        }
        .admin-table th {
            background: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
        }
        .admin-table td {
            vertical-align: middle;
        }
        .admin-badge {
            padding: 0.5em 0.75em;
            border-radius: 0.25rem;
        }
        .admin-btn {
            padding: 0.375rem 0.75rem;
            border-radius: 0.25rem;
        }
        .admin-btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 d-md-block admin-sidebar collapse">
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_dashboard') }}">
                                <i class="bi bi-speedometer2"></i> Tableau de bord
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_evenement_index') }}">
                                <i class="bi bi-calendar-event"></i> Événements
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/dashboard/sponsor/c/">
                                <i class="bi bi-building"></i> Sponsors
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_contrat_index') }}">
                                <i class="bi bi-file-text"></i> Contrats
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_users') }}">
                                <i class="bi bi-people"></i> Utilisateurs
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_settings') }}">
                                <i class="bi bi-gear"></i> Paramètres
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 admin-content">
                <div class="admin-header d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3">
                    <h1 class="h2">{% block admin_title %}{% endblock %}</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        {% block admin_actions %}{% endblock %}
                    </div>
                </div>

                {% block admin_content %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Toggle sidebar on mobile
        document.addEventListener('DOMContentLoaded', function() {
            const sidebarToggle = document.querySelector('.navbar-toggler');
            const sidebar = document.querySelector('.admin-sidebar');
            
            if (sidebarToggle && sidebar) {
                sidebarToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('show');
                });
            }
        });
    </script>
{% endblock %} 