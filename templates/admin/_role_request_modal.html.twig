<!-- Modal for processing role request -->
<div class="modal fade" id="processRequestModal{{ request.id }}" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Process Role Request</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Confirm role change for <strong>{{ request.user.firstName }} {{ request.user.lastName }}</strong> to <strong>{{ request.requestedRole|replace({'ROLE_': ''}) }}</strong>?</p>
      </div>
      <div class="modal-footer">
        <form method="post" action="{{ path('app_admin_approve_role_request', {id: request.id}) }}" class="d-inline">
          <button type="submit" class="btn btn-success">Approve</button>
        </form>
        <form method="post" action="{{ path('app_admin_reject_role_request', {id: request.id}) }}" class="d-inline">
          <input type="text" name="reason" placeholder="Reason for rejection" class="form-control form-control-sm mb-2" required>
          <button type="submit" class="btn btn-danger">Reject</button>
        </form>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>