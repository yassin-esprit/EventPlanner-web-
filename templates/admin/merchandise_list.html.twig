{% extends 'base.html.twig' %}

{% block title %}Merchandise List{% endblock %}

{% block body %}
<h1>Merchandise List</h1>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="search-box">
        <div class="input-group">
            <input type="text" 
                   id="merchandise-search" 
                   class="form-control" 
                   placeholder="Search by name, description, price, or quantity..." 
                   value="{{ app.request.query.get('search') }}"
                   autocomplete="off">
            <button class="btn btn-outline-secondary" type="button" id="clear-search">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div id="search-spinner" class="spinner-border spinner-border-sm text-primary d-none" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <a href="{{ path('admin_export_merchandise') }}" class="btn btn-success">Export PDF</a>
</div>

<a href="{{ path('admin_add_merchandise') }}" class="btn btn-primary mb-3">Add Merchandise</a>

<div id="merchandise-list">
    {% include 'admin/_merchandise_list_content.html.twig' with {'merchandise': merchandise} %}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    let searchTimeout;
    const searchInput = document.getElementById('merchandise-search');
    const searchSpinner = document.getElementById('search-spinner');
    const merchandiseList = document.getElementById('merchandise-list');
    const clearSearch = document.getElementById('clear-search');

    function performSearch() {
        const searchTerm = searchInput.value;
        searchSpinner.classList.remove('d-none');

        fetch(`{{ path('admin_merchandise') }}?search=${encodeURIComponent(searchTerm)}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            merchandiseList.innerHTML = html;
            searchSpinner.classList.add('d-none');
        })
        .catch(error => {
            console.error('Error:', error);
            searchSpinner.classList.add('d-none');
        });
    }

    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(performSearch, 300);
    });

    clearSearch.addEventListener('click', function() {
        searchInput.value = '';
        performSearch();
    });

    // Trigger search on page load if there's a search term
    if (searchInput.value) {
        performSearch();
    }
});
</script>

<style>
.search-box {
    position: relative;
    width: 400px;
}

#search-spinner {
    position: absolute;
    right: 50px;
    top: 50%;
    transform: translateY(-50%);
}

.spinner-border-sm {
    width: 1rem;
    height: 1rem;
}

.input-group {
    position: relative;
}

#clear-search {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 3;
}

mark {
    background-color: #ffd700;
    padding: 0;
}
</style>
{% endblock %}