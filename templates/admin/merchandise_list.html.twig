{% extends 'base.html.twig' %}

{% block title %}Merchandise List{% endblock %}

{% block body %}
<h1>Merchandise List</h1>

<div class="d-flex justify-content-between align-items-center mb-4">
    <form method="get" class="search-box">
        <input type="text" name="search" class="form-control" placeholder="Search merchandise..." value="{{ app.request.query.get('search') }}">
        <button type="submit" class="btn btn-primary mt-2">Search</button>
    </form>
    <a href="{{ path('admin_export_merchandise') }}" class="btn btn-success">Export PDF</a>
</div>

<a href="{{ path('admin_add_merchandise') }}" class="btn btn-primary">Add Merchandise</a>

<table class="table mt-4">
    <thead>
        <tr>
            <th>Name</th>
            <th>Image</th>
            <th>Description</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for item in merchandise %}
            <tr>
                <td>{{ item.name }}</td>
                <td><img src="{{ item.image }}" alt="{{ item.name }}" style="width: 50px;"></td>
                <td>{{ item.description }}</td>
                <td>{{ item.price }}</td>
                <td>{{ item.quantity }}</td>
                <td>
                    <a href="{{ path('admin_update_merchandise', {id: item.id}) }}" class="btn btn-warning btn-sm">Update</a>
                    <form action="{{ path('admin_delete_merchandise', {id: item.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this item?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}