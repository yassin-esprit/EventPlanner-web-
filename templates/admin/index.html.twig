{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
    .admin-wrapper {
        background: #f8f9fa;
        min-height: 100vh;
        padding: 2rem 0;
    }
    .section-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        margin-bottom: 2rem;
        border: none;
    }
    .section-card .card-header {
        background: transparent;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 1.25rem;
    }
    .section-card .card-body {
        padding: 1.25rem;
    }
    .admin-action-card {
        padding: 1.25rem;
        transition: all 0.3s ease;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .admin-action-card:last-child {
        border-bottom: none;
    }
    .admin-action-card:hover {
        background: rgba(0,0,0,0.01);
    }
    .admin-action-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 1.2rem;
    }
    .icon-users { background: #e3f2fd; color: #1976d2; }
    .icon-export { background: #e8f5e9; color: #2e7d32; }
    .icon-roles { background: #fff3e0; color: #f57c00; }
    .icon-logs { background: #fce4ec; color: #c2185b; }
    
    .search-box {
        position: relative;
        margin-bottom: 1.5rem;
    }
    .search-box input {
        padding: 0.75rem 2.5rem 0.75rem 1rem;
        border-radius: 8px;
        border: 1px solid rgba(0,0,0,0.1);
    }
    .search-box i {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
    }
    .table th {
        font-weight: 600;
        color: #2c3e50;
    }
    .table td {
        vertical-align: middle;
    }
    .btn-group .btn {
        padding: 0.375rem 0.75rem;
    }
    .log-entry {
        border-left: 4px solid #3498db;
        margin-bottom: 0.75rem;
        padding: 0.75rem 1rem;
        background: rgba(52, 152, 219, 0.05);
        border-radius: 0 4px 4px 0;
    }
    .admin-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .stat-card {
        background: #fff;
        padding: 1.25rem;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        text-align: center;
    }
    .stat-number {
        font-size: 2rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }
    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
    }
    .sort-link {
        text-decoration: none !important;
        color: #2c3e50;
    }
    .sort-link:hover {
        color: #1a252f;
        text-decoration: none !important;
    }
    .sort-link.active {
        font-weight: bold;
    }
</style>
{% endblock %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
    <div class="admin-wrapper">
        <div class="container-fluid">
            <!-- Admin Header -->
            <div class="row mb-4">
                <div class="col-12">
                    <h1 class="mb-2">Admin Panel</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="{{ path('app_admin_panel') }}">Home</a></li>
                            <li class="breadcrumb-item active">Admin Panel</li>
                        </ol>
                    </nav>
                </div>
            </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}

            <!-- Stats Overview -->
            <div class="admin-stats">
                <div class="stat-card">
                    <div class="stat-number">{{ users.getTotalItemCount() }}</div>
                    <div class="stat-label">Total Users</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">{{ roleRequests|length }}</div>
                    <div class="stat-label">Pending Requests</div>
                </div>
            </div>

            <div class="row">
                <!-- Admin Actions Column -->
                <div class="col-lg-4 order-lg-2">
                    <div class="section-card">
                        <div class="card-header">
                            <h3 class="mb-0">Quick Actions</h3>
                        </div>
                        <div class="card-body p-0">
                            <div class="admin-action-card">
                                <div class="admin-action-icon icon-users">
                                    <i class="fas fa-user-plus"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">Add New User</h5>
                                    <p class="mb-2 text-muted small">Create a new user account</p>
                                    <a href="{{ path('app_admin_new_user') }}" class="btn btn-primary btn-sm">
                                        Create User
                                    </a>
                                </div>
                            </div>

                            <div class="admin-action-card">
                                <div class="admin-action-icon icon-export">
                                    <i class="fas fa-file-export"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">Export Users</h5>
                                    <p class="mb-2 text-muted small">Download user list as PDF</p>
                                    <a href="{{ path('app_admin_export_users') }}" class="btn btn-success btn-sm">
                                        Export PDF
                                    </a>
                                </div>
                            </div>

                            <div class="admin-action-card">
                                <div class="admin-action-icon icon-roles">
                                    <i class="fas fa-user-shield"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">Role Requests</h5>
                                    <p class="mb-2 text-muted small">{{ roleRequests|length }} pending requests</p>
                                    <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#roleRequestsModal">
                                        Manage Requests
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="section-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">Recent Activity</h3>
                            <div class="admin-action-icon icon-logs">
                                <i class="fas fa-history"></i>
                            </div>
                        </div>
                        <div class="card-body">
                            {% if loginLogs is empty %}
                                <p class="text-muted">No recent activity to display.</p>
                            {% else %}
                                {% for log in loginLogs %}
                                    <div class="log-entry">
                                        <small class="text-muted d-block mb-1">{{ log.timestamp }}</small>
                                        {{ log.message }}
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>

                    <div class="section-card">
                        <div class="card-header">
                            <h3 class="mb-0">Merchandise Management</h3>
                        </div>
                        <div class="card-body">
                            <a href="{{ path('admin_merchandise') }}" class="btn btn-primary">Manage Merchandise</a>
                        </div>
                    </div>
                </div>

                <!-- Users Management Column -->
                <div class="col-lg-8 order-lg-1">
                    <div class="section-card">
                        <div class="card-header">
                            <h3 class="mb-0">Users Management</h3>
                        </div>
                        <div class="card-body">
                            <!-- Search Box -->
                            <form method="get" class="search-box">
                                <input type="text" name="search" class="form-control" 
                                       placeholder="Search users by name or email..." 
                                       value="{{ app.request.query.get('search') }}">
                                <i class="fas fa-search"></i>
                            </form>

                            <!-- Users Table -->
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>
                                                <a href="{{ path('app_admin_panel', {
                                                    sort: 'id',
                                                    order: currentSort == 'id' and currentOrder == 'ASC' ? 'DESC' : 'ASC'
                                                }) }}" class="sort-link {{ currentSort == 'id' ? 'active' : '' }}">
                                                    ID
                                                    {% if currentSort == 'id' %}
                                                        <i class="fas fa-sort-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>
                                                    {% endif %}
                                                </a>
                                            </th>
                                            <th>
                                                <a href="{{ path('app_admin_panel', {
                                                    sort: 'email',
                                                    order: currentSort == 'email' and currentOrder == 'ASC' ? 'DESC' : 'ASC'
                                                }) }}" class="sort-link {{ currentSort == 'email' ? 'active' : '' }}">
                                                    Email
                                                    {% if currentSort == 'email' %}
                                                        <i class="fas fa-sort-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>
                                                    {% endif %}
                                                </a>
                                            </th>
                                            <th>Name</th>
                                            <th>Role</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for user in users %}
                                            <tr>
                                                <td>{{ user.id }}</td>
                                                <td>{{ user.email }}</td>
                                                <td>{{ user.firstName }} {{ user.lastName }}</td>
                                                <td>
                                                    <span class="badge bg-{{ user.roles[0] == 'ROLE_ADMIN' ? 'danger' : (user.roles[0] == 'ROLE_OWNER' ? 'warning' : 'info') }}">
                                                        {{ user.roles[0]|replace({'ROLE_': ''}) }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="{{ path('app_admin_edit_user', {id: user.id}) }}" 
                                                           class="btn btn-sm btn-outline-primary" title="Edit">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        {% if user.id != app.user.id %}
                                                            <form action="{{ path('app_admin_delete_user', {id: user.id}) }}" 
                                                                  method="POST" class="d-inline"
                                                                  onsubmit="return confirm('Are you sure you want to delete this user?')">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </form>
                                                        {% endif %}
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <div class="d-flex justify-content-center mt-4">
                                {{ knp_pagination_render(users) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Role Requests Modal -->
    <div class="modal fade" id="roleRequestsModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pending Role Requests</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    {% if roleRequests is empty %}
                        <p class="text-muted">No pending role requests.</p>
                    {% else %}
                        {% for request in roleRequests %}
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="card-title mb-1">{{ request.user.firstName }} {{ request.user.lastName }}</h5>
                                            <p class="card-text mb-1">
                                                <small class="text-muted">
                                                    Requesting: {{ request.requestedRole|replace({'ROLE_': ''}) }}<br>
                                                    Submitted: {{ request.requestedAt|date('Y-m-d H:i') }}
                                                </small>
                                            </p>
                                        </div>
                                        <button type="button" class="btn btn-primary btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#processRequestModal{{ request.id }}">
                                            Process Request
                                        </button>
                                    </div>
                                </div>
                            </div>

                            {% include 'admin/_role_request_modal.html.twig' with {'request': request} %}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <h1>Admin Dashboard</h1>

        <h2 class="mt-4">Pending Donations</h2>
        {% if donations is empty %}
            <p class="text-muted">No pending donations at the moment.</p>
        {% else %}
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Message</th>
                        <th>Submitted At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for donation in donations %}
                        <tr>
                            <td>{{ donation.user.firstName }} {{ donation.user.lastName }}</td>
                            <td>{{ donation.message }}</td>
                            <td>{{ donation.createdAt|date('Y-m-d H:i') }}</td>
                            <td>
                                <form action="{{ path('app_admin_process_donation', {id: donation.id}) }}" method="post" class="d-inline">
                                    <input type="hidden" name="status" value="accepted">
                                    <button type="submit" class="btn btn-success btn-sm">Accept</button>
                                </form>
                                <form action="{{ path('app_admin_process_donation', {id: donation.id}) }}" method="post" class="d-inline">
                                    <input type="hidden" name="status" value="denied">
                                    <button type="submit" class="btn btn-danger btn-sm">Deny</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
