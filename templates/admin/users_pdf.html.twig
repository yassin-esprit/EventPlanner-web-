<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Users List - Mythos Planner</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; }
        .header { text-align: center; margin-bottom: 20px; padding: 20px; border-bottom: 2px solid #2c3e50; }
        h1 { color: #2c3e50; margin: 0; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th { background-color: #2c3e50; color: white; padding: 12px 8px; }
        td { padding: 8px; border-bottom: 1px solid #ddd; }
        tr:nth-child(even) { background-color: #f9f9f9; }
        .footer { margin-top: 30px; text-align: center; font-size: 12px; color: #666; }
        .stats { margin: 20px 0; padding: 15px; background: #f8f9fa; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Mythos Planner - Users List</h1>
        <p>Generated on {{ "now"|date("F j, Y, g:i a") }}</p>
    </div>

    <div class="stats">
        <p><strong>Total Users:</strong> {{ users|length }}</p>
        <p><strong>Roles Distribution:</strong></p>
        {% set roles = {} %}
        {% for user in users %}
            {% set role = user.roles[0]|replace({'ROLE_': ''}) %}
            {% set roles = roles|merge({(role): (roles[role] ?? 0) + 1}) %}
        {% endfor %}
        <ul>
            {% for role, count in roles %}
                <li>{{ role }}: {{ count }} users</li>
            {% endfor %}
        </ul>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Verified</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.firstName }} {{ user.lastName }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles[0]|replace({'ROLE_': ''}) }}</td>
                    <td>{{ user.isVerified ? 'Yes' : 'No' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        <p>Generated by Mythos Planner Administration System</p>
        <p>&copy; {{ "now"|date("Y") }} Mythos Planner. All rights reserved.</p>
    </div>
</body>
</html>