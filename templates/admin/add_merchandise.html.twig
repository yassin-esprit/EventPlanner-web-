{% extends 'base.html.twig' %}

{% block title %}Add Merchandise{% endblock %}

{% block body %}
    <section class="ticket-section section-padding" style="
            background-image: url('{{ asset('images/nainoa-shizuru-unsplash-blur.jpg') }}');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            position: relative;
            min-height: 100vh;
            padding-top: 80px;
            padding-bottom: 80px;
            display: flex;
            align-items: center;
        ">
        <div class="section-overlay" style="
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5);
            "></div>
        
        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-10 mx-auto">
                    <div class="custom-form ticket-form mb-5 mb-lg-0" style="
                            background-color: #ffffff;
                            padding: 30px;
                            border-radius: 10px;
                            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
                            position: relative;
                            z-index: 1;
                        ">
                        <h2 class="text-center mb-4" style="color: #2c3e50;">Add Merchandise</h2>

                        <form action="{{ path('admin_add_merchandise') }}" method="post" enctype="multipart/form-data" novalidate>
                            <div class="ticket-form-body">
                                <div class="input-with-error">
                                    <input type="text" 
                                           class="form-control" 
                                           id="name" 
                                           name="name" 
                                           placeholder="Name *"
                                           required 
                                           minlength="3" 
                                           maxlength="100"
                                           pattern="[A-Za-zÀ-ÿ\s]+"
                                           title="Name can only contain letters and spaces"
                                           style="height: 50px; border-radius: 5px; margin-bottom: 20px;">
                                    <div class="error-message" style="
                                            position: absolute;
                                            top: 100%;
                                            left: 0;
                                            width: 100%;
                                            padding: 5px 10px;
                                            background-color: #f8d7da;
                                            color: #721c24;
                                            border: 1px solid #f5c6cb;
                                            border-radius: 0 0 5px 5px;
                                            font-size: 0.8rem;
                                            z-index: 10;
                                            margin-top: -2px;
                                            display: none;
                                        ">
                                        Please provide a valid name (3-100 characters, letters and spaces only).
                                    </div>
                                </div>

                                <div class="input-with-error">
                                    <input type="file" 
                                           class="form-control" 
                                           id="image" 
                                           name="image" 
                                           accept="image/jpeg,image/png,image/gif"
                                           required
                                           style="height: 50px; border-radius: 5px; margin-bottom: 20px;">
                                    <div class="error-message" style="display: none;">
                                        Please select an image file (JPEG, PNG, or GIF).
                                    </div>
                                    <small class="form-text text-muted" style="
                                            margin-top: -15px;
                                            margin-bottom: 15px;
                                            font-size: 0.8rem;
                                            color: #6c757d !important;
                                        ">Supported formats: JPEG, PNG, GIF. Maximum size: 2MB.</small>
                                </div>

                                <div class="input-with-error">
                                    <textarea class="form-control" 
                                              id="description" 
                                              name="description" 
                                              placeholder="Description *"
                                              rows="5" 
                                              required 
                                              minlength="10" 
                                              maxlength="500"
                                              style="min-height: 120px; resize: vertical; border-radius: 5px; margin-bottom: 20px;"></textarea>
                                    <div class="error-message" style="display: none;">
                                        Please provide a description (10-500 characters).
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-12">
                                        <div class="input-with-error">
                                            <div class="input-group" style="margin-bottom: 20px;">
                                                <span class="input-group-text" style="
                                                        border-radius: 5px 0 0 5px !important;
                                                        background-color: #f8f9fa;
                                                        border-color: #ced4da;
                                                    ">$</span>
                                                <input type="number" 
                                                       class="form-control" 
                                                       id="price" 
                                                       name="price" 
                                                       placeholder="Price *"
                                                       step="0.01" 
                                                       min="0.01" 
                                                       max="9999.99" 
                                                       required
                                                       style="height: 50px; border-radius: 0 5px 5px 0;">
                                            </div>
                                            <div class="error-message" style="display: none;">
                                                Please enter a valid price (between $0.01 and $9999.99).
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-6 col-md-6 col-12">
                                        <div class="input-with-error">
                                            <input type="number" 
                                                   class="form-control" 
                                                   id="quantity" 
                                                   name="quantity" 
                                                   placeholder="Quantity *"
                                                   min="0" 
                                                   max="9999" 
                                                   required
                                                   style="height: 50px; border-radius: 5px; margin-bottom: 20px;">
                                            <div class="error-message" style="display: none;">
                                                Please enter a valid quantity (between 0 and 9999).
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6 col-8 mx-auto mt-4">
                                    <button type="submit" class="form-control" style="
                                            background-color: #3498db;
                                            color: white;
                                            border: none;
                                            height: 50px;
                                            border-radius: 5px;
                                            font-weight: bold;
                                        ">Add Merchandise</button>
                                </div>

                                <div class="text-center mt-3">
                                    <a href="{{ path('admin_merchandise') }}" style="
                                            color: #3498db;
                                            text-decoration: none;
                                        ">Back to Merchandise</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            
            // Form validation
            form.addEventListener('submit', function(event) {
                let isValid = true;
                
                // Validate all required fields
                const requiredFields = form.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        showError(field, 'This field is required.');
                        isValid = false;
                    } else {
                        // Field-specific validation
                        if (field.id === 'name' && !field.checkValidity()) {
                            showError(field, 'Please provide a valid name (3-100 characters, letters and spaces only).');
                            isValid = false;
                        } else if (field.id === 'image') {
                            const file = field.files[0];
                            if (file) {
                                const validTypes = ['image/jpeg', 'image/png', 'image/gif'];
                                if (!validTypes.includes(file.type)) {
                                    showError(field, 'Please select a valid image file (JPEG, PNG, or GIF).');
                                    isValid = false;
                                } else if (file.size > 2 * 1024 * 1024) {
                                    showError(field, 'File size must be less than 2MB.');
                                    isValid = false;
                                }
                            }
                        } else if (field.id === 'description' && !field.checkValidity()) {
                            showError(field, 'Please provide a description (10-500 characters).');
                            isValid = false;
                        } else if (field.id === 'price' && !field.checkValidity()) {
                            showError(field, 'Please enter a valid price (between $0.01 and $9999.99).');
                            isValid = false;
                        } else if (field.id === 'quantity' && !field.checkValidity()) {
                            showError(field, 'Please enter a valid quantity (between 0 and 9999).');
                            isValid = false;
                        }
                    }
                });
                
                if (!isValid) {
                    event.preventDefault();
                    event.stopPropagation();
                }
            });
            
            // Name field validation - remove non-letters
            const nameInput = document.getElementById('name');
            nameInput.addEventListener('input', function() {
                this.value = this.value.replace(/[^A-Za-zÀ-ÿ\s]/g, '');
            });
            
            // Show error message
            function showError(field, message) {
                field.classList.add('is-invalid');
                const errorContainer = field.closest('.input-with-error').querySelector('.error-message');
                if (errorContainer) {
                    errorContainer.textContent = message;
                    errorContainer.style.display = 'block';
                    field.style.borderColor = '#dc3545';
                    field.style.marginBottom = '0';
                }
            }
            
            // Clear error on input
            form.querySelectorAll('input, textarea').forEach(field => {
                field.addEventListener('input', function() {
                    this.classList.remove('is-invalid');
                    const errorContainer = this.closest('.input-with-error').querySelector('.error-message');
                    if (errorContainer) {
                        errorContainer.style.display = 'none';
                    }
                    this.style.borderColor = '';
                    this.style.marginBottom = '20px';
                });
            });
        });
    </script>
{% endblock %}