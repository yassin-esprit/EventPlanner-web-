<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .content {
            margin-top: 20px;
        }
        .footer {
            text-align: center;
            margin-top: 40px;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Donation Confirmation</h1>
    </div>

    <div class="content">
        <p>Thank you for your generous donation!</p>
        <p><strong>User:</strong> {{ donation.user.email }}</p>
        <p><strong>Amount:</strong> {{ donation.amount }}</p>
        <p><strong>Date:</strong> {{ "now"|date("Y-m-d H:i:s") }}</p>
    </div>

    <div class="footer">
        <p>Generated by the Admin Panel</p>
    </div>
</body>
</html>