{% extends 'base.html.twig' %}

{% block title %}Manage Merchandise{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Manage Merchandise</h1>
            <a href="{{ path('app_admin_new_merchandise') }}" class="btn btn-primary">Add Merchandise</a>
        </div>

        <div class="card">
            <div class="card-header">
                <form class="d-flex" method="get">
                    <input type="text" name="search" class="form-control me-2" placeholder="Search merchandise..." value="{{ app.request.query.get('search') }}">
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                </form>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    <a href="{{ path('app_admin_merchandise', {
                                        sort: 'name',
                                        order: currentSort == 'name' and currentOrder == 'ASC' ? 'DESC' : 'ASC'
                                    }) }}">
                                        Name
                                        {% if currentSort == 'name' %}
                                            <i class="fas fa-sort-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th>Description</th>
                                <th>
                                    <a href="{{ path('app_admin_merchandise', {
                                        sort: 'price',
                                        order: currentSort == 'price' and currentOrder == 'ASC' ? 'DESC' : 'ASC'
                                    }) }}">
                                        Price
                                        {% if currentSort == 'price' %}
                                            <i class="fas fa-sort-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th>
                                    <a href="{{ path('app_admin_merchandise', {
                                        sort: 'quantity',
                                        order: currentSort == 'quantity' and currentOrder == 'ASC' ? 'DESC' : 'ASC'
                                    }) }}">
                                        Quantity
                                        {% if currentSort == 'quantity' %}
                                            <i class="fas fa-sort-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in merchandise %}
                                <tr>
                                    <td>{{ item.name }}</td>
                                    <td>{{ item.description|slice(0, 100) }}{% if item.description|length > 100 %}...{% endif %}</td>
                                    <td>${{ item.price|number_format(2) }}</td>
                                    <td>{{ item.quantity }}</td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="{{ path('app_admin_edit_merchandise', {id: item.id}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <form action="{{ path('app_admin_delete_merchandise', {id: item.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this item?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center">No merchandise found</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="navigation">
                    {{ knp_pagination_render(merchandise) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}