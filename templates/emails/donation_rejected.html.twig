{% extends 'emails/base_email.html.twig' %}

{% block title %}Donation Request Not Approved{% endblock %}

{% block content %}
    <p>Dear {{ donation.user.firstName }},</p>

    <p>We regret to inform you that your donation request could not be approved at this time.</p>

    <div class="details">
        <h3>Request Details:</h3>
        <ul>
            <li>Amount: ${{ donation.amount|number_format(2) }}</li>
            <li>Date Requested: {{ donation.requestedAt|date('F j, Y') }}</li>
            <li>Date Processed: {{ donation.processedAt|date('F j, Y') }}</li>
        </ul>
    </div>

    {% if donation.comment %}
        <p><strong>Reason:</strong> {{ donation.comment }}</p>
    {% endif %}

    <p>If you have any questions about this decision, please don't hesitate to contact us.</p>

    <p>Best regards,<br>The Admin Team</p>
{% endblock %}