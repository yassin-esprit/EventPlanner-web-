{% extends 'base.html.twig' %}

{% block title %}Créer un Contrat{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div id="sidebar" class="col-md-3 bg-dark text-white min-vh-100 sidebar p-0">
            <ul class="navbar-nav sidebar sidebar-dark accordion">
                <a class="sidebar-brand d-flex align-items-center justify-content-center py-4" href="#">
                    <div class="sidebar-brand-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div class="sidebar-brand-text mx-2">Admin Panel</div>
                </a>

                <hr class="sidebar-divider my-0 bg-light">

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="dashboard">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <hr class="sidebar-divider bg-light">

                <div class="sidebar-heading text-light">
                    Management
                </div>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="events">
                        <i class="bi bi-calendar-event"></i>
                        <span>Events</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="sponsors">
                        <i class="bi bi-award"></i>
                        <span>Sponsors</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="equipements">
                        <i class="bi bi-truck"></i>
                        <span>Equipement</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="ads">
                        <i class="bi bi-megaphone"></i>
                        <span>Advertisements</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="merchandise">
                        <i class="bi bi-shop"></i>
                        <span>Merchandise</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" href="#" data-section="users">
                        <i class="bi bi-people"></i>
                        <span>Users</span>
                    </a>
                </li>
            </ul>
        </div>
        <!-- End Sidebar -->

        <!-- Content -->
        <div id="content" class="col-md-9">
            <header class="admin-header py-3 border-bottom mb-3">
                <div class="container">
                    <div class="welcome-container d-flex justify-content-between align-items-center">
                        <p class="welcome-message mb-0">
                            <i class="bi-person custom-icon me-2"></i>
                            <strong class="text-dark">
                                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                    Welcome back, {{ app.user.firstName ?? app.user.email }}
                                {% endif %}
                            </strong>
                        </p>
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm">
                                <i class="bi-box-arrow-right"></i> Logout
                            </a>
                        {% endif %}
                    </div>
                </div>
            </header>

            <div class="container mt-4">
                <div class="row justify-content-between align-items-center mb-4">
                    <div class="col-md-8">
                        <h1 class="display-6">Créer un nouveau Contrat</h1>
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="{{ path('app_contrat_index') }}" class="btn btn-secondary">Retour à la liste</a>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        {{ form_start(form) }}
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    {{ form_row(form.type_contrat, { 'label': 'Type de Contrat' }) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.montant, { 'label': 'Montant (TND)' }) }}
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-12">
                                    {{ form_row(form.description, { 'label': 'Description' }) }}
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    {{ form_row(form.date_debut, { 'label': 'Date de Début' }) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.date_fin, { 'label': 'Date de Fin' }) }}
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    {{ form_row(form.statut, { 'label': 'Statut' }) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.mode_paiement, { 'label': 'Mode de Paiement' }) }}
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-12">
                                    {{ form_row(form.sponsor, { 'label': 'Sponsor' }) }}
                                </div>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary">Créer le Contrat</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
        <!-- End Content -->
    </div>
</div>

<!-- Toast container -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    <div id="toast-container"></div>
</div>

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        {% for field in form %}
            {% for error in field.vars.errors %}
                createToast("Erreur dans {{ field.vars.label|e }}", "{{ error.message|e }}");
            {% endfor %}
        {% endfor %}

        {% for error in form.vars.errors %}
            createToast("Erreur", "{{ error.message|e }}");
        {% endfor %}
    });

    function createToast(title, message) {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = 'toast align-items-center text-white bg-danger border-0 show mb-2';
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');
        toast.setAttribute('aria-atomic', 'true');

        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">
                    <strong>${title}</strong><br>${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        `;
        container.appendChild(toast);

        setTimeout(() => {
            toast.remove();
        }, 5000);
    }
</script>
{% endblock %}
{% endblock %}
