<form method="post" action="{{ path('app_contrat_delete', {'id_contrat': contrat.id_contrat}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contrat.id_contrat) }}">
    <button class="btn">Delete</button>
</form>
