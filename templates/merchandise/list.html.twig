{% extends 'base.html.twig' %}

{% block title %}Our Merchandise{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="text-center mb-5">Our Merchandise</h1>

    <div class="row">
        {% for item in merchandise %}
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-img-container">
                        <img src="{{ asset('uploads/merchandise/' ~ item.image) }}" 
                             class="card-img-top" 
                             alt="{{ item.name }}"
                             style="height: 250px; object-fit: cover;">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">{{ item.name }}</h5>
                        <p class="card-text">{{ item.description }}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="price">
                                <span class="text-primary fw-bold">${{ item.price }}</span>
                            </div>
                            <div class="stock">
                                {% if item.quantity > 0 %}
                                    <span class="badge bg-success">In Stock ({{ item.quantity }})</span>
                                {% else %}
                                    <span class="badge bg-danger">Out of Stock</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center">
                    No merchandise available at the moment.
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<style>
.card {
    transition: transform 0.2s;
    border: none;
    border-radius: 10px;
    overflow: hidden;
}

.card:hover {
    transform: translateY(-5px);
}

.card-img-container {
    overflow: hidden;
    background-color: #f8f9fa;
}

.card-title {
    color: #333;
    font-weight: 600;
}

.card-text {
    color: #666;
    min-height: 48px;
}

.price {
    font-size: 1.25rem;
}

.badge {
    font-size: 0.9rem;
    padding: 0.5em 0.75em;
}

@media (max-width: 768px) {
    .card-img-top {
        height: 200px !important;
    }
}
</style>
{% endblock %} 