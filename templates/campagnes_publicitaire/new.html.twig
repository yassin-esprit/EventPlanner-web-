
{% extends 'base.html.twig' %}
{% block title %}Create New Advertising Campaign{% endblock %}

{% block body %}
    <section class="ticket-section section-padding" style="
            background-image: url('{{ asset('images/nainoa-shizuru-unsplash-blur.jpg') }}');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            position: relative;
        ">
        <div class="section-overlay" style="
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5);
            "></div>
        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-10 mx-auto">
                    <form class="custom-form ticket-form mb-5 mb-lg-0" method="post" novalidate>
                        <h2 class="text-center mb-4">Create New Advertising Campaign</h2>

                        <div class="ticket-form-body">
                            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_label(form.nom_camp, 'Campaign Name') }}
                                        {{ form_widget(form.nom_camp, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Enter campaign name',
                                                'data-error': form.nom_camp.vars.errors|length > 0 ? form.nom_camp.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.nom_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.nom_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_label(form.budget_camp, 'Budget') }}
                                        {{ form_widget(form.budget_camp, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Enter budget amount',
                                                'data-error': form.budget_camp.vars.errors|length > 0 ? form.budget_camp.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.budget_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.budget_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_label(form.date_debut_camp, 'Start Date') }}
                                        {{ form_widget(form.date_debut_camp, {
                                            'attr': {
                                                'class': 'form-control',
                                                'data-error': form.date_debut_camp.vars.errors|length > 0 ? form.date_debut_camp.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.date_debut_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.date_debut_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_label(form.date_fin_camp, 'End Date') }}
                                        {{ form_widget(form.date_fin_camp, {
                                            'attr': {
                                                'class': 'form-control',
                                                'data-error': form.date_fin_camp.vars.errors|length > 0 ? form.date_fin_camp.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.date_fin_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.date_fin_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_label(form.statut_camp, 'Status') }}
                                        {{ form_widget(form.statut_camp, {
                                            'attr': {
                                                'class': 'form-select',
                                                'data-error': form.statut_camp.vars.errors|length > 0 ? form.statut_camp.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.statut_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.statut_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_label(form.publicite, 'Advertisement') }}
                                        {{ form_widget(form.publicite, {
                                            'attr': {
                                                'class': 'form-select',
                                                'data-error': form.publicite.vars.errors|length > 0 ? form.publicite.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.publicite.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.publicite.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-6 col-8 mx-auto mt-4">
                                <button type="submit" class="form-control">{{ button_label|default('Create Campaign') }}</button>
                            </div>

                            <div class="text-center mt-3">
                                <a href="{{ path('app_campagnes_publicitaire_index') }}" class="btn btn-link">Back to Campaigns</a>
                            </div>

                            {{ form_end(form) }}
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ticket-section {
            position: relative;
            min-height: 100vh;
            padding-top: 80px;
            padding-bottom: 80px;
            display: flex;
            align-items: center;
        }

        .ticket-form {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.2);
        }

        .ticket-form h2 {
            color: #333;
            font-weight: 700;
        }

        .ticket-form-body {
            padding: 20px 0;
        }

        .form-control, .form-select {
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 12px 15px;
            margin-bottom: 20px;
            transition: all 0.3s;
        }

        .form-control:focus, .form-select:focus {
            border-color: #f6388a;
            box-shadow: 0 0 0 0.25rem rgba(246, 56, 138, 0.25);
        }

        button[type="submit"] {
            background-color: #f6388a;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 5px;
            font-weight: 600;
            transition: all 0.3s;
        }

        button[type="submit"]:hover {
            background-color: #e4317d;
            transform: translateY(-2px);
        }

        .btn-link {
            color: #f6388a;
            text-decoration: none;
        }

        .btn-link:hover {
            text-decoration: underline;
        }

        .input-with-error {
            position: relative;
            margin-bottom: 20px;
        }

        .error-message {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            padding: 5px 10px;
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            border-radius: 0 0 5px 5px;
            font-size: 0.8rem;
            z-index: 10;
            margin-top: -2px;
        }

        .is-invalid {
            border-color: #dc3545 !important;
            margin-bottom: 0;
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
            color: #555;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Clear invalid input and show error messages
            document.querySelectorAll('[data-error]').forEach(element => {
                if (element.dataset.error) {
                    // Add invalid class to parent container
                    element.classList.add('is-invalid');

                    // For text inputs, clear the invalid value
                    if (element.tagName === 'INPUT' && element.type !== 'file') {
                        element.value = '';
                    }

                    // For selects, reset to placeholder
                    if (element.tagName === 'SELECT') {
                        element.selectedIndex = 0;
                    }
                }
            });
        });
    </script>
{% endblock %}