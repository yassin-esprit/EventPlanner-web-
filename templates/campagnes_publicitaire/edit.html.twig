{% extends 'base.html.twig' %}

{% block title %}Edit Campaign{% endblock %}

{% block body %}
    <section class="ticket-section section-padding" style="
            background-image: url('{{ asset('images/nainoa-shizuru-unsplash-blur.jpg') }}');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            position: relative;
        ">
        <div class="section-overlay" style="
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5);
            "></div>

        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-10 mx-auto">
                    <form class="custom-form ticket-form mb-5 mb-lg-0" method="post" novalidate>
                        <h2 class="text-center mb-4">Edit Campaign</h2>

                        <div class="ticket-form-body">
                            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_widget(form.nom_camp, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Campaign Name',
                                                'data-error': form.nom_camp.vars.errors|length > 0 ? form.nom_camp.vars.errors[0].message : ''
                                            },
                                            'label': false
                                        }) }}
                                        {% if form.nom_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.nom_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_widget(form.budget_camp, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Budget',
                                                'data-error': form.budget_camp.vars.errors|length > 0 ? form.budget_camp.vars.errors[0].message : ''
                                            },
                                            'label': false
                                        }) }}
                                        {% if form.budget_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.budget_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_label(form.date_debut_camp, form.date_debut_camp.vars.errors|length > 0 ? form.date_debut_camp.vars.errors[0].message : 'Start Date', {
                                            'label_attr': {'class': 'form-label'}
                                        }) }}
                                        {{ form_widget(form.date_debut_camp, {
                                            'attr': {
                                                'class': 'form-control',
                                                'data-error': form.date_debut_camp.vars.errors|length > 0 ? form.date_debut_camp.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.date_debut_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.date_debut_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_label(form.date_fin_camp, form.date_fin_camp.vars.errors|length > 0 ? form.date_fin_camp.vars.errors[0].message : 'End Date', {
                                            'label_attr': {'class': 'form-label'}
                                        }) }}
                                        {{ form_widget(form.date_fin_camp, {
                                            'attr': {
                                                'class': 'form-control',
                                                'data-error': form.date_fin_camp.vars.errors|length > 0 ? form.date_fin_camp.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.date_fin_camp.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.date_fin_camp.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="input-with-error">
                                {{ form_widget(form.statut_camp, {
                                    'attr': {
                                        'class': 'form-select',
                                        'data-error': form.statut_camp.vars.errors|length > 0 ? form.statut_camp.vars.errors[0].message : ''
                                    },
                                    'label': 'Status'
                                }) }}
                                {% if form.statut_camp.vars.errors|length > 0 %}
                                    <div class="error-message">{{ form.statut_camp.vars.errors[0].message }}</div>
                                {% endif %}
                            </div>

                            <div class="input-with-error">
                                {{ form_label(form.publicite, form.publicite.vars.errors|length > 0 ? form.publicite.vars.errors[0].message : 'Select Advertisement', {
                                    'label_attr': {'class': 'form-label'}
                                }) }}
                                {{ form_widget(form.publicite, {
                                    'attr': {
                                        'class': 'form-select',
                                        'data-error': form.publicite.vars.errors|length > 0 ? form.publicite.vars.errors[0].message : ''
                                    },
                                    'placeholder': 'Choose an Advertisement'
                                }) }}
                                {% if form.publicite.vars.errors|length > 0 %}
                                    <div class="error-message">{{ form.publicite.vars.errors[0].message }}</div>
                                {% endif %}
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <div class="col-lg-4 col-md-6 col-8">
                                    <button type="submit" class="form-control">Update Campaign</button>
                                </div>

                                <div class="col-lg-4 col-md-6 col-8">
                                    <a href="{{ path('app_campagnes_publicitaire_index') }}" class="btn btn-outline-secondary form-control">Cancel</a>
                                </div>
                            </div>

                            <div class="text-center mt-4">
                                <form method="post" action="{{ path('app_campagnes_publicitaire_delete', {'id_camp': campagnes_publicitaire.getIdCamp}) }}" onsubmit="return confirm('Are you sure you want to delete this campaign?');" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ campagnes_publicitaire.getIdCamp) }}">
                                    <button class="btn btn-delete">
                                        <i class="bi bi-trash me-2"></i>Delete Campaign
                                    </button>
                                </form>
                            </div>

                            {{ form_end(form) }}
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ticket-section {
            position: relative;
            min-height: 100vh;
            padding-top: 80px;
            padding-bottom: 80px;
            display: flex;
            align-items: center;
        }

        .custom-form {
            position: relative;
            background: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }

        .input-with-error {
            position: relative;
            margin-bottom: 20px;
        }

        .error-message {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            padding: 5px 10px;
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            border-radius: 0 0 5px 5px;
            font-size: 0.8rem;
            z-index: 10;
            margin-top: -20px;
        }

        .is-invalid {
            border-color: #dc3545 !important;
            margin-bottom: 0;
        }

        .btn-delete {
            background-color: transparent;
            border: none;
            color: #dc3545;
            padding: 0;
            font-size: 0.9rem;
        }

        .btn-delete:hover {
            color: #c82333;
            text-decoration: underline;
        }

        .form-label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Clear invalid input and show error messages
            document.querySelectorAll('[data-error]').forEach(element => {
                if (element.dataset.error) {
                    element.classList.add('is-invalid');

                    // For text inputs, clear only if invalid
                    if (element.tagName === 'INPUT' && element.type !== 'file' && !element.value) {
                        element.value = '';
                    }

                    // For selects, reset to placeholder if invalid
                    if (element.tagName === 'SELECT' && !element.value) {
                        element.selectedIndex = 0;
                    }
                }
            });

            // Special handling for edit form - preserve valid values
            const form = document.querySelector('form');
            form.addEventListener('submit', function (e) {
                if (!this.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                this.classList.add('was-validated');
            }, false);
        });
    </script>
{% endblock %}