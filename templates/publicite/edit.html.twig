{% extends 'base.html.twig' %}

{% block title %}Edit Advertisement{% endblock %}

{% block body %}
    <section class="ticket-section section-padding" style="
            background-image: url('{{ asset('images/nainoa-shizuru-unsplash-blur.jpg') }}');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            position: relative;
        ">
        <div class="section-overlay" style="
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5);
            "></div>
        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-10 mx-auto">
                    <form class="custom-form ticket-form mb-5 mb-lg-0" method="post" novalidate>
                        <h2 class="text-center mb-4">Edit Advertisement</h2>

                        <div class="ticket-form-body">
                            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

                            <div class="input-with-error">
                                {{ form_widget(form.titre_pub, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Advertisement Title',
                                        'data-error': form.titre_pub.vars.errors|length > 0 ? form.titre_pub.vars.errors[0].message : ''
                                    }
                                }) }}
                                {% if form.titre_pub.vars.errors|length > 0 %}
                                    <div class="error-message">{{ form.titre_pub.vars.errors[0].message }}</div>
                                {% endif %}
                            </div>

                            <div class="input-with-error">
                                {{ form_widget(form.type_pub, {
                                    'attr': {
                                        'class': 'form-select',
                                        'placeholder': 'Advertisement Type',
                                        'rows': 3,
                                        'data-error': form.type_pub.vars.errors|length > 0 ? form.type_pub.vars.errors[0].message : ''
                                    }
                                }) }}
                                {% if form.type_pub.vars.errors|length > 0 %}
                                    <div class="error-message">{{ form.type_pub.vars.errors[0].message }}</div>
                                {% endif %}
                            </div>

                            <div class="input-with-error">
                                {{ form_widget(form.contenu_pub, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Advertisement Content',
                                        'rows': 5,
                                        'data-error': form.contenu_pub.vars.errors|length > 0 ? form.contenu_pub.vars.errors[0].message : ''
                                    }
                                }) }}
                                {% if form.contenu_pub.vars.errors|length > 0 %}
                                    <div class="error-message">{{ form.contenu_pub.vars.errors[0].message }}</div>
                                {% endif %}
                            </div>

                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_widget(form.emplacement_pub, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Advertisement Emplacement',
                                                'data-error': form.emplacement_pub.vars.errors|length > 0 ? form.emplacement_pub.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.emplacement_pub.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.emplacement_pub.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="input-with-error">
                                        {{ form_widget(form.statut_pub, {
                                            'attr': {
                                                'class': 'form-select',
                                                'data-error': form.statut_pub.vars.errors|length > 0 ? form.statut_pub.vars.errors[0].message : ''
                                            }
                                        }) }}
                                        {% if form.statut_pub.vars.errors|length > 0 %}
                                            <div class="error-message">{{ form.statut_pub.vars.errors[0].message }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-lg-6 col-md-6 col-12 mx-auto">
                                    <button type="submit" class="form-control">Update</button>
                                </div>
                            </div>

                            {{ form_end(form) }}

                            <div class="text-center mt-4">
                                <a href="{{ path('app_publicite_index') }}" class="btn btn-link me-3">Back to list</a>
                                
                                {# Delete form styled to match the design #}
                                <form method="post" action="{{ path('app_publicite_delete', {'id_pub': publicite.id_pub}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ publicite.id_pub) }}">
                                    <button class="btn btn-link text-danger" onclick="return confirm('Are you sure you want to delete this item?')">Delete</button>
                                </form>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ticket-section {
            position: relative;
            min-height: 100vh;
            padding-top: 80px;
            padding-bottom: 80px;
            display: flex;
            align-items: center;
        }

        .custom-form {
            background-color: #ffffff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            position: relative;
            z-index: 1;
        }

        .custom-form h2 {
            color: #2c3e50;
            margin-bottom: 30px;
        }

        .form-control {
            height: 50px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #3498db;
        }

        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }

        .form-select {
            height: 50px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .btn-link {
            color: #3498db;
            text-decoration: none;
        }

        .btn-link:hover {
            text-decoration: underline;
        }

        .text-danger {
            color: #dc3545;
        }

        /* Error message styles */
        .input-with-error {
            position: relative;
            margin-bottom: 20px;
        }

        .error-message {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            padding: 5px 10px;
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            border-radius: 0 0 5px 5px;
            font-size: 0.8rem;
            z-index: 10;
            margin-top: -2px;
        }

        .is-invalid {
            border-color: #dc3545 !important;
            margin-bottom: 0;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Clear invalid input and show error messages
            document.querySelectorAll('[data-error]').forEach(element => {
                if (element.dataset.error) {
                    // Add invalid class to parent container
                    element.classList.add('is-invalid');

                    // For text inputs, clear the invalid value
                    if (element.tagName === 'INPUT' && element.type !== 'file') {
                        element.value = '';
                    }

                    // For selects, reset to placeholder
                    if (element.tagName === 'SELECT') {
                        element.selectedIndex = 0;
                    }
                }
            });
        });
    </script>
{% endblock %}