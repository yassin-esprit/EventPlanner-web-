<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Publicité: {{ publicite.titrePub }}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { text-align: center; margin-bottom: 20px; }
        .title { font-size: 24px; color: #333; }
        .badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 4px;
            font-weight: bold;
        }
        
        .type-badge { background: #f6388a; color: white; }
        .status-active { background: #28a745; color: white; }
        .status-inactive { background: #dc3545; color: white; }
        .section { margin-bottom: 15px; }
        .section-title { 
            font-size: 18px; 
            border-bottom: 2px solid #f6388a; 
            padding-bottom: 5px;
        }
        .detail-item { margin-bottom: 10px; }
        .detail-label { font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .footer { margin-top: 30px; text-align: right; font-size: 12px; color: #777; }
        .qr-code { 
            text-align: center; 
            margin: 20px 0;
            padding: 10px;
            border: 1px solid #eee;
            display: inline-block;
        }
        .qr-container {
            text-align: center;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1 class="title">{{ publicite.titrePub }}</h1>
        <div>
            <span class="badge type-badge">{{ publicite.typePub|capitalize }}</span>
            <span class="badge {{ publicite.statutPub == 'active' ? 'status-active' : 'status-inactive' }}">
                {{ publicite.statutPub == 'active' ? 'Active' : 'Inactive' }}
            </span>
        </div>
    </div>

    <div class="section">
        <h2 class="section-title">Contenu</h2>
        {% if publicite.typePub == 'image' %}
            <p><strong> </strong> {{ publicite.contenuPub}}</p>
        {% elseif publicite.typePub == 'video' %}
            <p><strong></strong> {{ publicite.contenuPub }}</p>
        {% else %}
            <p>{{ publicite.contenuPub }}</p>
        {% endif %}
    </div>

    <div class="section">
        <h2 class="section-title">Détails</h2>
        <div class="detail-item">
            <span class="detail-label">Emplacement :</span> {{ publicite.emplacementPub }}
        </div>
        <div class="detail-item">
            <span class="detail-label">TITRE Publicité :</span> #{{ publicite.titre_pub }}
        </div>
    </div>

    {% if publicite.campagnesPublicitaires|length > 0 %}
        <div class="section">
            <h2 class="section-title">Campagnes associées</h2>
            <table>
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Budget (TND)</th>
                        <th>Date début</th>
                        <th>Date fin</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for campagne in publicite.campagnesPublicitaires %}
                        <tr>
                            <td>{{ campagne.nomCamp }}</td>
                            <td>{{ campagne.budgetCamp }}</td>
                            <td>{{ campagne.dateDebutCamp|date('d/m/Y') }}</td>
                            <td>{{ campagne.dateFinCamp|date('d/m/Y') }}</td>
                            <td>{{ campagne.statutCamp|replace({'_': ' '})|capitalize }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# QR Code Section #}
    <div class="qr-container">
        <div class="qr-code">
            <h3>Scan this QR Code for more details </h3>
            {# Generate QR code using goqr.me API #}
           <img 
    src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data={{ 
        ('https://www.google.com/search?q=' ~ publicite.titrePub|url_encode)|url_encode 
    }}" 
    alt="Search on Google"
>
            <p> {{ publicite.titre_pub }}</p>
        </div>
    </div>
    {% endif %}

    <div class="footer">
       <p>Généré le {{ "now"|date("d/m/Y à H:i") }}<br>
        © {{ "now"|date("Y") }} MYTHOS PLANNER - Tous droits réservés</p>
    </div>
</body>
</html>