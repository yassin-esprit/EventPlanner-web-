{% extends 'base.html.twig' %}

{% block title %}Welcome to Mythos Planner{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-8">
            <h1 class="display-4 mb-4">Welcome to Mythos Planner</h1>
            <p class="lead mb-4">Join our community and participate in exciting events!</p>
            
            <div class="row mt-5">
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h3>New User?</h3>
                            <p>Create an account to get started</p>
                            <a href="{{ path('app_register') }}" class="btn btn-primary">Register Now</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h3>Returning User?</h3>
                            <p>Sign in to your account</p>
                            <a href="{{ path('app_login') }}" class="btn btn-success">Login</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <h2>Available Roles</h2>
                <div class="row mt-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h4>Participant</h4>
                                <p>Join and participate in events</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h4>Owner</h4>
                                <p>Create and manage your own events</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h4>Admin</h4>
                                <p>Manage users and oversee the platform</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
