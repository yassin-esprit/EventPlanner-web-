{# templates/rating/rate_event.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Rate
	{{ event.titre }}
{% endblock %}

{% block body %}
	<div class="container py-4">
		<div class="row justify-content-center">
			<div class="col-md-8">
				<div class="card shadow-sm">
					<div class="card-header bg-primary text-white">
						<h2 class="h5 mb-0">
							<i class="bi bi-star-fill me-2"></i>
							{% if existingRating %}Update{% else %}Add
							{% endif %}
							Your Rating for
							{{ event.titre }}
						</h2>
					</div>
					<div class="card-body">
						{{ form_start(form) }}
						<div class="mb-4">
							<label class="form-label">Your rating</label>
							<div class="star-rating">
								{% for i in 5..1 %}
									<i class="bi bi-star-fill star" data-value="{{ i }}"></i>
								{% endfor %}
								{{ form_widget(form.rating) }}
							</div>
							{{ form_errors(form.rating) }}
						</div>

						<div class="mb-3">
							{{ form_label(form.review) }}
							{{ form_widget(form.review) }}
							{{ form_errors(form.review) }}
						</div>

						<div class="d-grid gap-2 d-md-flex justify-content-md-end">
							<a href="{{ path('app_evenement_show', {'id': event.id}) }}" class="btn btn-outline-secondary me-md-2">
								<i class="bi bi-arrow-left me-1"></i>
								Cancel
							</a>
							<button type="submit" class="btn btn-primary">
								<i class="bi bi-check2 me-1"></i>
								Submit Rating
							</button>
						</div>
						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.star-rating {
			font-size: 2rem;
			line-height: 1;
		}
		.star-rating .star {
			color: #ddd;
			cursor: pointer;
			transition: color 0.2s;
			margin-right: 5px;
		}
		.star-rating .star:hover,
		.star-rating .star.active {
			color: #ffc107;
		}
	</style>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		document.addEventListener('DOMContentLoaded', function () {
const stars = document.querySelectorAll('.star-rating .star');
const ratingInput = document.querySelector('.rating-value');

stars.forEach(star => {
star.addEventListener('click', function () {
const value = this.getAttribute('data-value');
ratingInput.value = value;

// Update star display
stars.forEach(s => {
s.classList.toggle('active', s.getAttribute('data-value') <= value);
});
});

// Initialize with existing rating if available
if (ratingInput.value) {
if (star.getAttribute('data-value') <= ratingInput.value) {
star.classList.add('active');
}
}
});
});
	</script>
{% endblock %}
