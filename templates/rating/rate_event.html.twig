{# templates/rating/rate_event.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Rate
	{{ event.titre }}
{% endblock %}

{% block body %}
	<div class="container py-4">
		<div class="row justify-content-center">
			<div class="col-md-8">
				<div class="card shadow-sm">
					<div class="card-header bg-primary text-white">
						<h2 class="h5 mb-0">
							<i class="bi bi-star-fill me-2"></i>
							{% if existingRating %}Update{% else %}Add
							{% endif %}
							Your Rating for
							{{ event.titre }}
						</h2>
					</div>
					<div class="card-body">
						{{ form_start(form) }}
						<div class="mb-3">
							{{ form_label(form.rating) }}
							<div class="star-rating">
								{% for i in 5..1 %}
									<input type="radio" id="star{{ i }}" name="{{ form.rating.vars.full_name }}" value="{{ i }}" {{ (form.rating.vars.value == i) ? 'checked' : '' }}>
									<label for="star{{ i }}">
										<i class="bi bi-star-fill"></i>
									</label>
								{% endfor %}
							</div>
							{{ form_errors(form.rating) }}
						</div>

						<div class="mb-3">
							{{ form_label(form.review) }}
							{{ form_widget(form.review) }}
							{{ form_errors(form.review) }}
						</div>

						<div class="d-grid gap-2 d-md-flex justify-content-md-end">
							<a href="{{ path('app_evenement_show', {'id': event.id}) }}" class="btn btn-outline-secondary me-md-2">
								<i class="bi bi-arrow-left me-1"></i>
								Cancel
							</a>
							<button type="submit" class="btn btn-primary">
								<i class="bi bi-check2 me-1"></i>
								Submit Rating
							</button>
						</div>
						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.star-rating {
			display: flex;
			flex-direction: row-reverse;
			justify-content: flex-end;
		}
		.star-rating input {
			display: none;
		}
		.star-rating label {
			color: #ddd;
			font-size: 1.5rem;
			padding: 0 0.2rem;
			cursor: pointer;
		}
		.star-rating input:checked ~ label,
		.star-rating label:hover,
		.star-rating label:hover ~ label {
			color: #ffc107;
		}
	</style>
{% endblock %}
