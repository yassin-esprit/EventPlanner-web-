{% extends 'base.html.twig' %}

{% block title %}Equipment Reservations{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <section class="hero-section" id="section_1">
        <div class="section-overlay"></div>
        <div class="container d-flex justify-content-center align-items-center">
            <div class="row">
                <div class="col-12 mt-auto mb-5 text-center">
                    <h1 class="text-white mb-5">Equipment Reservations</h1>
                    <a class="btn custom-btn smoothscroll" href="#reservations">Browse Reservations</a>
                </div>
            </div>
        </div>
        <div class="video-wrap">
            <video autoplay loop muted class="custom-video" poster="">
                <source src="{{ asset('video/pexels-2022395.mp4') }}" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        </div>
    </section>

    <!-- Reservations Section -->
    <section class="artists-section section-padding" id="reservations" style="
            background-image: url('{{ asset('images/nainoa-shizuru-unsplash-blur.jpg') }}');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            position: relative;
        ">
        <div class="section-overlay" style="
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(231, 228, 228, 0.5);
            "></div>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 text-center mb-5">
                    <h2 class="mb-4">Equipment Reservations</h2>
                    <a href="{{ path('app_reservation_equipement_new') }}" class="btn custom-btn">
                        <i class="bi bi-plus-circle me-2"></i>Create New Reservation
                    </a>
                </div>

                {% for reservation in reservation_equipements %}
                    {% set status_colors = {
                        'pending': 'rgba(255, 193, 7, 0.9)',
                        'confirmed': 'rgba(40, 167, 69, 0.9)',
                        'cancelled': 'rgba(220, 53, 69, 0.9)',
                        'completed': 'rgba(23, 162, 184, 0.9)',
                        'default': 'rgba(108, 117, 125, 0.9)'
                    } %}
                    
                    {% set current_color = status_colors[reservation.statut|lower] ?? status_colors['default'] %}

                    <div class="col-lg-4 col-md-6 col-12 mb-4">
                        <div class="artists-thumb">
                            <div class="artists-image-wrap">
                                <img src="{{ asset('assets/images/equipment/equipment-' ~ random(1, 5) ~ '.jpg') }}" class="artists-image img-fluid" alt="Equipment">
                                <div class="artists-date-badge">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    {{ reservation.dateReservation ? reservation.dateReservation|date('d M') : '' }}
                                </div>
                                <div class="artists-type-badge" style="background: {{ current_color }}">
                                    {{ reservation.statut }}
                                </div>
                            </div>
                            <div class="artists-hover" style="background: {{ current_color }}">
                                <h4>Reservation #{{ reservation.id }}</h4>
                                <div class="event-meta">
                                    <p>
                                        <i class="bi bi-calendar"></i>
                                        {{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d H:i') : '' }}
                                    </p>
                                    <p>
                                        <i class="bi bi-gear"></i>
                                         Equipment: {{ reservation.equipement ? reservation.equipement.id : 'None' }}
                                    </p>
                                  
                                    <p>
                                        <i class="bi bi-calendar-event"></i>
                                        Event: {{ reservation.evenement ? reservation.evenement.id : 'None' }}
                                    </p>
                                </div>
                                <div class="d-flex justify-content-between mt-3">
                                    <a href="{{ path('app_reservation_equipement_show', {'id': reservation.id}) }}" class="btn btn-sm btn-light">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                    <a href="{{ path('app_reservation_equipement_edit', {'id': reservation.id}) }}" class="btn btn-sm btn-outline-light">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center">
                        <div class="alert alert-info py-4">
                            <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
                            <h4>No reservations found</h4>
                            <p class="mb-0">Create your first reservation to get started!</p>
                            <a href="{{ path('app_reservation_equipement_new') }}" class="btn btn-primary mt-3">
                                <i class="bi bi-plus-circle me-1"></i>Create Reservation
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Hero Section */
        .hero-section {
            position: relative;
            height: 100vh;
            min-height: 600px;
            display: flex;
            align-items: center;
            overflow: hidden;
        }

        .section-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 0;
        }

        .video-wrap {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }

        .custom-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Reservations Section */
        .artists-section {
            position: relative;
        }

        .artists-thumb {
            position: relative;
            overflow: hidden;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            height: 100%;
        }

        .artists-thumb:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

        .artists-image-wrap {
            position: relative;
            height: 300px;
            overflow: hidden;
        }

        .artists-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .artists-thumb:hover .artists-image {
            transform: scale(1.1);
        }

        .artists-date-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 8px 12px;
            border-radius: 5px;
            font-weight: bold;
            display: flex;
            align-items: center;
        }

        .artists-type-badge {
            position: absolute;
            top: 20px;
            left: 20px;
            color: white;
            padding: 6px 12px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 0.8rem;
        }

        .artists-hover {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            color: white;
            padding: 20px;
            transform: translateY(100%);
            transition: transform 0.3s ease;
            border-radius: 0 0 10px 10px;
        }

        .artists-thumb:hover .artists-hover {
            transform: translateY(0);
        }

        .event-meta {
            margin-bottom: 15px;
            color: #000;
            background-color: rgba(255, 255, 255, 0.8);
            padding: 15px;
            border-radius: 8px;
        }

        .event-meta p {
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            color: #000;
        }

        .event-meta i {
            margin-right: 8px;
            font-size: 1.1rem;
            color: #000;
        }

        .custom-btn {
            background-color: #f6388a;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
        }

        .custom-btn:hover {
            background-color: #e4317d;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(246, 56, 138, 0.4);
            color: white;
        }

        /* Responsive adjustments */
        @media(max-width: 767.98px) {
            .hero-section {
                min-height: 500px;
            }

            .artists-image-wrap {
                height: 200px;
            }
        }
    </style>
{% endblock %}