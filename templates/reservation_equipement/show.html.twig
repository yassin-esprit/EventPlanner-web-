{% extends 'base.html.twig' %}

{% block title %}Reservation #{{ reservation_equipement.id }} Details{% endblock %}

{% block body %}
    <section class="event-details-section section-padding" style="
            background-image: url('{{ asset('images/nainoa-shizuru-unsplash-blur.jpg') }}');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            position: relative;
        ">
        <div class="section-overlay" style="
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5);
            "></div>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-12">
                    <div class="custom-form event-details-card">
                        <div class="event-header text-center mb-4">
                            <h2 class="event-title">Reservation #{{ reservation_equipement.id }}</h2>
                            <div class="event-meta">
                                <span class="event-type-badge" style="background: {{ reservation_equipement.statut == 'confirmed' ? '#28a745' : reservation_equipement.statut == 'pending' ? '#ffc107' : '#dc3545' }}">
                                    {{ reservation_equipement.statut|capitalize }}
                                </span>
                                <span class="event-date">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    {{ reservation_equipement.dateReservation ? reservation_equipement.dateReservation|date('F j, Y') : '' }}
                                </span>
                            </div>
                        </div>

                        <div class="event-body">
                            <div class="event-details-grid">
                                <div class="detail-item">
                                    <i class="bi bi-calendar-check"></i>
                                    <div>
                                        <h5>Reservation Date</h5>
                                        <p>{{ reservation_equipement.dateReservation ? reservation_equipement.dateReservation|date('Y-m-d H:i') : 'Not specified' }}</p>
                                    </div>
                                </div>

                                <div class="detail-item">
                                    <i class="bi bi-gear"></i>
                                    <div>
                                        <h5>Equipment</h5>
                                        <p>
                                            {% if reservation_equipement.equipement %}
                                                #{{ reservation_equipement.equipement.id }} - {{ reservation_equipement.equipement.nom ?? 'Unnamed equipment' }}
                                            {% else %}
                                                Not assigned
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>

                                <div class="detail-item">
                                    <i class="bi bi-calendar-event"></i>
                                    <div>
                                        <h5>Event</h5>
                                        <p>
                                            {% if reservation_equipement.evenement %}
                                                {{ reservation_equipement.evenement.titre }} ({{ reservation_equipement.evenement.date ? reservation_equipement.evenement.date|date('Y-m-d') : '' }})
                                            {% else %}
                                                Not assigned
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>

                                <div class="detail-item">
                                    <i class="bi bi-info-circle"></i>
                                    <div>
                                        <h5>Status</h5>
                                        <p>{{ reservation_equipement.statut|capitalize }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="event-actions mt-5">
                            <div class="d-flex flex-wrap justify-content-center gap-3">
                                                                <a href="{{ path('app_reservation_equipement_index', {'userId': userId}) }}" class="btn btn-outline-light">                            </div>

                                    <i class="bi bi-arrow-left me-2"></i>Back to Reservations
                                </a>
                                <a href="{{ path('app_reservation_equipement_edit', {'id': reservation_equipement.id}) }}" class="btn btn-primary">
                                    <i class="bi bi-pencil-square me-2"></i>Edit Reservation
                                </a>
                                {{ include('reservation_equipement/_delete_form.html.twig', {'custom_class': 'btn-danger'}) }}
                            </div>
                        



                         
                        <script>
                                   function addToCalendar(ReservationEquipementId) {
                                        window.location.href = '{{ path('Reservation_add_calendar', {'id': 'ID_PLACEHOLDER'}) }}'.replace('ID_PLACEHOLDER', ReservationEquipementId);
                                    }
                                </script>
                           
                             
                        
                           

                            
                            {# Usage in your button #}
                            <button onclick="addToCalendar({{ reservation_equipement.id }})" 
                                class="btn btn-success d-flex align-items-center"
                                style="transition: all 0.3s;"
                                onmouseover="this.style.transform='scale(1.02)'"
                                onmouseout="this.style.transform='scale(1)'">
                            <i class="bi bi-calendar-plus me-2"></i>
                            <span>Add to Calendar</span>
                        </button>
                           </div> 
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .event-details-section {
            position: relative;
            min-height: 100vh;
            padding-top: 80px;
            padding-bottom: 80px;
            display: flex;
            align-items: center;
        }

        .event-details-card {
            background-color: #ffffff;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
        }

        .event-header {
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        }

        .event-title {
            color: #2c3e50;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .event-meta {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
        }

        .event-type-badge {
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .event-date {
            color: #6c757d;
            font-size: 0.95rem;
        }

        .event-details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .detail-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
        }

        .detail-item i {
            font-size: 1.5rem;
            color: #f6388a;
            margin-top: 3px;
        }

        .detail-item h5 {
            color: #2c3e50;
            font-size: 1rem;
            margin-bottom: 5px;
        }

        .detail-item p {
            color: #6c757d;
            margin: 0;
        }

        .btn-outline-light {
            border-color: #6c757d;
            color: #6c757d;
        }

        .btn-outline-light:hover {
            background-color: #6c757d;
            color: white;
        }

        /* Responsive adjustments */
        @media(max-width: 767.98px) {
            .event-details-card {
                padding: 30px 20px;
            }

            .event-meta {
                flex-direction: column;
                gap: 10px;
            }

            .event-actions .d-flex {
                flex-direction: column;
                gap: 10px;
            }

            .event-actions .btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}