{# reservation_equipement/_delete_form.html.twig #}
<form method="post" action="{{ path('app_reservation_equipement_delete', {'id': reservation_equipement.id}) }}" onsubmit="return confirm('Are you sure you want to delete this reservation?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation_equipement.id) }}">
    <button class="btn {{ custom_class|default('btn-danger') }}">
        <i class="bi bi-trash me-2"></i>Delete Reservation
    </button>
</form>