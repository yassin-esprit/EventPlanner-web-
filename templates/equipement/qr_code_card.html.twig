{# templates/equipement/qr_code_card.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Equipment QR Code{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4>QR Code for: {{ equipement.nom }}</h4>
                </div>
                <div class="card-body text-center">
                    {% if error %}
                        <div class="alert alert-danger">{{ error }}</div>
                    {% elseif qrCodeDataUri %}
                        <div class="mb-4">
                            <img src="{{ qrCodeDataUri }}" alt="QR Code" class="img-fluid" style="max-width: 300px;">
                        </div>
                        <div class="equipment-details mb-4">
                            <h5>Equipment Details</h5>
                            <table class="table table-bordered">
                                <tr>
                                    <th>ID</th>
                                    <td>{{ equipement.idEq }}</td>
                                </tr>
                                <tr>
                                    <th>Name</th>
                                    <td>{{ equipement.nom }}</td>
                                </tr>
                                {% if equipement.description %}
                                <tr>
                                    <th>Description</th>
                                    <td>{{ equipement.description }}</td>
                                </tr>
                                {% endif %}
                               
                                <tr>
                                    <th>quantite_dispo</th>
                                    <td>{{ equipement.quantite_dispo }}</td>
                                </tr>
                                <tr>
                                    <th>Status</th>
                                    <td>{{ equipement.statut }}</td>
                                </tr>
                            </table>
                        </div>
                        <div class="text-muted small">
                            <p>Scan this QR code to view equipment details on a mobile device.</p>
                        </div>
                        <div class="mt-3">
                            <a href="{{ path('app_equipement_show', {'id_eq': equipement.idEq}) }}" class="btn btn-secondary">Back to Equipment</a>
                            <a href="#" onclick="window.print(); return false;" class="btn btn-primary">Print QR Code</a>
                        </div>
                    {% else %}
                        <div class="alert alert-warning">Unable to generate QR code.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}