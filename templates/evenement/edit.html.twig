{# edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Edit Event
{% endblock %}

{% block body %}
	<section class="ticket-section section-padding" style="
									        background-image: url('{{ asset('images/nainoa-shizuru-unsplash-blur.jpg') }}');
									        background-size: cover;
									        background-position: center;
									        background-attachment: fixed;
									        position: relative;
									    ">
		<div class="section-overlay" style="
																		        position: absolute;
																		        top: 0;
																		        left: 0;
																		        width: 100%;
																		        height: 100%;
																		        background-color: rgba(0, 0, 0, 0.5);
																		    "></div>

		<div class="container">
			<div class="row">
				<div class="col-lg-8 col-10 mx-auto">
					<form class="custom-form ticket-form mb-5 mb-lg-0" method="post" enctype="multipart/form-data" novalidate>
						<h2 class="text-center mb-4">Edit Event</h2>

						<div class="ticket-form-body">
							{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

							<div class="row">
								<div class="col-lg-6 col-md-6 col-12">
									<div class="input-with-error">
										{{ form_widget(form.titre, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Event Title',
                                                'data-error': form.titre.vars.errors|length > 0 ? form.titre.vars.errors[0].message : ''
                                            },
                                            'label': false
                                        }) }}
										{% if form.titre.vars.errors|length > 0 %}
											<div class="error-message">{{ form.titre.vars.errors[0].message }}</div>
										{% endif %}
									</div>
								</div>

								<div class="col-lg-6 col-md-6 col-12">
									<div class="input-with-error">
										{{ form_widget(form.type, {
                                            'attr': {
                                                'class': 'form-select',
                                                'data-error': form.type.vars.errors|length > 0 ? form.type.vars.errors[0].message : ''
                                            },
                                            'label': false,
                                            'placeholder': 'Select Event Type'
                                        }) }}
										{% if form.type.vars.errors|length > 0 %}
											<div class="error-message">{{ form.type.vars.errors[0].message }}</div>
										{% endif %}
									</div>
								</div>
							</div>

							<div class="input-with-error">
								{{ form_widget(form.description, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Event Description',
                                        'rows': 4,
                                        'data-error': form.description.vars.errors|length > 0 ? form.description.vars.errors[0].message : ''
                                    },
                                    'label': false
                                }) }}
								{% if form.description.vars.errors|length > 0 %}
									<div class="error-message">{{ form.description.vars.errors[0].message }}</div>
								{% endif %}
							</div>

							<div class="row">
								<div class="col-lg-6 col-md-6 col-12">
									<div class="input-with-error">
										{{ form_label(form.date, form.date.vars.errors|length > 0 ? form.date.vars.errors[0].message : 'Event Date', {
                                            'label_attr': {'class': 'form-label'}
                                        }) }}
										{{ form_widget(form.date, {
                                            'attr': {
                                                'class': 'form-control',
                                                'data-error': form.date.vars.errors|length > 0 ? form.date.vars.errors[0].message : ''
                                            }
                                        }) }}
										{% if form.date.vars.errors|length > 0 %}
											<div class="error-message">{{ form.date.vars.errors[0].message }}</div>
										{% endif %}
									</div>
								</div>

								<div class="col-lg-6 col-md-6 col-12">
									<div class="input-with-error">
										{{ form_widget(form.nbrplaces, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': form.nbrplaces.vars.errors|length > 0 ? form.nbrplaces.vars.errors[0].message : 'Number of Places',
                                                'data-error': form.nbrplaces.vars.errors|length > 0 ? form.nbrplaces.vars.errors[0].message : ''
                                            },
                                            'label': false
                                        }) }}
										{% if form.nbrplaces.vars.errors|length > 0 %}
											<div class="error-message">{{ form.nbrplaces.vars.errors[0].message }}</div>
										{% endif %}
									</div>
								</div>
							</div>

							<div class="input-with-error">
								{{ form_widget(form.lieu, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': form.lieu.vars.errors|length > 0 ? form.lieu.vars.errors[0].message : 'Location',
                                        'data-error': form.lieu.vars.errors|length > 0 ? form.lieu.vars.errors[0].message : ''
                                    },
                                    'label': false
                                }) }}
								{% if form.lieu.vars.errors|length > 0 %}
									<div class="error-message">{{ form.lieu.vars.errors[0].message }}</div>
								{% endif %}
							</div>

							<div class="input-with-error">
								{{ form_label(form.sponsor, form.sponsor.vars.errors|length > 0 ? form.sponsor.vars.errors[0].message : 'Select Sponsor', {
                                    'label_attr': {'class': 'form-label'}
                                }) }}
								{{ form_widget(form.sponsor, {
                                    'attr': {
                                        'class': 'form-select',
                                        'data-error': form.sponsor.vars.errors|length > 0 ? form.sponsor.vars.errors[0].message : ''
                                    },
                                    'placeholder': 'Choose a Sponsor'
                                }) }}
								{% if form.sponsor.vars.errors|length > 0 %}
									<div class="error-message">{{ form.sponsor.vars.errors[0].message }}</div>
								{% endif %}
							</div>

							<div class="d-flex justify-content-between mt-4">
								<div class="col-lg-4 col-md-6 col-8">
									<button type="submit" class="form-control">Update Event</button>
								</div>

								<div class="col-lg-4 col-md-6 col-8">
									<a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary form-control">Cancel</a>
								</div>
							</div>

							<div class="text-center mt-4">
								<form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Are you sure you want to delete this event?');" class="d-inline">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
									<button class="btn btn-delete">
										<i class="bi bi-trash me-2"></i>Delete Event
									</button>
								</form>
							</div>

							{{ form_end(form) }}
						</div>
					</form>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		/* Your existing edit page styles */
		.ticket-section {
			position: relative;
			min-height: 100vh;
			padding-top: 80px;
			padding-bottom: 80px;
			display: flex;
			align-items: center;
		}

		/* ... (keep all your existing styles) ... */

		/* Error message styles matching new.html.twig */
		.input-with-error {
			position: relative;
			margin-bottom: 20px;
		}

		.error-message {
			position: absolute;
			top: 100%;
			left: 0;
			width: 100%;
			padding: 5px 10px;
			background-color: #f8d7da;
			color: #721c24;
			border: 1px solid #f5c6cb;
			border-radius: 0 0 5px 5px;
			font-size: 0.8rem;
			z-index: 10;
			margin-top: -20px;
		}

		.is-invalid {
			border-color: #dc3545 !important;
			margin-bottom: 0;
		}

		/* Adjust delete button to match error styling */
		.btn-delete {
			background-color: transparent;
			border: none;
			color: #dc3545;
			padding: 0;
			font-size: 0.9rem;
		}

		.btn-delete:hover {
			color: #c82333;
			text-decoration: underline;
		}
	</style>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		document.addEventListener('DOMContentLoaded', function () { // Clear invalid input and show error messages
document.querySelectorAll('[data-error]').forEach(element => {
if (element.dataset.error) {
element.classList.add('is-invalid');

// For text inputs, clear only if invalid
if (element.tagName === 'INPUT' && element.type !== 'file' && !element.value) {
element.value = '';
}

// For selects, reset to placeholder if invalid
if (element.tagName === 'SELECT' && !element.value) {
element.selectedIndex = 0;
}
}
});

// Special handling for edit form - preserve valid values
const form = document.querySelector('form');
form.addEventListener('submit', function (e) {
if (!this.checkValidity()) {
e.preventDefault();
e.stopPropagation();
}
this.classList.add('was-validated');
}, false);
});
	</script>
{% endblock %}
