{% extends 'base.html.twig' %}

{% block title %}
	{{ evenement.titre }}
	Details
{% endblock %}

{% block body %}
	<section class="event-details-section section-padding">
		<div class="section-overlay"></div>
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-8 col-12">
					<div class="custom-form event-details-card">
						<div class="event-header text-center mb-4">
							<h2 class="event-title">{{ evenement.titre }}</h2>
							<div class="event-meta">
								<span class="event-type-badge">{{ evenement.type }}</span>
								<span class="event-date">
									<i class="bi bi-calendar-event me-1"></i>
									{{ evenement.date ? evenement.date|date('F j, Y') : '' }}
								</span>
							</div>
						</div>

						<div class="event-body">
							<div class="event-description mb-4">
								<h4 class="section-title">Description</h4>
								<p>{{ evenement.description }}</p>
							</div>

							<div class="event-details-grid">
								<div class="detail-item">
									<i class="bi bi-geo-alt-fill"></i>
									<div>
										<h5>Location</h5>
										<p>{{ evenement.lieu }}</p>
									</div>
								</div>

								<div class="detail-item">
									<i class="bi bi-ticket-perforated"></i>
									<div>
										<h5>Available Seats</h5>
										<p>{{ evenement.nbrplaces }}</p>
									</div>
								</div>
							</div>

							{# Ratings Section #}
							<div class="ratings-section mt-5">
								<h4 class="section-title">
									<i class="bi bi-star-fill text-warning me-2"></i>Ratings & Reviews
									<small class="text-muted">({{ evenement.ratings|length }})</small>
								</h4>

								{# Rating Action Button #}
								{% if app.user %}
									<div class="mb-4">
										<a href="{{ path('app_event_rate', {'id': evenement.id}) }}" class="btn btn-sm {% if app.user.hasRatedEvent(evenement) %}btn-outline-warning{% else %}btn-warning{% endif %}">
											<i class="bi bi-star-fill me-1"></i>
											{% if app.user.hasRatedEvent(evenement) %}Update Your Rating{% else %}Rate This Event
											{% endif %}
										</a>
									</div>
								{% else %}
									<div class="alert alert-info">
										<a href="{{ path('app_login') }}" class="alert-link">Log in</a>
										to rate this event
									</div>
								{% endif %}

								{# Ratings List #}
								{% if evenement.ratings|length > 0 %}
									<div class="ratings-list">
										{% for rating in evenement.ratings %}
											<div class="rating-item mb-3 p-3 bg-light rounded">
												<div class="d-flex justify-content-between align-items-center mb-2">
													<strong>{{ rating.user.email }}</strong>
													<div class="text-warning">
														{% for i in 1..5 %}
															<i class="bi bi-star{% if i <= rating.rating %}-fill{% endif %}"></i>
														{% endfor %}
														<small class="text-muted ms-2">{{ rating.createdAt|date('M d, Y') }}</small>
													</div>
												</div>
												{% if rating.review %}
													<div class="review-text mt-2">{{ rating.review }}</div>
												{% endif %}
											</div>
										{% endfor %}
									</div>
								{% else %}
									<div class="alert alert-light">
										No ratings yet. Be the first to rate this event!
									</div>
								{% endif %}
							</div>
						</div>

						<div class="event-actions mt-5 text-center">
							<a href="javascript:history.back()" class="btn btn-primary">
								<i class="bi bi-arrow-left me-2"></i>Back to Previous Page
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.event-details-section {
			position: relative;
			min-height: 100vh;
			padding-top: 80px;
			padding-bottom: 80px;
			display: flex;
			align-items: center;
			background-size: cover;
			background-position: center;
			background-attachment: fixed;
		}

		.section-overlay {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			background-color: rgba(0, 0, 0, 0);
			background-image: url('https://www.carnifest.com/wp-content/uploads/2019/09/5-rock-pop-Image_by_StockSnap_from_Pixabay.jpg');
		}

		.event-details-card {
			background-color: rgba(255, 255, 255, 0.85);
			padding: 40px;
			border-radius: 10px;
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
		}

		.event-header {
			padding-bottom: 20px;
			border-bottom: 1px solid rgba(0, 0, 0, 0.1);
		}

		.event-title {
			color: #2c3e50;
			font-weight: 700;
			margin-bottom: 15px;
		}

		.event-meta {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 20px;
		}

		.event-type-badge {
			background-color: #f6388a;
			color: white;
			padding: 5px 15px;
			border-radius: 20px;
			font-size: 0.9rem;
			font-weight: 600;
		}

		.event-date {
			color: #6c757d;
			font-size: 0.95rem;
		}

		.section-title {
			color: #2c3e50;
			font-size: 1.25rem;
			margin-bottom: 15px;
			position: relative;
			padding-bottom: 8px;
		}

		.section-title::after {
			content: '';
			position: absolute;
			left: 0;
			bottom: 0;
			width: 50px;
			height: 3px;
			background-color: #f6388a;
		}

		.event-description p {
			color: #495057;
			line-height: 1.7;
		}

		.event-details-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
			gap: 20px;
			margin-top: 30px;
		}

		.detail-item {
			display: flex;
			align-items: flex-start;
			gap: 15px;
			background: #f8f9fa;
			padding: 20px;
			border-radius: 8px;
		}

		.detail-item i {
			font-size: 1.5rem;
			color: #f6388a;
			margin-top: 3px;
		}

		.detail-item h5 {
			color: #2c3e50;
			font-size: 1rem;
			margin-bottom: 5px;
		}

		.detail-item p {
			color: #6c757d;
			margin: 0;
		}

		/* Ratings Section Styles */
		.ratings-section {
			border-top: 1px solid rgba(0, 0, 0, 0.1);
			padding-top: 20px;
			margin-top: 30px;
		}

		.rating-item {
			border-left: 3px solid #ffc107;
			background-color: rgba(255, 255, 255, 0.9);
		}

		.review-text {
			color: #495057;
			line-height: 1.6;
		}

		.btn-warning {
			background-color: #ffc107;
			border-color: #ffc107;
			color: #000;
		}

		.btn-outline-warning {
			color: #ffc107;
			border-color: #ffc107;
		}

		.btn-outline-warning:hover {
			background-color: #ffc107;
			color: #000;
		}

		/* Star Rating Styles */
		.text-warning {
			color: #ffc107 !important;
		}

		/* Responsive adjustments */
		@media(max-width: 767.98px) {
			.event-details-card {
				padding: 30px 20px;
			}

			.event-meta {
				flex-direction: column;
				gap: 10px;
			}
		}
	</style>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		// This ensures the stars are properly highlighted when viewing existing ratings
document.addEventListener('DOMContentLoaded', function () {
document.querySelectorAll('.rating-item .text-warning').forEach(ratingContainer => {
const stars = ratingContainer.querySelectorAll('.bi-star, .bi-star-fill');
const ratingValue = ratingContainer.querySelector('small') ?. previousElementSibling ?. textContent.trim().length || 0;

stars.forEach((star, index) => {
if (index < ratingValue) {
star.classList.add('bi-star-fill');
star.classList.remove('bi-star');
}
});
});
});
	</script>
{% endblock %}
