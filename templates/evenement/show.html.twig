{% extends 'base.html.twig' %}

{% block title %}Evenement Details
{% endblock %}

{% block body %}
	<div class="card shadow-sm mt-5">
		<div class="card-header bg-primary text-white">
			<h1 class="h4 mb-0">Evenement Details</h1>
		</div>
		<div class="card-body">
			<table class="table table-bordered">
				<tbody>
					<tr>
						<th class="w-25">Id</th>
						<td>{{ evenement.id }}</td>
					</tr>
					<tr>
						<th>Titre</th>
						<td>{{ evenement.titre }}</td>
					</tr>
					<tr>
						<th>Type</th>
						<td>{{ evenement.type }}</td>
					</tr>
					<tr>
						<th>Description</th>
						<td>{{ evenement.description }}</td>
					</tr>
					<tr>
						<th>Date</th>
						<td>{{ evenement.date ? evenement.date|date('Y-m-d') : '' }}</td>
					</tr>
					<tr>
						<th>Lieu</th>
						<td>{{ evenement.lieu }}</td>
					</tr>
					<tr>
						<th>Nbrplaces</th>
						<td>{{ evenement.nbrplaces }}</td>
					</tr>
				</tbody>
			</table>

			<div class="d-flex gap-2">
				<a href="{{ path('app_evenement_index') }}" class="btn btn-secondary">Back to List</a>
				<a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-warning">Edit</a>
				{{ include('evenement/_delete_form.html.twig') }}
			</div>
		</div>
	</div>
{% endblock %}
