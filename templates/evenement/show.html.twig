{% extends 'base.html.twig' %}

{% block title %}
	{{ evenement.titre }}
	Details
{% endblock %}

{% block body %}
	<section class="event-details-section section-padding">
		<div class="section-overlay"></div>
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-8 col-12">
					<div class="custom-form event-details-card">
						<div class="event-header text-center mb-4">
							<h2 class="event-title">{{ evenement.titre }}</h2>
							<div class="event-meta">
								<span class="event-type-badge">{{ evenement.type }}</span>
								<span class="event-date">
									<i class="bi bi-calendar-event me-1"></i>
									{{ evenement.date ? evenement.date|date('F j, Y') : '' }}
								</span>
							</div>
						</div>

						<div class="event-body">
							<div class="event-description mb-4">
								<h4 class="section-title">Description</h4>
								<p>{{ evenement.description }}</p>
							</div>

							<div class="event-details-grid">
								<div class="detail-item">
									<i class="bi bi-geo-alt-fill"></i>
									<div>
										<h5>Location</h5>
										<p>{{ evenement.lieu }}</p>
									</div>
								</div>

								<div class="detail-item">
									<i class="bi bi-ticket-perforated"></i>
									<div>
										<h5>Available Seats</h5>
										<p>{{ evenement.nbrplaces }}</p>
									</div>
								</div>
							</div>
						</div>

						<div class="event-actions mt-5">
							<div class="d-flex flex-wrap justify-content-center gap-3">
								<a href="{{ path('app_evenement_index') }}" class="btn btn-outline-light">
									<i class="bi bi-arrow-left me-2"></i>Back to Events
								</a>
								<a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-primary">
									<i class="bi bi-pencil-square me-2"></i>Edit Event
								</a>
								<form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Are you sure you want to delete this event?');" class="d-inline">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
									<button class="btn btn-danger">
										<i class="bi bi-trash me-2"></i>Delete Event
									</button>
								</form>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.event-details-section {
			position: relative;
			min-height: 100vh;
			padding-top: 80px;
			padding-bottom: 80px;
			display: flex;
			align-items: center;
		}

		.section-overlay {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-color: rgba(0, 0, 0, 0.7);
		}

		.event-details-card {
			background-color: #ffffff;
			padding: 40px;
			border-radius: 10px;
			box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
		}

		.event-header {
			padding-bottom: 20px;
			border-bottom: 1px solid rgba(0, 0, 0, 0.1);
		}

		.event-title {
			color: #2c3e50;
			font-weight: 700;
			margin-bottom: 15px;
		}

		.event-meta {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 20px;
		}

		.event-type-badge {
			background-color: #f6388a;
			color: white;
			padding: 5px 15px;
			border-radius: 20px;
			font-size: 0.9rem;
			font-weight: 600;
		}

		.event-date {
			color: #6c757d;
			font-size: 0.95rem;
		}

		.section-title {
			color: #2c3e50;
			font-size: 1.25rem;
			margin-bottom: 15px;
			position: relative;
			padding-bottom: 8px;
		}

		.section-title::after {
			content: '';
			position: absolute;
			left: 0;
			bottom: 0;
			width: 50px;
			height: 3px;
			background-color: #f6388a;
		}

		.event-description p {
			color: #495057;
			line-height: 1.7;
		}

		.event-details-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
			gap: 20px;
			margin-top: 30px;
		}

		.detail-item {
			display: flex;
			align-items: flex-start;
			gap: 15px;
			background: #f8f9fa;
			padding: 20px;
			border-radius: 8px;
		}

		.detail-item i {
			font-size: 1.5rem;
			color: #f6388a;
			margin-top: 3px;
		}

		.detail-item h5 {
			color: #2c3e50;
			font-size: 1rem;
			margin-bottom: 5px;
		}

		.detail-item p {
			color: #6c757d;
			margin: 0;
		}

		.btn-outline-light {
			border-color: #6c757d;
			color: #6c757d;
		}

		.btn-outline-light:hover {
			background-color: #6c757d;
			color: white;
		}

		/* Responsive adjustments */
		@media(max-width: 767.98px) {
			.event-details-card {
				padding: 30px 20px;
			}

			.event-meta {
				flex-direction: column;
				gap: 10px;
			}

			.event-actions .d-flex {
				flex-direction: column;
				gap: 10px;
			}

			.event-actions .btn {
				width: 100%;
			}
		}
	</style>
{% endblock %}
