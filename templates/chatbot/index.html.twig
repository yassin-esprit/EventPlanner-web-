{% extends 'base.html.twig' %}

{% block title %}Equipment Chatbot{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 class="mb-4 text-center">Equipment Chatbot</h2>
        <div class="card shadow-sm">
            <div class="card-body" style="height: 500px; overflow-y: auto; background: #f8f9fa;" id="chat-container">
                <div id="chat-messages">
                    <div class="mb-2"><strong>Bot:</strong> Hello! How can I help you today?</div>
                </div>
            </div>
            <div class="card-footer">
                <form id="chat-form">
                    <div class="input-group">
                        <input type="text" id="chat-input" class="form-control" placeholder="Ask about equipment (e.g., 'Is the projector available?')" required>
                        <button type="submit" class="btn btn-primary">Send</button>
                    </div>
                </form>
                
            </div>
        </div>
        <div class="text-center mt-3">
            <a href="{{ path('app_equipement_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Equipment
            </a>
        </div>
    </div>

    <script>
        document.getElementById('chat-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const input = document.getElementById('chat-input');
            const message = input.value.trim();
            if (!message) return;

            // Add user message
            const messages = document.getElementById('chat-messages');
            messages.innerHTML += `<div class="mb-2"><strong>You:</strong> ${message}</div>`;
            input.value = '';

            // Add loading message
            const loadingId = 'loading-' + Date.now();
            messages.innerHTML += `<div class="mb-2" id="${loadingId}"><strong>Bot:</strong> <em>Thinking...</em></div>`;

            // Scroll to bottom
            const chatContainer = document.getElementById('chat-container');
            chatContainer.scrollTop = chatContainer.scrollHeight;

            // Send message to server
            try {
                const response = await fetch('{{ path('app_chatbot') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `message=${encodeURIComponent(message)}`
                });
                const data = await response.json();

                // Remove loading message
                const loadingElement = document.getElementById(loadingId);
                if (loadingElement) {
                    loadingElement.remove();
                }

                if (data.response) {
                    messages.innerHTML += `<div class="mb-2"><strong>Bot:</strong> ${data.response}</div>`;
                } else {
                    messages.innerHTML += `<div class="mb-2"><strong>Bot:</strong> Error: ${data.error}</div>`;
                }
            } catch (error) {
                // Remove loading message
                const loadingElement = document.getElementById(loadingId);
                if (loadingElement) {
                    loadingElement.remove();
                }
                
                messages.innerHTML += `<div class="mb-2"><strong>Bot:</strong> Sorry, something went wrong on the server! Please try again later.</div>`;
                console.error("Chatbot error:", error);
            }

            // Scroll to bottom again
            chatContainer.scrollTop = chatContainer.scrollHeight;
        });
    </script>
{% endblock %}

{% block stylesheets %}
    <style>
        #chat-messages div {
            padding: 8px 12px;
        }
        #chat-messages div strong {
            color: #333;
        }
        .card {
            border-radius: 10px;
        }
        @media (max-width: 767.98px) {
            #chat-container {
                height: 400px;
            }
        }
    </style>
{% endblock %}