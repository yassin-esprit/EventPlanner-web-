<div class="container">
	<div class="row justify-content-center">
		{% set event_assets = {
            'conference': {
                'image': 'conference.jpg',
                'color': 'rgba(70, 130, 180, 0.9)',
                'icon': 'bi-mic'
            },
            'fête': {
                'image': 'party.jpg',
                'color': 'rgba(220, 53, 69, 0.9)',
                'icon': 'bi-music-note-beamed'
            },
            'fete': {
                'image': 'party.jpg',
                'color': 'rgba(220, 53, 69, 0.9)',
                'icon': 'bi-music-note-beamed'
            },
            'formation': {
                'image': 'training.jpg',
                'color': 'rgba(25, 135, 84, 0.9)',
                'icon': 'bi-mortarboard'
            },
            'default': {
                'image': 'event-default.jpg',
                'color': 'rgba(108, 117, 125, 0.9)',
                'icon': 'bi-calendar-event'
            }
        } %}

		{% for evenement in evenements %}
			{% set current_event = event_assets[evenement.type|lower] ?? event_assets['default'] %}
			{% set participant_badge = badge_service.getBadgeForEvent(evenement) %}

			<div class="col-lg-4 col-md-6 col-12 mb-4 animate-card">
				<div class="artists-thumb position-relative">
					<div class="artists-image-wrap position-relative overflow-hidden rounded shadow-sm">
						<img src="{{ asset('assets/images/events/' ~ current_event.image) }}" class="artists-image img-fluid" alt="{{ evenement.titre }}" onerror="this.src='{{ asset('assets/images/events/event-default.jpg') }}'">

						<div class="artists-date-badge badge-3d hover-effect">
							<i class="bi {{ current_event.icon }}"></i>
							{# {{ evenement.date ? evenement.date|date('d M') : '' }} #}
							{{ evenement.date ? evenement.date|ago : '' }}
						</div>

						<div class="artists-type-badge badge-3d hover-effect" style="background: {{ current_event.color }}">
							{{ evenement.type }}
						</div>

						<div class="artists-participant-badge badge-3d static-badge bg-{{ participant_badge.color }}">
							<i class="bi {{ participant_badge.icon }}"></i>
							{{ participant_badge.name }}
							<span class="ms-1">({{ evenement.users.count }})</span>
						</div>
					</div>

					<div class="artists-hover p-3 rounded-bottom" style="background: {{ current_event.color }}">
						<h4 class="text-white">{{ evenement.titre }}</h4>
						<div class="event-meta text-white-50 small">
							<p>
								<i class="bi bi-geo-alt"></i>
								{{ evenement.lieu }}</p>
							<p>
								<i class="bi bi-people"></i>
								{{ evenement.users.count }}
								participants /
								{{ evenement.nbrplaces }}
								seats</p>
							<p>
								<i class="bi bi-calendar-check"></i>
								{# {{ evenement.date ? evenement.date|date('F j, Y') : '' }}</p> #}
								{{ evenement.date ? evenement.date|ago : '' }}
								({{ evenement.date|date('F j, Y') }})</p>
							<p class="event-description text-white">
								{{ evenement.description|slice(0, 120) }}
								{% if evenement.description|length > 120 %}...
								{% endif %}
							</p>
						</div>

						<div class="d-flex justify-content-between align-items-center flex-wrap mt-3 gap-2">
							<a href="{{ path('app_evenement_participant_show', {'id': evenement.id}) }}" class="btn btn-sm btn-light shadow-sm">
								<i class="bi bi-eye me-1"></i>
								Details
							</a>

							{% if app.user %}
								{% if evenement.nbrplaces <= evenement.users.count %}
									<span class="badge-3d static-badge bg-danger d-flex align-items-center">
										<i class="bi bi-x-circle me-1"></i>
										Sold Out
									</span>
								{% elseif evenement.users.contains(app.user) %}
									<span class="badge-3d static-badge bg-success d-flex align-items-center">
										<i class="bi bi-check-circle me-1"></i>
										Registered
									</span>
								{% else %}
									<form method="post" action="{{ path('app_evenement_participate', {'id': evenement.id}) }}" class="d-inline">
										<input type="hidden" name="_token" value="{{ csrf_token('participate' ~ evenement.id) }}">
										<button type="submit" class="btn btn-sm btn-success shadow-sm">
											<i class="bi bi-check-circle me-1"></i>
											Participate
										</button>
									</form>
								{% endif %}
							{% else %}
								<a href="{{ path('app_login') }}" class="btn btn-sm btn-warning shadow-sm">
									<i class="bi bi-box-arrow-in-right me-1"></i>
									Login to Join
								</a>
							{% endif %}

							{% if is_granted('ROLE_ADMIN') %}
								<a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-sm btn-outline-light shadow-sm">
									<i class="bi bi-pencil me-1"></i>
									Edit
								</a>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		{% else %}
			<div class="col-12 text-center">
				<div class="alert alert-info py-4">
					<i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
					<h4>No events found</h4>
					{% if search is defined and search %}
						<p class="mb-0">No events match your search criteria. Try a different search term.</p>
					{% else %}
						<p class="mb-0">Check back later for upcoming events!</p>
					{% endif %}
				</div>
			</div>
		{% endfor %}
	</div>
</div>

<style>
	/* Entrance Animation */
	@keyframes fadeInSlideUp {
		0% {
			opacity: 0;
			transform: translateY(20px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-card {
		animation: fadeInSlideUp 0.6s ease both;
	}

	/* 3D Badges */
	.badge-3d {
		padding: 12px 20px;
		font-size: 0.95rem;
		font-weight: 600;
		border-radius: 30px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
		background-color: white;
		color: #212529;
		transition: all 0.25s ease;
	}

	/* Static Badge (no hover animation) */
	.static-badge {
		transition: none !important;
		transform: none !important;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
	}

	/* Hover effect only for hover-enabled badges */
	.hover-effect:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.35);
	}

	.badge-3d i {
		margin-right: 6px;
	}

	/* Badge placement */
	.artists-date-badge {
		position: absolute;
		top: 15px;
		right: 15px;
		background: rgba(0, 0, 0, 0.75);
		color: white;
	}

	.artists-type-badge {
		position: absolute;
		top: 15px;
		left: 15px;
		color: white;
		text-transform: capitalize;
	}

	.artists-participant-badge {
		position: absolute;
		bottom: 15px;
		left: 60%;
		transform: translateX(-50%);
		color: white;
	}

	/* Color overrides */
	.bg-danger {
		background-color: #dc3545 !important;
		color: #fff !important;
	}
	.bg-success {
		background-color: #28a745 !important;
		color: #fff !important;
	}
	.bg-warning {
		background-color: #ffc107 !important;
		color: #212529 !important;
	}
	.bg-light {
		background-color: #f8f9fa !important;
		color: #212529 !important;
	}
	.bg-secondary {
		background-color: #6c757d !important;
		color: #fff !important;
	}
</style>
