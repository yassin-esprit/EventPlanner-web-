{% extends 'base.html.twig' %}

{% block title %}Participant Dashboard
{% endblock %}

{% block body %}
	<!-- Hero Section with Full-Size Video -->
	<section class="hero-section" id="section_1">
		<div class="section-overlay"></div>
		<div class="container d-flex justify-content-center align-items-center">
			<div class="row">
				<div class="col-12 mt-auto mb-5 text-center">
					<h1 class="text-white mb-5">Your Events Dashboard</h1>
					<div class="d-flex justify-content-center gap-3">
						<a class="btn custom-btn smoothscroll" href="#events">
							<i class="bi bi-calendar-event me-2"></i>Browse Events
						</a>
					</div>
				</div>
			</div>
		</div>
		<div class="video-wrap">
			<video autoplay loop muted class="custom-video" poster="">
				<source src="{{ asset('video/pexels-2022395.mp4') }}" type="video/mp4">
				Your browser does not support the video tag.
			</video>
		</div>
	</section>

	<!-- Events Section -->
	<section class="artists-section section-padding" id="events" style="
						        background-image: url('{{ asset('images/nicholas-green-unsplash-blur.jpg') }}');
						        background-size: cover;
						        background-position: center;
						        background-attachment: fixed;
						        position: relative;
						    ">
		<div class="section-overlay" style="
						            position: absolute;
						            top: 0;
						            left: 0;
						            width: 100%;
						            height: 100%;
						            background-color: rgba(255, 255, 255, 0.79);
						        "></div>
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 text-center mb-5">
					<h2 class="mb-4">Upcoming Events</h2>
				</div>

				<!-- Search and Sort Controls -->
				<div class="row mb-4">
					<div class="col-md-6 mb-3 mb-md-0">
						<form method="get" action="{{ path('participant_dashboard') }}" class="search-form">
							<div class="input-group">
								<input type="text" name="search" class="form-control" placeholder="Search events..." value="{{ search }}" id="searchInput">
								{% if search %}
									<button type="button" class="clear-search" onclick="clearSearch()">
										<i class="bi bi-x-circle"></i>
									</button>
								{% endif %}
								<button class="btn btn-primary" type="submit">
									<i class="bi bi-search"></i>
								</button>
							</div>
						</form>
					</div>
					<div class="col-md-6">
						<div class="dropdown float-md-end">
							<button class="btn btn-outline-secondary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
								Sort by:
								{% if sort == 'title' %}Title
									{% elseif sort == 'type' %}Type
									{% else %}Date
								{% endif %}
								({{ direction == 'asc' ? 'Asc' : 'Desc' }})
							</button>
							<ul class="dropdown-menu" aria-labelledby="sortDropdown">
								<li>
									<a class="dropdown-item sort-option {% if sort == 'date' %}active{% endif %}" href="#" data-sort="date" data-direction="{{ sort == 'date' and direction == 'asc' ? 'desc' : 'asc' }}">
										Date
										{% if sort == 'date' %}
											<i class="bi bi-arrow-{{ direction == 'asc' ? 'up' : 'down' }} float-end"></i>
										{% endif %}
									</a>
								</li>
								<li>
									<a class="dropdown-item sort-option {% if sort == 'title' %}active{% endif %}" href="#" data-sort="title" data-direction="{{ sort == 'title' and direction == 'asc' ? 'desc' : 'asc' }}">
										Title
										{% if sort == 'title' %}
											<i class="bi bi-arrow-{{ direction == 'asc' ? 'up' : 'down' }} float-end"></i>
										{% endif %}
									</a>
								</li>
								<li>
									<a class="dropdown-item sort-option {% if sort == 'type' %}active{% endif %}" href="#" data-sort="type" data-direction="{{ sort == 'type' and direction == 'asc' ? 'desc' : 'asc' }}">
										Type
										{% if sort == 'type' %}
											<i class="bi bi-arrow-{{ direction == 'asc' ? 'up' : 'down' }} float-end"></i>
										{% endif %}
									</a>
								</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Events Container - Updated via AJAX -->
				<div id="events-container" class="row">
					{% include 'dashboard/participant/_events_list.html.twig' with {'evenements': evenements, 'search': search} %}
				</div>
			</div>
		</div>
	</section>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		/* Add to your stylesheet */
		.badge {
			font-size: 0.8rem;
			padding: 0.5rem 0.75rem;
			border-radius: 50px;
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
			transition: all 0.3s ease;
		}

		.badge:hover {
			transform: scale(1.05);
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
		}

		/* Specific badge colors */
		.badge-bg-secondary {
			background-color: #6c757d;
			color: white;
		}

		.badge-bg-primary {
			background-color: #0d6efd;
			color: white;
		}

		.badge-bg-danger {
			background-color: #dc3545;
			color: white;
		}

		.badge-bg-warning {
			background-color: #ffc107;
			color: #212529;
		}

		.badge-bg-success {
			background-color: #198754;
			color: white;
		}
		/* Hero Section */
		.hero-section {
			position: relative;
			height: 100vh;
			min-height: 600px;
			display: flex;
			align-items: center;
			overflow: hidden;
		}

		.section-overlay {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.5);
		}

		.video-wrap {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: -1;
		}

		.custom-video {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		/* Button Styles */
		.custom-btn {
			background-color: #f6388a;
			color: white;
			border: none;
			padding: 12px 30px;
			border-radius: 50px;
			font-weight: 600;
			transition: all 0.3s ease;
			display: inline-flex;
			align-items: center;
			font-size: 1.1rem;
		}

		.custom-btn:hover {
			background-color: #e4317d;
			transform: translateY(-3px);
			box-shadow: 0 5px 15px rgba(246, 56, 138, 0.4);
			color: white;
		}

		/* Events Section */
		.artists-section {
			background: #f8f9fa;
			padding: 60px 0;
		}

		.artists-thumb {
			position: relative;
			overflow: hidden;
			border-radius: 10px;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
			transition: all 0.3s ease;
			height: 100%;
		}

		.artists-thumb:hover {
			transform: translateY(-10px);
			box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
		}

		.artists-image-wrap {
			position: relative;
			height: 300px;
			overflow: hidden;
		}

		.artists-image {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.5s ease;
		}

		.artists-thumb:hover .artists-image {
			transform: scale(1.1);
		}

		.artists-date-badge {
			position: absolute;
			top: 20px;
			right: 20px;
			background: rgba(0, 0, 0, 0.7);
			color: white;
			padding: 8px 12px;
			border-radius: 5px;
			font-weight: bold;
			display: flex;
			align-items: center;
		}

		.artists-type-badge {
			position: absolute;
			top: 20px;
			left: 20px;
			color: white;
			padding: 6px 12px;
			border-radius: 5px;
			font-weight: bold;
			font-size: 0.8rem;
		}

		.artists-hover {
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			color: white;
			padding: 20px;
			transform: translateY(100%);
			transition: transform 0.3s ease;
			border-radius: 0 0 10px 10px;
		}

		.artists-thumb:hover .artists-hover {
			transform: translateY(0);
		}

		.event-meta {
			margin-bottom: 15px;
			color: #000;
			background-color: rgba(255, 255, 255, 0.8);
			padding: 15px;
			border-radius: 8px;
		}

		.event-meta p {
			margin-bottom: 5px;
			display: flex;
			align-items: center;
			color: #000;
		}

		.event-meta i {
			margin-right: 8px;
			font-size: 1.1rem;
			color: #000;
		}

		.event-description {
			font-size: 0.9rem;
			line-height: 1.5;
			color: #000;
		}

		/* Badge styles */
		.badge {
			padding: 8px 12px;
			border-radius: 50px;
			font-size: 0.85rem;
			display: inline-flex;
			align-items: center;
		}

		/* Search and Sort Styles */
		.search-form .input-group {
			max-width: 400px;
		}

		.search-form .form-control {
			border-right: none;
		}

		.search-form .btn {
			border-left: none;
			background-color: #f6388a;
			color: white;
		}

		.dropdown-menu {
			min-width: 200px;
		}

		.dropdown-item.active {
			background-color: #f6388a;
			color: white;
		}

		/* Clear search button */
		.clear-search {
			position: absolute;
			right: 45px;
			top: 50%;
			transform: translateY(-50%);
			background: none;
			border: none;
			color: #6c757d;
			z-index: 10;
		}

		.clear-search:hover {
			color: #f6388a;
		}

		/* Loading spinner */
		.loading-spinner {
			display: none;
			text-align: center;
			padding: 20px;
		}

		.spinner-border {
			width: 3rem;
			height: 3rem;
		}

		/* Responsive adjustments */
		@media(max-width: 767.98px) {
			.hero-section {
				min-height: 500px;
				height: 80vh;
			}

			.artists-image-wrap {
				height: 200px;
			}

			.custom-btn {
				padding: 10px 20px;
				font-size: 1rem;
			}

			.search-form .input-group {
				max-width: 100%;
			}

			.dropdown.float-md-end {
				float: none !important;
				margin-top: 10px;
			}
		}
	</style>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
const eventsContainer = document.getElementById('events-container');
const searchForm = document.querySelector('.search-form');
const searchInput = document.getElementById('searchInput');
const sortDropdown = document.getElementById('sortDropdown');

// Current sort state
let currentSort = '{{ sort|default('date') }}';
let currentDirection = '{{ direction|default('asc') }}';

// Prevent form submission (we'll use AJAX)
searchForm.addEventListener('submit', function (e) {
e.preventDefault();
loadEvents();
});

// Handle sort option clicks
document.querySelectorAll('.sort-option').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentSort = this.dataset.sort;
currentDirection = this.dataset.direction;
updateSortDropdown();
loadEvents();
});
});

// Clear search button
window.clearSearch = function () {
searchInput.value = '';
loadEvents();
searchInput.focus();
}

// Function to load events via AJAX
function loadEvents() {
const searchTerm = searchInput.value;
const url = '{{ path('participant_dashboard_ajax') }}';

// Show loading spinner
eventsContainer.innerHTML = `
                    <div class="col-12 text-center loading-spinner">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                `;

axios.get(url, {
params: {
search: searchTerm,
sort: currentSort,
direction: currentDirection
}
}).then(response => {
eventsContainer.innerHTML = response.data;
}).catch(error => {
console.error('Error loading events:', error);
eventsContainer.innerHTML = `
                        <div class="col-12 text-center">
                            <div class="alert alert-danger py-4">
                                <i class="bi bi-exclamation-triangle fs-1 d-block mb-3"></i>
                                <h4>Error loading events</h4>
                                <p class="mb-0">Please try again later.</p>
                            </div>
                        </div>
                    `;
});
}

// Update sort dropdown text
function updateSortDropdown() {
let sortText = 'Date';
if (currentSort === 'title') 
sortText = 'Title';
 else if (currentSort === 'type') 
sortText = 'Type';



sortDropdown.innerHTML = `Sort by: ${sortText} (${
currentDirection === 'asc' ? 'Asc' : 'Desc'
})`;

// Update active class on dropdown items
document.querySelectorAll('.sort-option').forEach(item => {
item.classList.remove('active');
if (item.dataset.sort === currentSort) {
item.classList.add('active');
// Update direction indicator
const icon = item.querySelector('i');
if (icon) {
icon.className = `bi bi-arrow-${
currentDirection === 'asc' ? 'up' : 'down'
} float-end`;
}
}
});
}

// Initialize
updateSortDropdown();
});
	</script>
{% endblock %}
