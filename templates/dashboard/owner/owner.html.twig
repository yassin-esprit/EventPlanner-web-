{% extends 'base.html.twig' %}

{% block title %}Owner Dashboard
{% endblock %}

{% block body %}
	<!-- Hero Section -->
	<section class="hero-section" id="section_1">
		<div class="section-overlay"></div>
		<div class="container d-flex justify-content-center align-items-center">
			<div class="row">
				<div class="col-12 mt-auto mb-5 text-center">
					<h1 class="text-white mb-5">Owner Dashboard</h1>
					<p class="text-white lead">Manage your events and venues</p>
				</div>
			</div>
		</div>
		<div class="video-wrap">
			<video autoplay loop muted class="custom-video" poster="">
				<source src="{{ asset('video/pexels-2022395.mp4') }}" type="video/mp4">
				Your browser does not support the video tag.
			</video>
		</div>
	</section>

	<!-- Dashboard Stats -->
	<section class="stats-section py-5 bg-light">
		<div class="container">
			<div class="row g-4">
				<div class="col-md-4">
					<div class="card stat-card border-0 shadow-sm">
						<div class="card-body text-center">
							<i class="bi bi-calendar-event fs-1 text-primary"></i>
							<h3 class="mt-3 mb-0">24</h3>
							<p class="text-muted mb-0">Upcoming Events</p>
						</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="card stat-card border-0 shadow-sm">
						<div class="card-body text-center">
							<i class="bi bi-people fs-1 text-success"></i>
							<h3 class="mt-3 mb-0">1,245</h3>
							<p class="text-muted mb-0">Total Attendees</p>
						</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="card stat-card border-0 shadow-sm">
						<div class="card-body text-center">
							<i class="bi bi-building fs-1 text-warning"></i>
							<h3 class="mt-3 mb-0">5</h3>
							<p class="text-muted mb-0">Venues</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Quick Actions -->
	<section class="quick-actions py-5">
		<div class="container">
			<div class="row justify-content-center mb-4">
				<div class="col-12 text-center">
					<h2 class="mb-4">Quick Actions</h2>
				</div>
			</div>
			<div class="row g-4 justify-content-center">
				<div class="col-lg-3 col-md-6">
					<a href="{{ path('app_evenement_new') }}" class="card action-card text-decoration-none">
						<div class="card-body text-center">
							<i class="bi bi-plus-circle fs-1 text-primary"></i>
							<h5 class="mt-3">Create Event</h5>
							<p class="text-muted mb-0">Set up a new event</p>
						</div>
					</a>
				</div>
				<div class="col-lg-3 col-md-6">
					<a href="#" class="card action-card text-decoration-none">
						<div class="card-body text-center">
							<i class="bi bi-building fs-1 text-success"></i>
							<h5 class="mt-3">Manage Venues</h5>
							<p class="text-muted mb-0">View and edit venues</p>
						</div>
					</a>
				</div>
				<div class="col-lg-3 col-md-6">
					<a href="#" class="card action-card text-decoration-none">
						<div class="card-body text-center">
							<i class="bi bi-ticket-perforated fs-1 text-danger"></i>
							<h5 class="mt-3">Bookings</h5>
							<p class="text-muted mb-0">View all bookings</p>
						</div>
					</a>
				</div>
				<div class="col-lg-3 col-md-6">
					<a href="#" class="card action-card text-decoration-none">
						<div class="card-body text-center">
							<i class="bi bi-graph-up fs-1 text-info"></i>
							<h5 class="mt-3">Reports</h5>
							<p class="text-muted mb-0">View event analytics</p>
						</div>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Recent Events -->
	<section class="recent-events py-5 bg-light">
		<div class="container">
			<div class="row justify-content-center mb-5">
				<div class="col-12 text-center">
					<h2 class="mb-4">Recent Events</h2>
					<a href="{{ path('app_evenement_index') }}" class="btn btn-outline-primary">
						View All Events
						<i class="bi bi-arrow-right ms-2"></i>
					</a>
				</div>
			</div>

			<div class="row">
				{% for evenement in evenements|slice(0, 3) %}
					{# Define image and color based on event type - same as events index #}
					{% set event_assets = {
                        'conference': {
                            'image': 'conference.jpg',
                            'color': 'rgba(70, 130, 180, 0.9)',
                            'icon': 'bi-mic'
                        },
                        'fête': {
                            'image': 'party.jpg',
                            'color': 'rgba(220, 53, 69, 0.9)',
                            'icon': 'bi-music-note-beamed'
                        },
                        'fete': {
                            'image': 'party.jpg',
                            'color': 'rgba(220, 53, 69, 0.9)',
                            'icon': 'bi-music-note-beamed'
                        },
                        'formation': {
                            'image': 'training.jpg',
                            'color': 'rgba(25, 135, 84, 0.9)',
                            'icon': 'bi-mortarboard'
                        },
                        'default': {
                            'image': 'event-default.jpg',
                            'color': 'rgba(108, 117, 125, 0.9)',
                            'icon': 'bi-calendar-event'
                        }
                    } %}

					{% set current_event = event_assets[evenement.type|lower] ?? event_assets['default'] %}

					<div class="col-lg-4 col-md-6">
						<div class="artists-thumb mb-4">
							<div class="artists-image-wrap">
								<img src="{{ asset('assets/images/events/' ~ current_event.image) }}" class="artists-image img-fluid" alt="{{ evenement.titre }}" style="height: 200px; width: 100%; object-fit: cover;">
								<div class="artists-date-badge">
									<i class="bi {{ current_event.icon }} me-1"></i>
									{{ evenement.date ? evenement.date|date('d M') : '' }}
								</div>
								<div class="artists-type-badge" style="background: {{ current_event.color }}">
									{{ evenement.type }}
								</div>
							</div>
							<div class="artists-hover p-3" style="background: {{ current_event.color }}">
								<h4 class="text-white">{{ evenement.titre }}</h4>
								<div class="event-meta">
									<p class="text-white">
										<i class="bi bi-geo-alt"></i>
										{{ evenement.lieu }}
									</p>
									<p class="text-white">
										<i class="bi bi-ticket-perforated"></i>
										{{ evenement.nbrplaces }}
										seats available
									</p>
								</div>
								<div class="d-flex justify-content-between mt-3">
									<a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-sm btn-light">
										<i class="bi bi-eye me-1"></i>Details
									</a>
									<a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-sm btn-outline-light">
										<i class="bi bi-pencil me-1"></i>Edit
									</a>
								</div>
							</div>
						</div>
					</div>
				{% else %}
					<div class="col-12 text-center">
						<div class="alert alert-info py-4">
							<i class="bi bi-calendar-x fs-1 d-block mb-3"></i>
							<h4>No events found</h4>
							<p class="mb-0">Create your first event to get started!</p>
							<a href="{{ path('app_evenement_new') }}" class="btn btn-primary mt-3">
								<i class="bi bi-plus-circle me-1"></i>Create Event
							</a>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</section>
{% endblock %}
{% block stylesheets %}
	<style>
		/* Hero Section */
		.hero-section {
			position: relative;
			height: 60vh;
			min-height: 400px;
			display: flex;
			align-items: center;
			overflow: hidden;
		}

		.section-overlay {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.5);
		}

		.video-wrap {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: -1;
		}

		.custom-video {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		/* Stats Cards */
		.stat-card {
			transition: transform 0.3s ease;
			border-radius: 10px;
		}

		.stat-card:hover {
			transform: translateY(-5px);
		}

		/* Action Cards */
		.action-card {
			transition: all 0.3s ease;
			border-radius: 10px;
			height: 100%;
			border: 1px solid rgba(0, 0, 0, 0.125);
		}

		.action-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
			background-color: #f8f9fa;
		}

		/* Event Cards */
		.event-card {
			transition: all 0.3s ease;
			border-radius: 10px;
		}

		.event-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15) !important;
		}

		/* Responsive adjustments */
		@media(max-width: 767.98px) {
			.hero-section {
				min-height: 300px;
				height: 40vh;
			}
		}
	</style>
{% endblock %}
