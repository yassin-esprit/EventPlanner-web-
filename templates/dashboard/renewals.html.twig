{% extends 'base.html.twig' %}

{% block title %}Contrats à Renouveler{% endblock %}

{% block body %}
<div class="container my-4">
    <h1 class="mb-4">Contrats à Renouveler dans les 30 prochains jours</h1>

    {% if expiringContracts is empty %}
        <div class="alert alert-info">Aucun contrat n'expire dans les 30 prochains jours.</div>
    {% else %}
        <div class="row g-3">
            {% for contrat in expiringContracts %}
                <div class="col-md-4">
                    <div class="card shadow-sm border-primary h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{ contrat.sponsor.nom }}</h5>
                            <p class="card-text">
                                <strong>Type de Contrat:</strong> {{ contrat.typecontrat }}<br>
                                <strong>Date de Fin:</strong> {{ contrat.datefin|date('d/m/Y') }}<br>
                                <strong>Montant:</strong> {{ contrat.montant|number_format(2, ',', ' ') }} TND<br>
                                <strong>Statut:</strong> 
                                <span class="badge 
                                    {% if contrat.statut == 'validé' %}bg-success
                                    {% elseif contrat.statut == 'en attente' %}bg-warning
                                    {% elseif contrat.statut == 'expiré' %}bg-danger
                                    {% else %}bg-secondary{% endif %}">
                                    {{ contrat.statut|capitalize }}
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
