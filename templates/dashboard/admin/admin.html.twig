{% block javascripts %}
    {{ parent() }}
   <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const chartElement = document.getElementById('equipmentStatusChart');

            if (chartElement && typeof Chart !== "undefined") {
                const disponible = parseInt("{{ stats.disponible|default(0) }}");
                const maintenance = parseInt("{{ stats.maintenance|default(0) }}");
                const indisponible = parseInt("{{ stats.indisponible|default(0) }}");

                new Chart(chartElement, {
                    type: 'doughnut',
                    data: {
                        labels: ['Disponible', 'Maintenance', 'Indisponible'],
                        datasets: [{
                            data: [disponible, maintenance, indisponible],
                            backgroundColor: [
                                'rgba(40, 167, 69, 0.8)',
                                'rgba(255, 193, 7, 0.8)',
                                'rgba(220, 53, 69, 0.8)'
                            ],
                            borderColor: ['#ffffff', '#ffffff', '#ffffff'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 14,
                                    padding: 20,
                                    font: {
                                        size: 13
                                    }
                                }
                            },
                            title: {
                                display: true,
                                text: 'Équipements par statut',
                                font: {
                                    size: 16,
                                    weight: 'bold'
                                }
                            }
                        }
                    }
                });

              chartElement.style.height = '250px';
			  chartElement.style.width = '100%'; // ou '400px' selon ta mise en page
			  chartElement.style.display = 'block';
			  chartElement.style.margin = '0 auto';

            } else {
                console.warn("Element du graphique introuvable ou Chart.js non chargé.");
            }
        
    

            // === TRI + FILTRE ÉQUIPEMENTS ===
            const equipmentSearchInput = document.getElementById('equipmentSearchInput');
            const clearEquipmentSearch = document.getElementById('clearEquipmentSearch');
            const sortEquipmentBtn = document.getElementById('sortEquipmentBtn');
            const equipmentTableBody = document.getElementById('equipmentTableBody');
            const noEquipmentRow = document.getElementById('noEquipmentRow');
            let equipmentSortAscending = true;
            let currentEquipmentSearchTerm = '';

            equipmentSearchInput?.addEventListener('input', () => {
                currentEquipmentSearchTerm = equipmentSearchInput.value.toLowerCase();
                filterEquipment();
                clearEquipmentSearch.style.display = currentEquipmentSearchTerm ? 'block' : 'none';
            });

            clearEquipmentSearch?.addEventListener('click', () => {
                equipmentSearchInput.value = '';
                currentEquipmentSearchTerm = '';
                filterEquipment();
                clearEquipmentSearch.style.display = 'none';
                equipmentSearchInput.focus();
            });

            sortEquipmentBtn?.addEventListener('click', () => {
                equipmentSortAscending = !equipmentSortAscending;
                filterEquipment();
            });

            function filterEquipment() {
                const rows = Array.from(equipmentTableBody.querySelectorAll('tr:not(#noEquipmentRow)'));
                let hasVisibleRows = false;

                rows.forEach(row => {
                    const name = row.dataset.name;
                    const quantity = row.dataset.quantity;
                    const available = row.dataset.available;
                    const description = row.dataset.description;
                    const status = row.dataset.status;

                    const matches = !currentEquipmentSearchTerm ||
                        name.includes(currentEquipmentSearchTerm) ||
                        quantity.includes(currentEquipmentSearchTerm) ||
                        available.includes(currentEquipmentSearchTerm) ||
                        description.includes(currentEquipmentSearchTerm) ||
                        status.includes(currentEquipmentSearchTerm);

                    row.style.display = matches ? '' : 'none';
                    if (matches) hasVisibleRows = true;
                });

                noEquipmentRow.style.display = hasVisibleRows ? 'none' : '';

                if (hasVisibleRows) {
                    const visibleRows = rows.filter(row => row.style.display !== 'none');
                    visibleRows.sort((a, b) => {
                        const aName = a.dataset.name;
                        const bName = b.dataset.name;
                        return equipmentSortAscending ? aName.localeCompare(bName) : bName.localeCompare(aName);
                    });
                    visibleRows.forEach(row => equipmentTableBody.appendChild(row));
                }

                sortEquipmentBtn.innerHTML = equipmentSortAscending
                    ? '<i class="bi bi-sort-alpha-down"></i> Trier par Nom'
                    : '<i class="bi bi-sort-alpha-up"></i> Trier par Nom';
            }

            // === TRI + FILTRE RÉSERVATIONS ===
            const reservationSearchInput = document.getElementById('reservationSearchInput');
            const clearReservationSearch = document.getElementById('clearReservationSearch');
            const sortReservationBtn = document.getElementById('sortReservationBtn');
            const reservationTableBody = document.getElementById('reservationTableBody');
            const noReservationRow = document.getElementById('noReservationRow');
            let reservationSortAscending = true;
            let currentReservationSearchTerm = '';

            reservationSearchInput?.addEventListener('input', () => {
                currentReservationSearchTerm = reservationSearchInput.value.toLowerCase();
                filterReservations();
                clearReservationSearch.style.display = currentReservationSearchTerm ? 'block' : 'none';
            });

            clearReservationSearch?.addEventListener('click', () => {
                reservationSearchInput.value = '';
                currentReservationSearchTerm = '';
                filterReservations();
                clearReservationSearch.style.display = 'none';
                reservationSearchInput.focus();
            });

            sortReservationBtn?.addEventListener('click', () => {
                reservationSortAscending = !reservationSortAscending;
                filterReservations();
            });

            function filterReservations() {
                const rows = Array.from(reservationTableBody.querySelectorAll('tr:not(#noReservationRow)'));
                let hasVisibleRows = false;

                rows.forEach(row => {
                    const equipment = row.dataset.equipment;
                    const date = row.dataset.date;
                    const status = row.dataset.status;
                    const event = row.dataset.event;

                    const matches = !currentReservationSearchTerm ||
                        (equipment && equipment.includes(currentReservationSearchTerm)) ||
                        (date && date.includes(currentReservationSearchTerm)) ||
                        (status && status.includes(currentReservationSearchTerm)) ||
                        (event && event.includes(currentReservationSearchTerm));

                    row.style.display = matches ? '' : 'none';
                    if (matches) hasVisibleRows = true;
                });

                noReservationRow.style.display = hasVisibleRows ? 'none' : '';

                if (hasVisibleRows) {
                    const visibleRows = rows.filter(row => row.style.display !== 'none');
                    visibleRows.sort((a, b) => {
                        const dateA = new Date(a.dataset.date);
                        const dateB = new Date(b.dataset.date);
                        return reservationSortAscending ? dateA - dateB : dateB - dateA;
                    });
                    visibleRows.forEach(row => reservationTableBody.appendChild(row));
                }

                sortReservationBtn.innerHTML = reservationSortAscending
                    ? '<i class="bi bi-sort-down"></i> Trier par Date (Plus ancien)'
                    : '<i class="bi bi-sort-up"></i> Trier par Date (Plus récent)';
            }

            // === NAVIGATION ENTRE SECTIONS ===
            const sidebarLinks = document.querySelectorAll('#sidebar .nav-link');
            const contentSections = document.querySelectorAll('.content-section');
            const sectionTitle = document.getElementById('section-title');
            const sectionCreateButton = document.getElementById('section-create-button');

            const createButtonPaths = {
                'events': "{{ path('app_evenement_new') }}",
                'equipements': "{{ path('app_equipement_new') }}",
            };

            const sectionTitles = {
                'dashboard': 'Dashboard Overview',
                'events': 'Events Management',
                'equipements': 'Equipment Management',
                'sponsors': 'Sponsors Management',
                'ads': 'Advertisements Management',
                'merchandise': 'Merchandise Management',
                'users': 'Users Management'
            };

            function switchSection(sectionId) {
                sidebarLinks.forEach(link => {
                    link.classList.toggle('active', link.dataset.section === sectionId);
                });

                contentSections.forEach(section => {
                    section.classList.toggle('active', section.id === `${sectionId}-section`);
                });

                sectionTitle.textContent = sectionTitles[sectionId] || 'Management';
                sectionCreateButton.href = createButtonPaths[sectionId] || '#';
                sectionCreateButton.style.display = createButtonPaths[sectionId] ? 'inline-block' : 'none';
            }

            sidebarLinks.forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    const sectionId = link.dataset.section;
                    switchSection(sectionId);
                    window.location.hash = sectionId;
                });
            });

            const initialSection = window.location.hash.substring(1) || 'events';
            switchSection(initialSection);
        });
    </script>
{% endblock %}
