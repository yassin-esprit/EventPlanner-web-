				<script>
					document.addEventListener('DOMContentLoaded', function () {
const searchInput = document.getElementById('adsSearchInput');
const clearSearchBtn = document.getElementById('clearSearchBtn');
const sortByNameBtn = document.getElementById('sortByNameBtn');
const adsTableBody = document.getElementById('adsTableBody');
const noAdsRow = document.getElementById('noAdsRow');

let sortAscending = true;
let currentSearchTerm = '';

// Search functionality
searchInput.addEventListener('input', function () {
currentSearchTerm = this.value.toLowerCase();
filterAds();

// Show/hide clear button
clearSearchBtn.style.display = currentSearchTerm ? 'block' : 'none';
});

// Clear search
clearSearchBtn.addEventListener('click', function () {
searchInput.value = '';
currentSearchTerm = '';
filterAds();
clearSearchBtn.style.display = 'none';
searchInput.focus();
});

// Sort functionality
sortByNameBtn.addEventListener('click', function () {
sortAscending = ! sortAscending;
filterAds(); // This will reapply both search and sort
});

function filterAds() {
const rows = Array.from(adsTableBody.querySelectorAll('tr:not(#noAdsRow)'));
let hasVisibleRows = false;

// Filter and sort rows
rows.forEach(row => {
const name = row.getAttribute('data-name');
const type = row.getAttribute('data-type');
const content = row.getAttribute('data-content');
const location = row.getAttribute('data-location');
const status = row.getAttribute('data-status');

// Check if row matches search term
const matchesSearch = ! currentSearchTerm || name.includes(currentSearchTerm) || type.includes(currentSearchTerm) || content.includes(currentSearchTerm) || location.includes(currentSearchTerm) || status.includes(currentSearchTerm);

row.style.display = matchesSearch ? '' : 'none';
if (matchesSearch) 
hasVisibleRows = true;



});

// Handle no results message
if (noAdsRow) {
noAdsRow.style.display = hasVisibleRows ? 'none' : '';
}

// Sort visible rows
if (hasVisibleRows) {
const visibleRows = rows.filter(row => row.style.display !== 'none');

visibleRows.sort((a, b) => {
const nameA = a.getAttribute('data-name');
const nameB = b.getAttribute('data-name');
return sortAscending ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
});

// Re-append sorted rows
visibleRows.forEach(row => adsTableBody.appendChild(row));
}

// Update sort button text
sortByNameBtn.innerHTML = sortAscending ? '<i class="bi bi-sort-alpha-down"></i> Sort by Name (A-Z)' : '<i class="bi bi-sort-alpha-up"></i> Sort by Name (Z-A)';
}
});

