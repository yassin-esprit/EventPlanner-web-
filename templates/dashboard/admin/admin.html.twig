				<!-- JavaScript for Sorting Functionality -->
				<script>
					document.addEventListener('DOMContentLoaded', function () {
const sortByNameBtn = document.getElementById('sortByNameBtn');
let sortAscending = true;

sortByNameBtn.addEventListener('click', function () {
const tableBody = document.getElementById('adsTableBody');
const rows = Array.from(tableBody.querySelectorAll('tr'));

// Remove the "no advertisements" row if it exists
const noAdsRow = rows.find(row => row.querySelector('td[colspan="6"]'));
if (noAdsRow) {
tableBody.removeChild(noAdsRow);
}

// Sort rows alphabetically by name
rows.sort((a, b) => {
const nameA = a.getAttribute('data-name');
const nameB = b.getAttribute('data-name');

if (sortAscending) {
return nameA.localeCompare(nameB);
} else {
return nameB.localeCompare(nameA);
}
});

// Clear the table
while (tableBody.firstChild) {
tableBody.removeChild(tableBody.firstChild);
}

// Re-add the sorted rows
rows.forEach(row => tableBody.appendChild(row));

// Toggle sort direction for next click
sortAscending = ! sortAscending;

// Update button icon and text
if (sortAscending) {
sortByNameBtn.innerHTML = '<i class="bi bi-sort-alpha-down"></i> Sort by Name (Z-A)';
} else {
sortByNameBtn.innerHTML = '<i class="bi bi-sort-alpha-up"></i> Sort by Name (A-Z)';
}
});
});

