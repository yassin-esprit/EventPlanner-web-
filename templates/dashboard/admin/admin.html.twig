			font-size: 46px;
		}
		h3 {
			font-size: 32px;
		}
		h4 {
			font-size: 28px;
		}
		h5 {
			font-size: 24px;
		}
		h6 {
			font-size: 22px;
		}

		/* New admin header styling */
		.admin-header {
			background-color: var(--primary-color);
			padding: 12px 0;
			position: sticky;
			top: 0;
			z-index: 999;
		}

		.welcome-container {
			display: flex;
			justify-content: space-between;
			align-items: center;
			width: 100%;
		}

		.welcome-message {
			font-family: var(--font-body);
			font-weight: 400;
			color: var(--dark-color);
			margin: 0;
			display: flex;
			align-items: center;
		}

		.welcome-message i {
			margin-right: 0.5rem;
			color: var(--secondary-color);
		}

		.logout-btn {
			background: var(--custom-btn-bg-color);
			border: 2px solid transparent;
			border-radius: 100px;
			color: var(--white-color);
			font-size: 14px;
			font-weight: 700;
