{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>:root
	{
		--sidebar-width: 250px;
		--primary-color: #f8cb2e;
		--secondary-color: #ee5007;
		--section-bg-color: #f0f8ff;
		--custom-btn-bg-color: #ee5007;
		--custom-btn-bg-hover-color: #c01f27;
		--dark-color: #000000;
		--p-color: #717275;
		--border-color: #7fffd4;
		--link-hover-color: #b22727;
	}

	/* Main Layout */
	#wrapper {
		display: flex;
		min-height: 100vh;
		background-color: #f8f9fa;
	}

	/* Sidebar */
	#sidebar {
		width: var(--sidebar-width);
		background: linear-gradient(180deg, var(--dark-color) 0%, #333 100%);
		color: white;
		position: fixed;
		height: 100vh;
		transition: all 0.3s;
		z-index: 1000;
		box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
	}

	.sidebar-brand {
		height: 80px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 800;
		font-size: 1.2rem;
		background: rgba(0, 0, 0, 0.2);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.sidebar-brand-icon {
		color: var(--primary-color);
		margin-right: 10px;
	}

	.sidebar-divider {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		margin: 1rem 0;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		color: rgba(255, 255, 255, 0.8);
		padding: 12px 20px;
		display: flex;
		align-items: center;
		transition: all 0.3s;
	}

	.nav-link:hover,
	.nav-link.active {
		color: white;
		background: rgba(255, 255, 255, 0.1);
	}

	.nav-link.active {
		border-left: 4px solid var(--primary-color);
	}

	.nav-link i {
		margin-right: 10px;
		font-size: 1.1rem;
		color: var(--primary-color);
		width: 24px;
		text-align: center;
	}

	/* Content */
	#content {
		width: calc(100% - var(--sidebar-width));
		margin-left: var(--sidebar-width);
		min-height: 100vh;
		background: #f8f9fc;
	}

	/* Main Content */
	.container-fluid {
		padding: 2rem;
	}

	.card {
		border: none;
		border-radius: 10px;
		box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
		margin-bottom: 2rem;
		background: white;
	}

	.card-header {
		background: white;
		border-bottom: 1px solid #e3e6f0;
		padding: 1.25rem 1.5rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-radius: 10px 10px 0 0 !important;
	}

	.card-body {
		padding: 1.5rem;
	}

	/* Page Heading */
	.page-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid #eee;
	}

	/* Buttons */
	.btn {
		font-weight: 600;
		padding: 0.5rem 1rem;
		border-radius: 5px;
		transition: all 0.3s;
	}

	.btn-primary {
		background-color: var(--custom-btn-bg-color);
		border-color: var(--custom-btn-bg-color);
	}

	.btn-primary:hover {
		background-color: var(--custom-btn-bg-hover-color);
		border-color: var(--custom-btn-bg-hover-color);
	}

	.btn-outline-primary {
		color: var(--custom-btn-bg-color);
		border-color: var(--custom-btn-bg-color);
	}

	.btn-outline-primary:hover {
		background-color: var(--custom-btn-bg-color);
		color: white;
	}

	.btn-sm {
		padding: 0.35rem 0.75rem;
		font-size: 0.875rem;
	}

	/* Tables */
	.table {
		width: 100%;
		margin-bottom: 1rem;
		color: #212529;
		border-collapse: separate;
		border-spacing: 0;
	}

	.table th {
		background: #f8f9fc;
		border-bottom: 2px solid #e3e6f0;
		vertical-align: middle;
		padding: 1rem;
		font-weight: 600;
		color: var(--dark-color);
	}

	.table td {
		vertical-align: middle;
		padding: 1rem;
		border-top: 1px solid #e3e6f0;
	}

	.table tr:first-child td {
		border-top: none;
	}

	.table tr:hover td {
		background-color: rgba(248, 203, 46, 0.05);
	}

	.table-responsive {
		display: block;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	/* Action Buttons */
	.action-buttons {
		display: flex;
		gap: 0.5rem;
	}

	.action-buttons .btn {
		min-width: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Badges */
	.badge {
		font-weight: 600;
		padding: 0.5em 0.8em;
		font-size: 0.75em;
		border-radius: 50px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.badge-primary {
		background-color: var(--custom-btn-bg-color);
	}

	.badge-secondary {
		background-color: #6c757d;
	}

	.badge-success {
		background-color: #28a745;
	}

	.badge-warning {
		background-color: #ffc107;
		color: #212529;
	}

	.badge-danger {
		background-color: #dc3545;
	}

	/* Responsive */
	@media(max-width: 768px) {
		#sidebar {
			margin-left: -250px;
		}
		#sidebar.active {
			margin-left: 0;
		}
		#content {
			width: 100%;
			margin-left: 0;
		}
		#content.active {
			margin-left: 250px;
			width: calc(100% - 250px);
		}
	}
</style>{% endblock %}{% block body %}
<div
	id="wrapper">
	<!-- Sidebar -->
	<ul
		id="sidebar" class="navbar-nav sidebar sidebar-dark accordion">
		<!-- Sidebar - Brand -->
		<a class="sidebar-brand d-flex align-items-center justify-content-center" href="#">
			<div class="sidebar-brand-icon">
				<i class="bi bi-shield-lock"></i>
			</div>
			<div class="sidebar-brand-text mx-2">Admin Panel</div>
		</a>

		<!-- Divider -->
		<hr
		class="sidebar-divider my-0">

		<!-- Nav Items -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-speedometer2"></i>
				<span>Dashboard</span>
			</a>
		</li>

		<!-- Divider -->
		<hr
		class="sidebar-divider">

		<!-- Heading -->
		<div class="sidebar-heading">
			Management
		</div>

		<!-- Events Nav Item -->
		<li class="nav-item">
			<a class="nav-link active" href="#events">
				<i class="bi bi-calendar-event"></i>
				<span>Events</span>
			</a>
		</li>

		<!-- Sponsors Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-award"></i>
				<span>Sponsors</span>
			</a>
		</li>

		<!-- Logistics Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#equipements">
				<i class="bi bi-truck"></i>
				<span>Equipement</span>
			</a>
		</li>

		<!-- Ads Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-megaphone"></i>
				<span>Advertisements</span>
			</a>
		</li>

		<!-- Merchandise Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-shop"></i>
				<span>Merchandise</span>
			</a>
		</li>

		<!-- Users Nav Item -->
		<li class="nav-item">
			<a class="nav-link" href="#">
				<i class="bi bi-people"></i>
				<span>Users</span>
			</a>
		</li>
	</ul>
	<!-- End of Sidebar -->

	<!-- Content Wrapper -->
	<div
		id="content">
		<!-- Begin Page Content -->
		<div
			class="container-fluid">
			<!-- Page Heading -->
			<div class="page-heading">
				<h1 class="h3 mb-0 text-gray-800">Events Management</h1>
				<a href="{{ path('app_evenement_new') }}" class="btn btn-primary">
					<i class="bi bi-plus-circle"></i>
					Create New Event
				</a>
			</div>

<!-- Events Table -->
<div id="events" class="card shadow mb-4">
	<div class="card-header">
		<h6 class="m-0 font-weight-bold">All Events</h6>
		<div class="dropdown d-inline-block">
			<button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown">
				<i class="bi bi-filter"></i>
				Filter
			</button>
			<div class="dropdown-menu dropdown-menu-right">
				<a class="dropdown-item" href="#">All Events</a>
				<a class="dropdown-item" href="#">Upcoming</a>
				<a class="dropdown-item" href="#">Past</a>
			</div>
		</div>
	</div>
	<div class="card-body">
		<div class="table-responsive">
			<table class="table" id="dataTable" width="100%" cellspacing="0">
				<thead>
					<tr>
						<th>Title</th>
						<th>Type</th>
						<th>Date</th>
						<th>Location</th>
						<th>Seats</th>
						<th>Status</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for evenement in evenements %}
						{% set event_assets = {
							'conference': {'color': 'primary', 'icon': 'bi-mic'},
							'fête': {'color': 'danger', 'icon': 'bi-music-note-beamed'},
							'fete': {'color': 'danger', 'icon': 'bi-music-note-beamed'},
							'formation': {'color': 'success', 'icon': 'bi-mortarboard'},
							'default': {'color': 'secondary', 'icon': 'bi-calendar-event'}
						} %}

						{% set current_event = event_assets[evenement.type|lower] ?? event_assets['default'] %}
						{% set is_past = evenement.date and evenement.date < date() %}

						<tr>
							<td><i class="bi {{ current_event.icon }} me-2 text-{{ current_event.color }}"></i><strong>{{ evenement.titre }}</strong></td>
							<td><span class="badge badge-{{ current_event.color }}">{{ evenement.type }}</span></td>
							<td>{{ evenement.date ? evenement.date|date('Y-m-d') : '' }}</td>
							<td>{{ evenement.lieu }}</td>
							<td>{{ evenement.nbrplaces }}</td>
							<td>
								{% if is_past %}
									<span class="badge badge-secondary">Completed</span>
								{% else %}
									<span class="badge badge-success">Upcoming</span>
								{% endif %}
							</td>
							<td>
								<div class="action-buttons">
									<a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-sm btn-primary" title="View">
										<i class="bi bi-eye"></i>
									</a>
									<a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-sm btn-warning" title="Edit">
										<i class="bi bi-pencil"></i>
									</a>
									<form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Are you sure you want to delete this event?');" class="d-inline">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
										<button class="btn btn-sm btn-danger" title="Delete">
											<i class="bi bi-trash"></i>
										</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="7" class="text-center py-4">
								<i class="bi bi-calendar-x fs-1 text-muted"></i>
								<h5 class="text-muted mt-3">No events found</h5>
								<a href="{{ path('app_evenement_new') }}" class="btn btn-primary mt-2">
									<i class="bi bi-plus-circle"></i>
									Create Event
								</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- Equipement Section -->
<div id="equipements" class="mt-5 card shadow mb-4">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="m-0 font-weight-bold">Liste des équipements</h6>
		<div>
			<span class="badge badge-info me-2">Total: {{ equipements|length }}</span>
			<a href="{{ path('app_equipement_new') }}" class="btn btn-primary btn-sm">
				<i class="bi bi-plus-circle"></i>
				Ajouter un équipement
			</a>
		</div>
	</div>
	<div class="card-body">
		<div class="table-responsive">
			<table class="table" width="100%" cellspacing="0">
				<thead>
					<tr>
						<th>Nom</th>
						<th>Quantité totale</th>
						<th>Quantité dispo</th>
						<th>Description</th>
						<th>Statut</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for equipement in equipements %}
						<tr>
							<td>{{ equipement.nom }}</td>
							<td>{{ equipement.quantiteTotale }}</td>
							<td>{{ equipement.quantiteDispo }}</td>
							<td>{{ equipement.description }}</td>
							<td>
								{% if equipement.statut == 'disponible' %}
									<span class="badge badge-success">{{ equipement.statut }}</span>
								{% elseif equipement.statut == 'réparé' %}
									<span class="badge badge-warning">{{ equipement.statut }}</span>
								{% else %}
									<span class="badge badge-danger">{{ equipement.statut }}</span>
								{% endif %}
							</td>
							<td>
								<div class="action-buttons">
									<a href="{{ path('app_equipement_show', {'id_eq': equipement.id_eq}) }}" class="btn btn-sm btn-primary" title="Voir">
										<i class="bi bi-eye"></i>
									</a>
									<a href="{{ path('app_equipement_edit', {'id_eq': equipement.id_eq}) }}" class="btn btn-sm btn-warning" title="Modifier">
										<i class="bi bi-pencil"></i>
									</a>
									<form method="post" action="{{ path('app_equipement_delete', {'id_eq': equipement.id_eq}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet équipement ?');" class="d-inline">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipement.id_eq) }}">
										<button class="btn btn-sm btn-danger" title="Supprimer">
											<i class="bi bi-trash"></i>
										</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center py-4">
								<i class="bi bi-box-seam fs-1 text-muted"></i>
								<h5 class="text-muted mt-3">Aucun équipement trouvé</h5>
								<a href="{{ path('app_equipement_new') }}" class="btn btn-primary mt-2">
									<i class="bi bi-plus-circle"></i>
									Ajouter un équipement
								</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
</div>


		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- End of Content Wrapper -->
</div>{% endblock %}{% block javascripts %}
{{ parent() }}
<script>
	// Toggle sidebar
document.getElementById('sidebarToggle').addEventListener('click', function () {
document.getElementById('sidebar').classList.toggle('active');
document.getElementById('content').classList.toggle('active');
});
</script>{% endblock %}
