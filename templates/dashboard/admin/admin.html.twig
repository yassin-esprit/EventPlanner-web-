{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ✅ Import Google Fonts correctement séparé */
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100;200;400;700&display=swap');

        :root {
            --sidebar-width: 250px;
            --white-color: #ffffff;
            --primary-color: #f8cb2e;
            --secondary-color: #ee5007;
            --section-bg-color: #f0f8ff;
            --custom-btn-bg-color: #ee5007;
            --custom-btn-bg-hover-color: #c01f27;
            --dark-color: #000000;
            --p-color: #717275;
            --border-color: rgba(248, 248, 248, 0);
            --link-hover-color: #b22727;

            --font-body: 'Outfit', sans-serif;
            --font-base-size: 18px;
            --line-height-base: 1.6;
            --text-color: #000000;
            --text-light: #717275;
        }

        .navbar,
        .site-header:not(.admin-header) {
            display: none !important;
        }

        body {
            font-family: var(--font-body);
            font-size: var(--font-base-size);
            line-height: var(--line-height-base);
            color: var(--text-color);
            background-color: var(--white-color);
            padding-top: 0 !important;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-body);
            font-weight: 700;
            color: var(--dark-color);
        }

        h1 { font-size: 74px; }
        h2 { font-size: 46px; }
        h3 { font-size: 32px; }
        h4 { font-size: 28px; }
        h5 { font-size: 24px; }
        h6 { font-size: 22px; }

        .admin-header {
            background-color: var(--primary-color);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .welcome-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .welcome-message {
            font-family: var(--font-body);
            font-weight: 400;
            color: var(--dark-color);
            margin: 0;
            display: flex;
            align-items: center;
        }

        .welcome-message i {
            margin-right: 0.5rem;
            color: var(--secondary-color);
        }

        .logout-btn {
            background: var(--custom-btn-bg-color);
            border: 2px solid transparent;
            border-radius: 100px;
            color: var(--white-color);
            font-size: 14px;
            font-weight: 700;
            transition: all 0.3s;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .logout-btn:hover {
            background: var(--custom-btn-bg-hover-color);
            color: var(--white-color);
        }

        #wrapper {
            display: flex;
            min-height: 100vh;
        }

        #sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(180deg, var(--dark-color) 0%, #333 100%);
            color: white;
            height: 100vh;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
        }

        .sidebar-brand {
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 24px;
            background: rgba(0, 0, 0, 0.2);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-brand-icon {
            color: var(--primary-color);
            margin-right: 10px;
        }

        .sidebar-divider {
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            margin: 1rem 0;
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            transition: all 0.3s;
            font-family: var(--font-body);
            font-weight: 400;
            font-size: 18px;
        }

        .nav-link:hover,
        .nav-link.active {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }

        .nav-link.active {
            border-left: 4px solid var(--primary-color);
        }

        .nav-link i {
            margin-right: 10px;
            font-size: 1.1rem;
            color: var(--primary-color);
            width: 24px;
            text-align: center;
        }

        #content {
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
            background: var(--white-color);
        }

        .container-fluid {
            padding: 2rem;
        }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
            background: var(--white-color);
            overflow: hidden;
        }

        .card-header {
            background: var(--white-color);
            border-bottom: 1px solid var(--border-color);
            padding: 1.25rem 1.5rem;
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-radius: 20px 20px 0 0 !important;
        }

        .card-body {
            padding: 1.5rem;
        }

        .page-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .table {
            width: 100%;
            margin-bottom: 1rem;
            color: var(--text-color);
            border-collapse: separate;
            border-spacing: 0;
            font-family: var(--font-body);
        }

        .table th {
            background: var(--section-bg-color);
            border-bottom: 2px solid var(--border-color);
            vertical-align: middle;
            padding: 1rem;
            font-weight: 700;
            font-size: 18px;
            text-transform: uppercase;
            color: var(--dark-color);
        }

        .table td {
            vertical-align: middle;
            padding: 1rem;
            border-top: 1px solid var(--border-color);
            font-size: 18px;
            background-color: var(--white-color);
        }

        .table tr:first-child td {
            border-top: none;
        }

        .table tr:hover td {
            background-color: rgba(248, 203, 46, 0.05);
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: rgba(0, 0, 0, 0.02);
        }

        .table-responsive {
            display: block;
            width: 100%;
            overflow-x: auto;
        }

        .btn {
            font-family: var(--font-body);
            font-weight: 700;
            padding: 10px 20px;
            border-radius: 100px;
            transition: all 0.3s;
            font-size: 14px;
        }

        .btn-primary {
            background: var(--custom-btn-bg-color);
            border: 2px solid transparent;
            color: var(--white-color);
        }

        .btn-primary:hover {
            background: var(--custom-btn-bg-hover-color);
            color: var(--white-color);
        }

        .btn-outline-primary {
            background: transparent;
            border: 2px solid var(--custom-btn-bg-color);
            color: var(--custom-btn-bg-color);
        }

        .btn-outline-primary:hover {
            background: var(--custom-btn-bg-color);
            color: var(--white-color);
        }

        .btn-sm {
            padding: 0.35rem 0.75rem;
            font-size: 14px;
        }

        .action-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .badge {
            font-family: var(--font-body);
            font-weight: 700;
            padding: 0.5em 0.8em;
            font-size: 0.75em;
            border-radius: 50px;
            text-transform: uppercase;
        }

        .badge-primary { background-color: var(--custom-btn-bg-color); }
        .badge-secondary { background-color: #6c757d; }
        .badge-success { background-color: #28a745; }
        .badge-warning { background-color: #ffc107; color: #212529; }
        .badge-danger { background-color: #dc3545; }

        .content-section { display: none; }
        .content-section.active { display: block; }

        @media(max-width: 991px) {
            h1 { font-size: 62px; }
            h2 { font-size: 36px; }
            h3 { font-size: 32px; }
            h4 { font-size: 28px; }
            h5 { font-size: 20px; }
            h6 { font-size: 18px; }
        }

        @media(max-width: 768px) {
            #sidebar {
                position: fixed;
                margin-left: -250px;
                z-index: 1000;
            }
            #sidebar.active {
                margin-left: 0;
            }
            #content {
                width: 100%;
            }
            #content.active {
                margin-left: 250px;
                width: calc(100% - 250px);
            }
            h1 { font-size: 52px; }
            h2 { font-size: 28px; }
            h3 { font-size: 26px; }
            h4 { font-size: 22px; }
            h5 { font-size: 20px; }
        }

        .card-header .input-group {
            max-width: 300px;
            width: 100%;
            margin-right: 1rem;
        }

        .card-header .d-flex.align-items-center {
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        #sortEquipmentBtn,
        #sortReservationBtn {
            min-width: 160px;
        }

        @media (max-width: 768px) {
            .card-header .d-flex.align-items-center {
                flex-direction: column;
                align-items: stretch;
            }

            .card-header .input-group,
            .card-header .btn {
                width: 100% !important;
            }
        }
    </style>
{% endblock %}

{% block body %}
	<div
		id="wrapper">
		<!-- Sidebar -->
		<ul
			id="sidebar" class="navbar-nav sidebar sidebar-dark accordion">
			<!-- Sidebar - Brand -->
			<a class="sidebar-brand d-flex align-items-center justify-content-center" href="#">
				<div class="sidebar-brand-icon">
					<i class="bi bi-shield-lock"></i>
				</div>
				<div class="sidebar-brand-text mx-2">Admin Panel</div>
			</a>

			<!-- Divider -->
			<hr
			class="sidebar-divider my-0">

			<!-- Nav Items -->
			<li class="nav-item">
				<a class="nav-link" href="#" data-section="dashboard">
					<i class="bi bi-speedometer2"></i>
					<span>Dashboard</span>
				</a>
			</li>

			<!-- Divider -->
			<hr
			class="sidebar-divider">

			<!-- Heading -->
			<div class="sidebar-heading">
				Management
			</div>

			<!-- Events Nav Item -->
			<li class="nav-item">
				<a class="nav-link active" href="#" data-section="events">
					<i class="bi bi-calendar-event"></i>
					<span>Events</span>
				</a>
			</li>

			<!-- Sponsors Nav Item -->
			<li class="nav-item">
				<a class="nav-link" href="#" data-section="sponsors">
					<i class="bi bi-award"></i>
					<span>Sponsors</span>
				</a>
			</li>

			<!-- Logistics Nav Item -->
			<li class="nav-item">
				<a class="nav-link" href="#" data-section="equipements">
					<i class="bi bi-truck"></i>
					<span>Equipement</span>
				</a>
			</li>

			<!-- Ads Nav Item -->
			<li class="nav-item">
				<a class="nav-link" href="#" data-section="ads">
					<i class="bi bi-megaphone"></i>
					<span>Advertisements</span>
				</a>
			</li>

			<!-- Merchandise Nav Item -->
			<li class="nav-item">
				<a class="nav-link" href="#" data-section="merchandise">
					<i class="bi bi-shop"></i>
					<span>Merchandise</span>
				</a>
			</li>

			<!-- Users Nav Item -->
			<li class="nav-item">
				<a class="nav-link" href="#" data-section="users">
					<i class="bi bi-people"></i>
					<span>Users</span>
				</a>
			</li>
		</ul>
		<!-- End of Sidebar -->

		<!-- Content Wrapper -->
		<div
			id="content">
			<!-- New Welcome Header with Logout -->
			<header class="admin-header">
				<div class="container">
					<div class="welcome-container">
						<p class="welcome-message mb-0">
							<i class="bi-person custom-icon me-2"></i>
							<strong class="text-dark">
								{% if is_granted('IS_AUTHENTICATED_FULLY') %}
									Welcome back,
									{{ app.user.firstName ?? app.user.email }}
								{% endif %}
							</strong>
						</p>
						{% if is_granted('IS_AUTHENTICATED_FULLY') %}
							<a href="{{ path('app_logout') }}" class="logout-btn">
								<i class="bi-box-arrow-right"></i>Logout
							</a>
						{% endif %}
					</div>
				</div>
			</header>

			<!-- Begin Page Content -->
			<div
				class="container-fluid">
				<!-- Page Heading - Dynamic based on section -->
				<div class="page-heading">
					<h1 class="h3 mb-0 text-gray-800" id="section-title">Events Management</h1>
					<a href="#" class="btn btn-primary" id="section-create-button">
						<i class="bi bi-plus-circle"></i>
						Create New Event
					</a>
				</div>

				<!-- Dashboard Section -->
				<div id="dashboard-section" class="content-section">
					<div class="card shadow mb-4">
						<div class="card-header">
							<h6 class="m-0 font-weight-bold">Dashboard Overview</h6>
						</div>
						<div class="card-body">
							<p>Welcome to the admin dashboard. Select a section from the sidebar to manage.</p>
						</div>
					</div>
				</div>

				<!-- Events Section -->
				<div id="events-section" class="content-section active">
					<div class="card shadow mb-4">
						<div class="card-header">
							<h6 class="m-0 font-weight-bold">All Events</h6>
							<div class="dropdown d-inline-block">
								<button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown">
									<i class="bi bi-filter"></i>
									Filter
								</button>
								<div class="dropdown-menu dropdown-menu-right">
									<a class="dropdown-item" href="#">All Events</a>
									<a class="dropdown-item" href="#">Upcoming</a>
									<a class="dropdown-item" href="#">Past</a>
								</div>
							</div>
						</div>
						<div class="card-body">
							<div class="table-responsive">
								<table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
									<thead>
										<tr>
											<th>Title</th>
											<th>Type</th>
											<th>Date</th>
											<th>Location</th>
											<th>Seats</th>
											<th>Status</th>
											<th>Actions</th>
										</tr>
									</thead>
									<tbody>
										{% for evenement in evenements %}
											{% set event_assets = {
                                            'conference': {'color': 'primary', 'icon': 'bi-mic'},
                                            'fête': {'color': 'danger', 'icon': 'bi-music-note-beamed'},
                                            'fete': {'color': 'danger', 'icon': 'bi-music-note-beamed'},
                                            'formation': {'color': 'success', 'icon': 'bi-mortarboard'},
                                            'default': {'color': 'secondary', 'icon': 'bi-calendar-event'}
                                        } %}

											{% set current_event = event_assets[evenement.type|lower] ?? event_assets['default'] %}
											{% set is_past = evenement.date and evenement.date < date() %}

											<tr>
												<td>
													<i class="bi {{ current_event.icon }} me-2 text-{{ current_event.color }}"></i>
													<strong>{{ evenement.titre }}</strong>
												</td>
												<td>
													<span class="badge badge-{{ current_event.color }}">{{ evenement.type }}</span>
												</td>
												<td>{{ evenement.date ? evenement.date|date('Y-m-d') : '' }}</td>
												<td>{{ evenement.lieu }}</td>
												<td>{{ evenement.nbrplaces }}</td>
												<td>
													{% if is_past %}
														<span class="badge badge-secondary">Completed</span>
													{% else %}
														<span class="badge badge-success">Upcoming</span>
													{% endif %}
												</td>
												<td>
													<div class="action-buttons">
														<a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-sm btn-primary" title="View">
															<i class="bi bi-eye"></i>
														</a>
														<a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-sm btn-warning" title="Edit">
															<i class="bi bi-pencil"></i>
														</a>
														<form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Are you sure you want to delete this event?');" class="d-inline">
															<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
															<button class="btn btn-sm btn-danger" title="Delete">
																<i class="bi bi-trash"></i>
															</button>
														</form>
													</div>
												</td>
											</tr>
										{% else %}
											<tr>
												<td colspan="7" class="text-center py-4">
													<i class="bi bi-calendar-x fs-1 text-muted"></i>
													<h5 class="text-muted mt-3">No events found</h5>
													<a href="{{ path('app_evenement_new') }}" class="btn btn-primary mt-2">
														<i class="bi bi-plus-circle"></i>
														Create Event
													</a>
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

<!-- Equipement Section -->
<div id="equipements-section" class="content-section">
    <div class="card shadow mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold">Liste des équipements</h6>
            <div class="d-flex align-items-center">
                <!-- Search Input -->
                <div class="input-group input-group-sm mr-3" style="width: 250px;">
                    <input type="text" id="equipmentSearchInput" class="form-control" placeholder="Rechercher équipements...">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" id="clearEquipmentSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Sort Button -->
                <button id="sortEquipmentBtn" class="btn btn-info btn-sm mr-3">
                    <i class="bi bi-sort-alpha-down"></i>
                    Trier par Nom
                </button>
                
                <!-- Add New Button -->
                <a href="{{ path('app_equipement_new') }}" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Ajouter un equipement
                </a>

                <a href="{{ path('app_equipement_pdf') }}" class="btn btn-primary btn-sm">
                                            <i class="bi bi-file-pdf"></i> Télécharger PDF
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" width="100%" cellspacing="0" id="equipmentTable">
                    <thead>
                        <tr>
                            <th>NOM</th>
                            <th>QUANTITÉ TOTALE</th>
                            <th>QUANTITÉ DISPO</th>
                            <th>DESCRIPTION</th>
                            <th>STATUT</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="equipmentTableBody">
                        {% for equipement in equipements %}
                            <tr data-name="{{ equipement.nom|lower }}" 
                                data-quantity="{{ equipement.quantiteTotale }}"
                                data-available="{{ equipement.quantiteDispo }}"
                                data-description="{{ equipement.description|lower }}"
                                data-status="{{ equipement.statut|lower }}">
                                <td>{{ equipement.nom }}</td>
                                <td>{{ equipement.quantiteTotale }}</td>
                                <td>{{ equipement.quantiteDispo }}</td>
                                <td>{{ equipement.description }}</td>
                                <td>
                                    {% if equipement.statut == 'disponible' %}
                                        <span class="badge badge-success">DISPONIBLE</span>
                                    {% elseif equipement.statut == 'maintenance' %}
                                        <span class="badge badge-warning">MAINTENANCE</span>
                                    {% else %}
                                        <span class="badge badge-danger">INDISPONIBLE</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="{{ path('app_equipement_show', {'id_eq': equipement.id_eq}) }}" class="btn btn-sm btn-primary" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('app_equipement_edit', {'id_eq': equipement.id_eq}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_equipement_delete', {'id_eq': equipement.id_eq}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet équipement ?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipement.id_eq) }}">
                                            <button class="btn btn-sm btn-danger" title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                       
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr id="noEquipmentRow">
                                <td colspan="6" class="text-center py-4">
                                    <i class="bi bi-box-seam fs-1 text-muted"></i>
                                    <h5 class="text-muted mt-3">Aucun équipement trouvé</h5>
                                    <a href="{{ path('app_equipement_new') }}" class="btn btn-primary mt-2">
                                        <i class="bi bi-plus-circle"></i>
                                        Ajouter un équipement
                                    </a>
                                   
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Equipment Reservations Section -->
    <div class="card shadow mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold">Réservations d'équipement</h6>
            <div class="d-flex align-items-center">
                <!-- Search Input for Reservations -->
                <div class="input-group input-group-sm mr-3" style="width: 250px;">
                    <input type="text" id="reservationSearchInput" class="form-control" placeholder="Rechercher réservations...">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" id="clearReservationSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Sort Button for Reservations -->
                <button id="sortReservationBtn" class="btn btn-info btn-sm">
                    <i class="bi bi-sort-down"></i>
                    Trier par Date
                </button>
				<a href="{{ path('app_reservation_equipement_new') }}" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Ajouter une reservation
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table" width="100%" cellspacing="0" id="reservationTable">
                    <thead>
                        <tr>
                            <th>ÉQUIPEMENT</th>
                            <th>DATE RÉSERVATION</th>
                            <th>STATUT</th>
                            <th>ÉVÉNEMENT</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="reservationTableBody">
                        {% for reservation in reservation_equipements %}
                            {% set status_color = reservation.statut == 'confirme' ? 'success' : 
                                              (reservation.statut == 'attente' ? 'warning' : 'danger') %}
                            <tr data-equipment="{% if reservation.equipement %}{{ reservation.equipement.nom|lower }}{% endif %}"
                                data-date="{{ reservation.dateReservation|date('Y-m-d H:i') }}"
                                data-status="{{ reservation.statut|lower }}"
                                data-event="{% if reservation.evenement %}{{ reservation.evenement.titre|lower }}{% endif %}">
                                <td>
                                    {% if reservation.equipement %}
                                        <strong>{{ reservation.equipement.nom }}</strong>
                                    {% else %}
                                        <span class="text-muted">Non spécifié</span>
                                    {% endif %}
                                </td>
                                <td>{{ reservation.dateReservation|date('d/m/Y H:i') }}</td>
                                <td>
                                    <span class="badge badge-{{ status_color }}">
                                        {% if reservation.statut == 'confirme' %}
                                            CONFIRMÉ
                                        {% elseif reservation.statut == 'attente' %}
                                            EN ATTENTE
                                        {% else %}
                                            ANNULÉ
                                        {% endif %}
                                    </span>
                                </td>
                                <td>
                                    {% if reservation.evenement %}
                                        {{ reservation.evenement.titre }}
                                    {% else %}
                                        <span class="text-muted">Non spécifié</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="{{ path('app_reservation_equipement_show', {'id': reservation.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('app_reservation_equipement_edit', {'id': reservation.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr id="noReservationRow">
                                <td colspan="5" class="text-center py-4">
                                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                                    <h5 class="text-muted mt-3">Aucune réservation trouvée</h5>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
