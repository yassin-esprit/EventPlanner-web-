{% extends 'base.html.twig' %}

{% block title %}User Dashboard - Mythos Planner{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Welcome, {{ app.user.firstName }}!</h1>
        <a href="{{ path('user_merchandise_list') }}" class="btn btn-primary">
            <i class="fas fa-shopping-bag me-2"></i>Visit Shop
        </a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>Your Current Role</h3>
                </div>
                <div class="card-body">
                    <p>Current role: <strong>{{ app.user.roles[0]|replace({'ROLE_': ''}) }}</strong></p>

                    {% if not pendingRequest and app.user.roles[0] != 'ROLE_OWNER' and app.user.roles[0] != 'ROLE_ADMIN' %}
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#requestRoleModal">
                            Request Role Change
                        </button>
                    {% endif %}

                    {% if pendingRequest %}
                        <div class="alert alert-info mt-3">
                            <h4 class="alert-heading">Pending Request</h4>
                            <p>You have a pending request to become: <strong>{{ pendingRequest.requestedRole|replace({'ROLE_': ''}) }}</strong></p>
                            <p>Submitted on: {{ pendingRequest.requestedAt|date('Y-m-d H:i') }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>Role Request History</h3>
                </div>
                <div class="card-body">
                    {% if roleHistory is empty %}
                        <p class="text-muted">No role change history.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Requested Role</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for request in roleHistory %}
                                        <tr>
                                            <td>{{ request.requestedRole|replace({'ROLE_': ''}) }}</td>
                                            <td>
                                                {% if request.status == 'pending' %}
                                                    <span class="badge bg-warning">Pending</span>
                                                {% elseif request.status == 'approved' %}
                                                    <span class="badge bg-success">Approved</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Rejected</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ request.requestedAt|date('Y-m-d H:i') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h3>Submit a Donation</h3>
        </div>
        <div class="card-body">
            <form action="{{ path('app_user_submit_donation') }}" method="post">
                <div class="mb-3">
                    <label for="amount" class="form-label">Donation Amount ($)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" 
                               class="form-control" 
                               id="amount" 
                               name="amount" 
                               step="0.01" 
                               min="0.01" 
                               required>
                    </div>
                    <div class="form-text">Please enter the amount you wish to donate.</div>
                </div>

                <div class="mb-3">
                    <label for="message" class="form-label">Message (Optional)</label>
                    <textarea class="form-control" 
                              id="message" 
                              name="message" 
                              rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Submit Donation</button>
            </form>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h3>Your Donation History</h3>
        </div>
        <div class="card-body">
            {% if donationHistory is empty %}
                <p class="text-muted">You haven't made any donations yet.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Message</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for donation in donationHistory %}
                                <tr>
                                    <td>{{ donation.createdAt|date('Y-m-d H:i') }}</td>
                                    <td>${{ donation.amount }}</td>
                                    <td>{{ donation.message|default('No message') }}</td>
                                    <td>
                                        <span class="badge bg-{{ donation.status == 'accepted' ? 'success' : (donation.status == 'denied' ? 'danger' : 'warning') }}">
                                            {{ donation.status|capitalize }}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Role Request Modal -->
<div class="modal fade" id="requestRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="{{ path('app_request_role') }}" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Request Role Change</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label for="role">Requested Role:</label>
                        <select name="role" id="role" class="form-control" required>
                            <option value="ROLE_OWNER">Owner</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="reason">Reason for Request:</label>
                        <textarea name="reason" id="reason" class="form-control" rows="4" required 
                            placeholder="Please explain why you would like this role change..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}