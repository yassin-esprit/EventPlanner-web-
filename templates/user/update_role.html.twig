{% extends 'base.html.twig' %}

{% block title %}Update User Role{% endblock %}

{% block body %}
    <h1>Update Role for {{ user.firstName }} {{ user.lastName }}</h1>

    <form method="post">
        <label for="role">Select Role:</label>
        <select id="role" name="role" required>
            {% for role in roles %}
                <option value="{{ role }}" {% if role in user.roles %}selected{% endif %}>
                    {{ role|replace({'ROLE_': ''})|capitalize }}
                </option>
            {% endfor %}
        </select>

        <button type="submit">Update Role</button>
    </form>

    <a href="{{ path('app_user_dashboard') }}">Back to Dashboard</a>
{% endblock %}