{% extends 'base.html.twig' %}

{% block title %}My Donations{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>My Donations</h1>
            <a href="{{ path('app_user_donate') }}" class="btn btn-primary">Make New Donation</a>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Amount</th>
                                <th>Requested Date</th>
                                <th>Status</th>
                                <th>Processed Date</th>
                                <th>Comment</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for donation in donations %}
                                <tr>
                                    <td>${{ donation.amount|number_format(2) }}</td>
                                    <td>{{ donation.requestedAt|date('Y-m-d H:i:s') }}</td>
                                    <td>
                                        <span class="badge bg-{{ donation.status == 'pending' ? 'warning' : (donation.status == 'accepted' ? 'success' : 'danger') }}">
                                            {{ donation.status|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if donation.processedAt %}
                                            {{ donation.processedAt|date('Y-m-d H:i:s') }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if donation.comment %}
                                            {{ donation.comment }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center">No donations found</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="navigation mt-3">
                    {{ knp_pagination_render(donations) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}