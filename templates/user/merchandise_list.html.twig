{% extends 'base.html.twig' %}

{% block title %}Merchandise{% endblock %}

{% block body %}
<h1>Available Merchandise</h1>

<table class="table mt-4">
    <thead>
        <tr>
            <th>Name</th>
            <th>Image</th>
            <th>Description</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for item in merchandise %}
            <tr>
                <td>{{ item.name }}</td>
                <td><img src="{{ item.image }}" alt="{{ item.name }}" style="width: 50px;"></td>
                <td>{{ item.description }}</td>
                <td>{{ item.price }}</td>
                <td>{{ item.quantity }}</td>
                <td>
                    {% if item.quantity > 0 %}
                        <a href="{{ path('user_buy_merchandise', {id: item.id}) }}" class="btn btn-success btn-sm">Buy</a>
                    {% else %}
                        <span class="text-danger">Out of Stock</span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<div class="pagination mt-4">
    <a href="{{ path('user_merchandise_list', {page: 2}) }}" class="btn btn-secondary">Next Page</a>
</div>

{% endblock %}