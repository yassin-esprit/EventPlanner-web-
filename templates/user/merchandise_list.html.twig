{% extends 'base.html.twig' %}

{% block title %}Merchandise{% endblock %}

{% block body %}
<div class="container">
    <h1 class="text-center mb-5">Available Merchandise</h1>

    <div class="row">
        {% for item in merchandise %}
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="{{ asset('uploads/merchandise/' ~ item.image) }}" 
                         class="card-img-top" 
                         alt="{{ item.name }}"
                         style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">{{ item.name }}</h5>
                        <p class="card-text">{{ item.description }}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0">${{ item.price }}</span>
                            <span class="badge {% if item.quantity > 0 %}bg-success{% else %}bg-danger{% endif %}">
                                {{ item.quantity > 0 ? 'In Stock' : 'Out of Stock' }}
                            </span>
                        </div>
                    </div>
                    <div class="card-footer">
                        {% if item.quantity > 0 %}
                            <a href="{{ path('user_buy_merchandise', {id: item.id}) }}" 
                               class="btn btn-primary w-100">Buy Now</a>
                        {% else %}
                            <button class="btn btn-secondary w-100" disabled>Out of Stock</button>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(merchandise) }}
    </div>
</div>
{% endblock %}