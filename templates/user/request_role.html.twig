{% extends 'base.html.twig' %}

{% block title %}Request Role - Mythos Planner{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Request Role Change</h1>

    <form action="{{ path('app_request_role') }}" method="post">
        <div class="mb-3">
            <label for="role" class="form-label">Requested Role:</label>
            <select name="role" id="role" class="form-control" required>
                <option value="ROLE_OWNER">Owner</option>
            </select>
        </div>
        <div class="mb-3">
            <label for="reason" class="form-label">Reason for Request:</label>
            <textarea name="reason" id="reason" class="form-control" rows="4" required placeholder="Please explain why you would like this role change..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Submit Request</button>
    </form>
</div>
{% endblock %}