<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %} - Mythos Planner</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- Font Awesome -->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
        {{ encore_entry_link_tags('app') }}
        <style>
            .navbar-custom {
                background-color: #2c3e50;
            }
            .navbar-custom .navbar-brand,
            .navbar-custom .nav-link {
                color: white;
            }
            .navbar-custom .nav-link:hover {
                color: rgba(255,255,255,0.8);
            }
            .footer {
                margin-top: 3rem;
                padding: 1.5rem 0;
                background-color: #f8f9fa;
                text-align: center;
            }
            .content-wrapper {
                min-height: calc(100vh - 160px);
            }
            .user-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background-color: #34495e;
                color: white;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-right: 8px;
                font-weight: 500;
            }
            .nav-profile {
                display: flex;
                align-items: center;
            }
            .nav-link {
                text-decoration: none !important;
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {% set is_auth_page = app.request.get('_route') in ['app_login', 'app_register'] %}
        
        {% if not is_auth_page %}
            <nav class="navbar navbar-expand-lg navbar-custom">
                <div class="container">
                    <a class="navbar-brand" href="{{ path('app_home') }}">
                        <i class="fas fa-calendar-alt"></i> Mythos Planner
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto">
                            {% if app.user %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('app_admin_panel') }}">
                                            <i class="fas fa-user-shield"></i> Admin Panel
                                        </a>
                                    </li>
                                {% endif %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_user_dashboard') }}">
                                        <i class="fas fa-columns"></i> Dashboard
                                    </a>
                                </li>
                                {% if app.user and not is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_request_role_page') }}">
                                        <i class="fas fa-user-tag"></i> Role Request
                                    </a>
                                </li>
                                {% endif %}
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle nav-profile" href="#" id="navbarDropdown" role="button" 
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <div class="user-avatar">
                                            {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                                        </div>
                                        {{ app.user.firstName }}
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                        <li>
                                            <a class="dropdown-item" href="{{ path('app_user_profile') }}">
                                                <i class="fas fa-user"></i> View Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="{{ path('app_user_settings') }}">
                                                <i class="fas fa-cog"></i> Settings
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form action="{{ path('app_logout') }}" method="post" class="d-inline">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                                <button type="submit" class="dropdown-item" style="width: 100%; text-align: left; background: none; border: none;">
                                                    <i class="fas fa-sign-out-alt"></i> Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_login') }}">
                                        <i class="fas fa-sign-in-alt"></i> Login
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_register') }}">
                                        <i class="fas fa-user-plus"></i> Register
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </nav>
        {% endif %}

        <div class="content-wrapper">
            <main>
                {% block body %}{% endblock %}
            </main>
        </div>

        {% if not is_auth_page %}
            <footer class="footer">
                <div class="container">
                    <span class="text-muted">&copy; {{ "now"|date("Y") }} Mythos Planner. All rights reserved.</span>
                </div>
            </footer>
        {% endif %}

        <!-- Bootstrap Bundle with Popper -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {{ encore_entry_script_tags('app') }}
        {% block javascripts %}{% endblock %}
    </body>
</html>
